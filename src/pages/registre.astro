---
import LayoutSinMenu from "@layouts/LayoutSinMenu.astro";

import Registro from "@components/sesion/registrar"
---

<LayoutSinMenu title="Registrar-se">
<div class="w-full min-h-screen relative top-0 left-0 p-4 flex items-center place-content-center overflow-hidden">
    <div class="w-120 h-120 degradado absolute rounded-full  -top-30 -left-30">
        &nbsp;
    </div>
    <div class="w-150 h-150 degradado absolute rounded-full  -bottom-40 -right-40">
        &nbsp;
    </div>


    <div class="max-w-lg w-full h-auto p-4 rounded-2xl bg-card border-border z-10">
        <div class="flex flex-col items-center gap-y-2 text-center">
            <h1 class=" text-3xl font-bold">Crea el teu compte</h1>
            <p>Uneix-te a la comunitat esportiva de l'institut i comença a competir.</p>
        </div>

        <Registro client:load/>

        <p class="mx-auto w-max">Ja tens compte? <a href="/iniciar-sessio" class="text-secondary font-semibold hover:underline">Inica sessió</a></p>
    </div>
</div>
</LayoutSinMenu>