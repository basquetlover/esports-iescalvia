---
import LayoutSinMenu from "@layouts/LayoutSinMenu.astro";

export const prerender = false;

Astro.response.status = 403;
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<LayoutSinMenu title="Accés denegat">
    <main
        class="flex min-h-dvh w-full items-center justify-center bg-background px-4 py-10"
        aria-labelledby="acces-denegat-titol"
    >
        <section
            class="relative w-full max-w-lg overflow-hidden rounded-2xl border border-border/40 bg-white p-6 text-center shadow-[0_2px_12px_rgba(15,23,42,0.025)] md:p-10 in-[.oscuro_&]:bg-card"
        >
            <div
                class="pointer-events-none absolute inset-x-0 top-0 h-36 bg-linear-to-b from-primary/10 to-transparent"
                aria-hidden="true"
            ></div>

            <div class="relative">
                <div
                    class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl border border-primary/10 bg-primary/10 text-primary"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-10 w-10"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path
                            d="m12 3 8 3v6c0 4-3 7-8 9-5-2-8-5-8-9V6l8-3Z"
                        />
                        <path d="m9 9 6 6M15 9l-6 6" />
                    </svg>
                </div>

                <span
                    class="inline-flex rounded-md bg-[#eef3ff] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-primary in-[.oscuro_&]:bg-background"
                >
                    Error 403
                </span>

                <h1
                    id="acces-denegat-titol"
                    class="mt-4 text-2xl font-bold tracking-tight text-neutral-titulos"
                >
                    Accés denegat
                </h1>

                <p class="mt-3 text-sm leading-relaxed text-neutral">
                    El teu compte no té els permisos necessaris per
                    accedir a aquesta secció del panell d’administració.
                </p>

                <p class="mt-3 text-xs leading-relaxed text-neutral">
                    Si creus que hauries de tenir-hi accés, contacta
                    amb l’administració perquè revisi els teus permisos.
                </p>

                <div
                    class="mt-7 flex flex-col justify-center gap-3 sm:flex-row"
                >
                    <a
                        href="/perfil"
                        class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-xs font-semibold text-white transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <circle cx="12" cy="8" r="3.5" />
                            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
                        </svg>

                        Anar al meu perfil
                    </a>

                    <a
                        href="/"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-border/50 bg-background px-4 py-2.5 text-xs font-semibold text-neutral-titulos transition hover:border-primary/25 hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9" />
                        </svg>

                        Tornar a l’inici
                    </a>
                </div>
            </div>
        </section>
    </main>
</LayoutSinMenu>