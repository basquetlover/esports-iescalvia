---
import LayoutPanel from "@layouts/LayoutPanel.astro";
import Configuracion from "@components/panel/configuracion/Configuracion";

export const prerender = false;

Astro.response.headers.set(
    "Cache-Control",
    "private, no-store",
);
---

<LayoutPanel
    title="Configuració de la plataforma"
    seccion="configuracio"
    accion="ver"
>
    <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <Configuracion client:load />

        <noscript>
            <section class="rounded-2xl border border-border bg-background p-6 text-neutral">
                <h1 class="text-xl font-semibold text-neutral-titulos">
                    Configuració de la plataforma
                </h1>

                <p class="mt-3 text-sm leading-6">
                    Necessites activar JavaScript per gestionar
                    la configuració de la plataforma.
                </p>
            </section>
        </noscript>
    </div>
</LayoutPanel>