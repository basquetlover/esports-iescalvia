---
import Error404 from "@components/panel/Error404.astro";
import CrearTorneo from "@components/panel/torneos/CrearTorneo";
import LayoutPanel from "@layouts/LayoutPanel.astro";

const url = Astro.url;

const accio = url.searchParams.get("accio");
const torneoID = url.searchParams.get("torneoID");
const accionValida = accio === "crear" || ((accio === "ver" || accio === "editar") && Boolean(torneoID));
if (!accionValida) Astro.response.status = 404;

---

<LayoutPanel title={`Torneig`} seccion="tornejos" accion={accio === "crear" ? "crear" : accio === "editar" ? "editar" : "ver"}>
    {
        accionValida && (
            <CrearTorneo torneoID={accio === "crear" ? null : torneoID} accion={accio as "crear" | "ver" | "editar"} client:load />
        )
    }

    {
        !accionValida && (
            <Error404 atras="/panell/tornejos" inicio="/panell" />
        )
    }
    
</LayoutPanel>