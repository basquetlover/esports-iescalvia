---
import LayoutPanel from "@layouts/LayoutPanel.astro";
import Detalle from "@components/panel/voluntaris/Detalle";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

// ============================================================
// PARÁMETROS
// ============================================================

const voluntarioID = Astro.params.id?.trim().toLowerCase() ?? "";

const torneoID =
  Astro.url.searchParams.get("torneoID")?.trim().toLowerCase() ?? "";

const edicionID =
  Astro.url.searchParams.get("edicionID")?.trim().toLowerCase() ?? "";

// ============================================================
// VALIDACIÓN
// ============================================================

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const voluntarioValido = UUID.test(voluntarioID);

const torneoValido = UUID.test(torneoID);

const edicionValida = UUID.test(edicionID);

const parametrosValidos = voluntarioValido && torneoValido && edicionValida;

if (!parametrosValidos) {
  Astro.response.status = 404;
}

// ============================================================
// ENLACE DE RETORNO
// ============================================================

const volver =
  torneoValido && edicionValida
    ? `/panell/voluntaris?${new URLSearchParams({
        torneoID,
        edicionID,
      }).toString()}`
    : "/panell";
---

<LayoutPanel title="Fitxa del voluntari" seccion="voluntaris" accion="ver">
  <div class="min-h-full w-full bg-background pb-10">
    <!-- =================================================
            CABECERA / BREADCRUMBS
        ================================================== -->

    <header class="border-b border-border/50 bg-card/40">
      <div
        class="mx-auto flex w-full max-w-[1600px] flex-wrap items-center justify-between gap-3 px-4 py-3 md:px-6"
      >
        <nav aria-label="Fil d'Ariadna">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-neutral">
            <li>
              <a
                href="/panell"
                class="rounded transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                Panell d'administració
              </a>
            </li>

            <li aria-hidden="true" class="text-neutral/40">/</li>

            {
              torneoValido && edicionValida ? (
                <>
                  <li>
                    <a
                      href={volver}
                      class="rounded transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      Voluntaris
                    </a>
                  </li>

                  <li aria-hidden="true" class="text-neutral/40">
                    /
                  </li>
                </>
              ) : null
            }

            <li aria-current="page" class="font-semibold text-neutral-titulos">
              Fitxa del voluntari
            </li>
          </ol>
        </nav>

        <a
          href={volver}
          class="inline-flex items-center gap-2 rounded-lg border border-border/50 bg-card px-3 py-2 text-xs font-semibold text-neutral-titulos transition hover:border-primary/25 hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M5 12h14"></path>
          </svg>

          Tornar als voluntaris
        </a>
      </div>
    </header>

    <!-- =================================================
            CONTENIDO
        ================================================== -->

    <section
      class="mx-auto w-full max-w-[1600px] px-4 py-5 md:px-6 md:py-6"
      aria-labelledby="fitxa-voluntari-titol"
    >
      <h1 id="fitxa-voluntari-titol" class="sr-only">Fitxa del voluntari</h1>

      {
        parametrosValidos ? (
          <Detalle
            voluntarioID={voluntarioID}
            torneoID={torneoID}
            edicionID={edicionID}
            volver={volver}
            client:load
          />
        ) : (
          <div
            role="alert"
            class="rounded-2xl border border-border/50 bg-card px-6 py-14 text-center"
          >
            <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-error/10 text-error">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5" />
                <path d="M12 16h.01" />
              </svg>
            </div>

            <h2 class="text-lg font-semibold text-neutral-titulos">
              Voluntari no vàlid
            </h2>

            <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-neutral">
              No s'ha pogut identificar correctament el voluntari, el torneig o
              l'edició seleccionada.
            </p>

            <a
              href={volver}
              class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d="m12 19-7-7 7-7" />
                <path d="M5 12h14" />
              </svg>
              Tornar
            </a>
          </div>
        )
      }
    </section>
  </div>
</LayoutPanel>
