---
import LayoutPanell from "@layouts/LayoutPanel.astro";
import ResumenPanel from "@components/panel/index/ResumenPanel";

const torneoID = Astro.url.searchParams.get("torneoID");
const edicionID = torneoID
    ? Astro.url.searchParams.get("edicionID")
    : null;
---

<LayoutPanell title="Panell d'administració">
    <ResumenPanel
        client:load
        torneoID={torneoID}
        edicionID={edicionID}
    />
</LayoutPanell>