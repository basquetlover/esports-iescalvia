---
import LayoutPanel from "@layouts/LayoutPanel.astro";
import Detalle from "@components/panel/usuaris/Detalle";

export const prerender = false;

const { uuid } = Astro.params;

const usuarioID = uuid ?? "";

const identificadorValido =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
        usuarioID
    );

if (!identificadorValido) {
    Astro.response.status = 404;
}
---

<LayoutPanel
    title="Fitxa d’usuari"
    seccion="usuaris"
    accion="ver"
>
    <section class="w-full p-4 md:p-6">
        <header class="mb-6">
            <a
                href="/panell/usuaris"
                class="mb-4 inline-flex items-center gap-2 rounded-md text-sm font-semibold text-primary transition hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m12 19-7-7 7-7M5 12h14" />
                </svg>

                Tornar als usuaris
            </a>

            <h1 class="text-2xl font-bold text-neutral-titulos">
                Fitxa d’usuari
            </h1>

            <p class="mt-2 text-sm text-neutral">
                Consulta les dades del compte, els permisos,
                els tornejos i l’historial de sessions.
            </p>
        </header>

        {
            identificadorValido ? (
                <Detalle usuarioID={usuarioID} client:load />
            ) : (
                <div
                    class="rounded-xl border border-border bg-card px-4 py-12 text-center"
                    role="alert"
                >
                    <h2 class="text-lg font-semibold text-neutral-titulos">
                        Identificador d’usuari no vàlid
                    </h2>

                    <p class="mt-2 text-sm text-neutral">
                        Torna al llistat i selecciona un usuari
                        per consultar-ne la fitxa.
                    </p>
                </div>
            )
        }
    </section>
</LayoutPanel>