---
import LayoutPanel from "@layouts/LayoutPanel.astro";
import Detalle from "@components/panel/usuaris/Detalle";

export const prerender = false;

const usuarioID = Astro.params.uuid ?? "";

const identificadorValido =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
        usuarioID
    );

if (!identificadorValido) {
    Astro.response.status = 404;
}
---

<LayoutPanel
    title="Fitxa d’usuari"
    seccion="usuaris"
    accion="ver"
>
    <div class="min-h-full w-full bg-background mb-10">
        <header class="border-b border-border/50 bg-card/40">
            <div
                class="mx-auto flex w-full max-w-[1600px] flex-wrap items-center justify-between gap-3 px-4 py-3 md:px-6"
            >
                <nav aria-label="Fil d’Ariadna">
                    <ol
                        class="flex flex-wrap items-center gap-2 text-xs text-neutral"
                    >
                        <li>
                            <a
                                href="/panell"
                                class="rounded transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            >
                                Panell d’administració
                            </a>
                        </li>

                        <li aria-hidden="true" class="text-neutral/40">
                            /
                        </li>

                        <li>
                            <a
                                href="/panell/usuaris"
                                class="rounded transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            >
                                Usuaris
                            </a>
                        </li>

                        <li aria-hidden="true" class="text-neutral/40">
                            /
                        </li>

                        <li
                            aria-current="page"
                            class="font-semibold text-neutral-titulos"
                        >
                            Fitxa d’usuari
                        </li>
                    </ol>
                </nav>

                <a
                    href="/panell/usuaris"
                    class="inline-flex items-center gap-2 rounded-lg border border-border/50 bg-card px-3 py-2 text-xs font-semibold text-neutral-titulos transition hover:border-primary/25 hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3.5 w-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m12 19-7-7 7-7M5 12h14" />
                    </svg>

                    Tornar a usuaris
                </a>
            </div>
        </header>

        <section
            class="mx-auto w-full max-w-[1600px] px-4 py-5 md:px-6 md:py-6"
            aria-labelledby="fitxa-usuari-titol"
        >
            <h1 id="fitxa-usuari-titol" class="sr-only">
                Fitxa d’usuari
            </h1>

            {
                identificadorValido ? (
                    <Detalle usuarioID={usuarioID} client:load />
                ) : (
                    <div
                        class="rounded-2xl border border-border/50 bg-card px-6 py-14 text-center"
                        role="alert"
                    >
                        <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-error/10 text-error">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 8v5M12 16h.01" />
                            </svg>
                        </div>

                        <h2 class="text-lg font-semibold text-neutral-titulos">
                            Identificador d’usuari no vàlid
                        </h2>

                        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-neutral">
                            Torna al llistat i selecciona un usuari
                            per consultar-ne la fitxa.
                        </p>
                    </div>
                )
            }
        </section>
    </div>
</LayoutPanel>