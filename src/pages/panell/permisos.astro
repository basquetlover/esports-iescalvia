---
import LayoutPanel from "@layouts/LayoutPanel.astro";
import Gestion from "@components/panel/permisos/Gestion";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");
---

<LayoutPanel
    title="Gestió de permisos"
    seccion="permisos"
    accion="ver"
>
    <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <Gestion client:load />

        <noscript>
            <div
                class="rounded-xl border border-border bg-white p-6 text-secondary in-[.oscuro_&]:bg-card"
                role="alert"
            >
                <h1 class="text-lg font-semibold">
                    Gestió de permisos
                </h1>

                <p class="mt-2 text-sm">
                    Necessites activar JavaScript per consultar i gestionar
                    els permisos dels usuaris.
                </p>
            </div>
        </noscript>
    </div>
</LayoutPanel>