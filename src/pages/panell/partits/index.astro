---
import Gestor from "@components/panel/partits/Gestor";
import LayoutPanel from "@layouts/LayoutPanel.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const torneoID = Astro.url.searchParams.get("torneoID")?.trim() ?? "";

const edicionID = Astro.url.searchParams.get("edicionID")?.trim() ?? "";

if (!torneoID || !edicionID) {
  return Astro.redirect("/panell", 303);
}
---

<LayoutPanel title="Calendari i resultats" seccion="partits" accion="ver">
  <div class="w-full p-4">
    <div
      class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.14em] text-primary"
        >
          Edició seleccionada
        </p>

        <h1
          class="mt-1 text-3xl font-bold tracking-tight text-neutral-titulos max-md:text-2xl"
        >
          Calendari i resultats
        </h1>

        <p class="mt-1 max-w-3xl text-sm leading-6 text-neutral">
          Crea i programa els partits de l'edició, assigna les pistes i gestiona
          els resultats de la competició.
        </p>
      </div>
    </div>
  </div>

  <Gestor torneoID={torneoID} edicionID={edicionID} client:load />
</LayoutPanel>
