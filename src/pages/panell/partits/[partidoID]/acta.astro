---
import Gestor from "@components/panel/acta/Gestor";
import LayoutPanel from "@layouts/LayoutPanel.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const partidoID = Astro.params.partidoID?.trim() ?? "";

const torneoID = Astro.url.searchParams.get("torneoID")?.trim() ?? "";

const edicionID = Astro.url.searchParams.get("edicionID")?.trim() ?? "";

/*
 * Para entrar en una acta necesitamos conocer:
 *
 * - partido
 * - torneo
 * - edición
 *
 * De momento no validamos aquí las UUID.
 * Esa validación se hará posteriormente en la API.
 */
if (!partidoID || !torneoID || !edicionID) {
  return Astro.redirect("/panell/partits", 303);
}
---

<LayoutPanel title="Acta digital" seccion="acta-digital" accion="ver">
  <Gestor
    partidoID={partidoID}
    torneoID={torneoID}
    edicionID={edicionID}
    client:load
  />
</LayoutPanel>
