---
import RecuperarContrasena from "@components/sesion/recuperar-contrasena";
import LayoutSinMenu from "@layouts/LayoutSinMenu.astro";

const token_recuperar = Astro.url.searchParams.get("token");


---

<LayoutSinMenu title="Recuperar contrasenya">
<div class="w-full min-h-screen relative top-0 left-0 p-4 flex items-center place-content-center overflow-hidden">
    <div class="w-120 h-120 degradado absolute rounded-full  -top-30 -left-30">
        &nbsp;
    </div>
    <div class="w-150 h-150 degradado absolute rounded-full  -bottom-40 -right-40">
        &nbsp;
    </div>


    <div class="max-w-lg w-full h-auto p-4  z-10">
        <RecuperarContrasena token_recuperar={token_recuperar} client:load/>
    </div>
</div>
</LayoutSinMenu>
