
---
import LayoutPerfil from "@layouts/LayoutPerfil.astro";

import { ErrorAPI } from "@utils/inscripcio/equipBase";

import {
  obtenirEdicionsVoluntariat,
  type AccesoEdicionVoluntariat,
} from "@utils/voluntariat/acceso";

export const prerender = false;

// ============================================================
// SEGURIDAD Y CACHÉ
// ============================================================

Astro.response.headers.set(
  "Cache-Control",
  "private, no-store, no-cache, must-revalidate",
);

// ============================================================
// TIPOS
// ============================================================

type Edicion = AccesoEdicionVoluntariat["edicion"];

type Torneo = {
  id: string;
  nombre: string;
  deporte: string | null;
  logo: string | null;
  ediciones: Edicion[];
};

// ============================================================
// CONSULTAR ACCESOS AUTORIZADOS
// ============================================================

/*
 * No confiamos en el rol general del usuario.
 *
 * El controlador comprueba:
 *
 * - Sesión activa.
 * - Formularios aprobados.
 * - Validación del voluntario.
 * - Plaza confirmada.
 * - Relación entre torneo y edición.
 *
 * La comprobación se realiza nuevamente
 * en cada petición a esta página.
 */

let accesos: AccesoEdicionVoluntariat[] = [];

try {
  accesos = await obtenirEdicionsVoluntariat(
    Astro.cookies,
  );
} catch (error) {
  if (
    error instanceof ErrorAPI &&
    error.estado === 401
  ) {
    return Astro.redirect(
      "/iniciar-sessio",
      303,
    );
  }

  throw error;
}

// ============================================================
// AGRUPAR POR TORNEO
// ============================================================

const mapaTorneos = new Map<string, Torneo>();

for (const acceso of accesos) {
  let torneo = mapaTorneos.get(acceso.torneoID);

  if (!torneo) {
    torneo = {
      id: acceso.torneo.id,
      nombre: acceso.torneo.nombre,
      deporte: acceso.torneo.deporte,
      logo: acceso.torneo.logo,
      ediciones: [],
    };

    mapaTorneos.set(acceso.torneoID, torneo);
  }

  const existe = torneo.ediciones.some(
    (edicion) =>
      edicion.id === acceso.edicionID,
  );

  if (!existe) {
    torneo.ediciones.push(acceso.edicion);
  }
}

// ============================================================
// ORDENAR
// ============================================================

const torneos = [...mapaTorneos.values()]
  .map((torneo) => ({
    ...torneo,

    ediciones: [...torneo.ediciones].sort(
      (a, b) =>
        (
          b.fechaInicio ?? ""
        ).localeCompare(
          a.fechaInicio ?? "",
        ),
    ),
  }))
  .sort((a, b) =>
    a.nombre.localeCompare(
      b.nombre,
      "ca",
      {
        numeric: true,
      },
    ),
  );

// ============================================================
// RESUMEN
// ============================================================

const totalTorneos = torneos.length;

const totalEdiciones = torneos.reduce(
  (total, torneo) =>
    total + torneo.ediciones.length,
  0,
);

// ============================================================
// FUNCIONES DE PRESENTACIÓN
// ============================================================

function nombreEstado(
  estado: string | null,
): string {
  const valor = estado
    ?.trim()
    .toUpperCase();

  switch (valor) {
    case "ACTIVA":
    case "ACTIVO":
    case "ACTIU":
      return "Activa";

    case "FINALIZADA":
    case "FINALITZADA":
    case "FINALIZADO":
      return "Finalitzada";

    case "BORRADOR":
      return "En preparació";

    case "CANCELADA":
    case "CANCELADO":
      return "Cancel·lada";

    default:
      return "Edició";
  }
}

function estadoActivo(
  estado: string | null,
): boolean {
  const valor = estado
    ?.trim()
    .toUpperCase();

  return (
    valor === "ACTIVA" ||
    valor === "ACTIVO" ||
    valor === "ACTIU"
  );
}

function formatearFecha(
  fecha: string | null,
): string | null {
  if (!fecha) {
    return null;
  }

  const valor = new Date(fecha);

  if (Number.isNaN(valor.getTime())) {
    return null;
  }

  return new Intl.DateTimeFormat(
    "ca-ES",
    {
      month: "long",
      year: "numeric",
      timeZone: "Europe/Madrid",
    },
  ).format(valor);
}

function nombreDeporte(
  deporte: string | null,
): string {
  switch (deporte?.toUpperCase()) {
    case "VOLEIBOL":
      return "Voleibol";

    case "FUTBOL":
      return "Futbol";

    case "BALONCESTO":
    case "BASQUET":
      return "Bàsquet";

    default:
      return "Competició esportiva";
  }
}
---

<LayoutPerfil title="Voluntariat">
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-6 p-4 pb-12 sm:p-6"
  >
    <!-- ======================================================
         CABECERA
         ====================================================== -->

    <header class="space-y-5">
      <nav
        aria-label="Ruta de navegació"
        class="flex items-center gap-2 text-xs font-medium"
      >
        <a
          href="/perfil"
          class="text-neutral transition hover:text-primary"
        >
          El meu perfil
        </a>

        <span class="text-neutral/50">
          /
        </span>

        <span class="font-semibold text-primary">
          Voluntariat
        </span>
      </nav>

      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <p
            class="text-xs font-bold uppercase tracking-[0.14em] text-primary"
          >
            Portal del voluntariat
          </p>

          <h1
            class="mt-2 text-3xl font-bold tracking-tight text-neutral-titulos sm:text-4xl"
          >
            El meu voluntariat
          </h1>

          <p
            class="mt-3 max-w-2xl text-sm leading-6 text-neutral"
          >
            Accedeix als tornejos en què participes,
            consulta les teves edicions i gestiona
            les activitats que tens assignades.
          </p>
        </div>

        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-7 w-7"
            aria-hidden="true"
          >
            <path d="M12 21s-7-4.5-9-8.5C1.5 9 3 6 6 6c2 0 3.5 1 6 3 2.5-2 4-3 6-3 3 0 4.5 3 3 6.5-2 4-9 8.5-9 8.5Z" />
            <path d="M8 13h8M12 9v8" />
          </svg>
        </div>
      </div>
    </header>

    <!-- ======================================================
         RESUMEN DE PARTICIPACIÓN
         ====================================================== -->

    <section
      aria-label="Resum de participació"
      class="grid grid-cols-2 gap-3"
    >
      <div
        class="rounded-2xl border border-border bg-card p-4 shadow-sm sm:p-5"
      >
        <div
          class="flex items-center gap-2 text-xs font-semibold text-neutral"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M8 21h8M12 17v4M7 3h10v7a5 5 0 0 1-10 0V3Z" />
            <path d="M7 5H4v3a4 4 0 0 0 4 4M17 5h3v3a4 4 0 0 1-4 4" />
          </svg>

          Tornejos
        </div>

        <p
          class="mt-2 text-3xl font-bold tabular-nums text-neutral-titulos"
        >
          {totalTorneos}
        </p>
      </div>

      <div
        class="rounded-2xl border border-border bg-card p-4 shadow-sm sm:p-5"
      >
        <div
          class="flex items-center gap-2 text-xs font-semibold text-neutral"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M7 3v4M17 3v4M3 10h18" />
          </svg>

          Edicions
        </div>

        <p
          class="mt-2 text-3xl font-bold tabular-nums text-neutral-titulos"
        >
          {totalEdiciones}
        </p>
      </div>
    </section>

    <!-- ======================================================
         SIN TORNEOS AUTORIZADOS
         ====================================================== -->

    {
      torneos.length === 0 && (
        <section
          class="rounded-2xl border border-border bg-card px-5 py-12 text-center shadow-sm"
        >
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-8 w-8"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="4" />
              <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
            </svg>
          </div>

          <h2
            class="mt-5 text-xl font-bold text-neutral-titulos"
          >
            No tens cap voluntariat actiu
          </h2>

          <p
            class="mx-auto mt-3 max-w-lg text-sm leading-6 text-neutral"
          >
            Actualment no tens accés confirmat
            a cap edició d'un torneig.
            Si has enviat una sol·licitud,
            pots consultar-ne l'estat
            a les teves inscripcions.
          </p>

          <a
            href="/perfil/inscripcions"
            class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90"
          >
            Les meves inscripcions
          </a>
        </section>
      )
    }

    <!-- ======================================================
         SELECTOR DE TORNEOS
         ====================================================== -->

    {
      torneos.length > 0 && (
        <section class="space-y-4">
          <div
            class="flex flex-wrap items-end justify-between gap-3"
          >
            <div>
              <h2
                class="text-xl font-bold text-neutral-titulos"
              >
                Selecciona un torneig
              </h2>

              <p
                class="mt-1 text-sm text-neutral"
              >
                Cada torneig té les seves edicions
                i designacions independents.
              </p>
            </div>

            <span
              class="rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-neutral"
            >
              {totalTorneos}
              {
                totalTorneos === 1
                  ? " torneig"
                  : " tornejos"
              }
            </span>
          </div>

          <div
            class="grid grid-cols-1 gap-4 lg:grid-cols-2"
          >
            {
              torneos.map((torneo) => (
                <article
                  class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition duration-200 hover:border-primary/40 hover:shadow-md"
                >
                  <!-- CABECERA DEL TORNEO -->

                  <div
                    class="flex items-start gap-4 p-5"
                  >
                    <div
                      class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-border bg-background p-2"
                    >
                      {
                        torneo.logo ? (
                          <img
                            src={torneo.logo}
                            alt={`Escut de ${torneo.nombre}`}
                            loading="lazy"
                            class="h-full w-full object-contain"
                          />
                        ) : (
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-9 w-9 text-primary"
                            aria-hidden="true"
                          >
                            <path d="M8 21h8M12 17v4M7 3h10v7a5 5 0 0 1-10 0V3Z" />
                            <path d="M7 5H4v3a4 4 0 0 0 4 4M17 5h3v3a4 4 0 0 1-4 4" />
                          </svg>
                        )
                      }
                    </div>

                    <div class="min-w-0 flex-1">
                      <p
                        class="text-xs font-semibold uppercase tracking-wide text-primary"
                      >
                        {nombreDeporte(torneo.deporte)}
                      </p>

                      <h3
                        class="mt-1 break-words text-lg font-bold leading-snug text-neutral-titulos"
                      >
                        {torneo.nombre}
                      </h3>

                      <p
                        class="mt-2 text-xs text-neutral"
                      >
                        {torneo.ediciones.length}
                        {
                          torneo.ediciones.length === 1
                            ? " edició autoritzada"
                            : " edicions autoritzades"
                        }
                      </p>
                    </div>
                  </div>

                  <!-- EDICIONES DEL TORNEO -->

                  <div
                    class="flex-1 border-t border-border bg-background/40 px-5 py-4"
                  >
                    <p
                      class="mb-3 text-xs font-bold uppercase tracking-wide text-neutral"
                    >
                      Les meves edicions
                    </p>

                    <div class="flex flex-col gap-2">
                      {
                        torneo.ediciones.map((edicion) => (
                          <div
                            class="flex min-w-0 items-center justify-between gap-3 rounded-xl border border-border bg-card px-3 py-2.5"
                          >
                            <div class="min-w-0">
                              <p
                                class="truncate text-sm font-semibold text-neutral-titulos"
                              >
                                {edicion.nombre}
                              </p>

                              {
                                formatearFecha(
                                  edicion.fechaInicio,
                                ) && (
                                  <p
                                    class="mt-0.5 text-xs capitalize text-neutral"
                                  >
                                    {formatearFecha(
                                      edicion.fechaInicio,
                                    )}
                                  </p>
                                )
                              }
                            </div>

                            <span
                              class:list={[
                                "shrink-0 rounded-lg px-2.5 py-1 text-xs font-semibold",
                                estadoActivo(edicion.estado)
                                  ? "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300"
                                  : "bg-background text-neutral",
                              ]}
                            >
                              {nombreEstado(edicion.estado)}
                            </span>
                          </div>
                        ))
                      }
                    </div>
                  </div>

                  <!-- ACCESO AL TORNEO -->

                  <div
                    class="border-t border-border p-4 sm:p-5"
                  >
                    <a
                      href={`/perfil/voluntariat/${torneo.id}`}
                      aria-label={`Accedir al voluntariat de ${torneo.nombre}`}
                      class="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-white transition hover:opacity-90"
                    >
                      Accedir al torneig

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      )
    }

    <!-- ======================================================
         INFORMACIÓN
         ====================================================== -->

    <aside
      class="rounded-2xl border border-border bg-card p-4 sm:p-5"
    >
      <div class="flex items-start gap-3">
        <div
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
          </svg>
        </div>

        <div>
          <h2
            class="text-sm font-bold text-neutral-titulos"
          >
            Informació del voluntariat
          </h2>

          <p
            class="mt-1 text-sm leading-6 text-neutral"
          >
            Les autoritzacions es comproven
            individualment per cada edició.
            Si l'organització cancel·la
            o revoca el teu accés,
            deixaràs de poder accedir
            a la informació protegida
            d'aquella edició.
          </p>
        </div>
      </div>
    </aside>
  </div>
</LayoutPerfil>
