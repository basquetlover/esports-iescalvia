                                                                </svg>
                                                            </span>

                                                            <div class="min-w-0">
                                                                <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">
                                                                    Rol seleccionat
                                                                </p>

                                                                <p class="mt-1 text-lg font-bold text-neutral-titulos">
                                                                    {
                                                                        rol
                                                                    }
                                                                </p>

                                                                <p class="mt-1 text-xs leading-5 text-neutral">
                                                                    Aquest és el rol de voluntariat que vas seleccionar en enviar la sol·licitud.
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                )
                                            }

                                            <dl class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
                                                {
                                                    inscripcion
                                                        .edicion && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Edició
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    inscripcion
                                                                        .edicion
                                                                        .nombre
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }

                                                {
                                                    !esVoluntario && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Accés
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    inscripcion
                                                                        .formulario
                                                                        .tipoAcceso ===
                                                                    "propietario"
                                                                        ? "Responsable de la inscripció"
                                                                        : "Capità de l'equip"
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }

                                                {
                                                    esVoluntario &&
                                                    inscripcion
                                                        .voluntario
                                                        ?.curso && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Curs
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    inscripcion
                                                                        .voluntario
                                                                        .curso
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }

                                                {
                                                    esVoluntario &&
                                                    inscripcion
                                                        .voluntario
                                                        ?.grupo && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Grup
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    inscripcion
                                                                        .voluntario
                                                                        .grupo
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }

                                                {
                                                    plaza && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Plaça
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    plaza
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }

                                                {
                                                    inscripcion
                                                        .edicion
                                                        ?.sede && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Seu
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    inscripcion
                                                                        .edicion
                                                                        .sede
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }

                                                {
                                                    fechaTorneo && (
                                                        <div class="rounded-xl bg-background px-4 py-3">
                                                            <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral/60">
                                                                Data del torneig
                                                            </dt>

                                                            <dd class="mt-1 text-sm font-medium text-neutral-titulos">
                                                                {
                                                                    fechaTorneo
                                                                }
                                                            </dd>
                                                        </div>
                                                    )
                                                }
                                            </dl>

                                            <!-- =================================================
                                                LISTA DE ESPERA
                                            ================================================== -->

                                            {
                                                (
                                                    esVoluntario
                                                        ? inscripcion
                                                              .voluntario
                                                              ?.plaza_estado
                                                        : inscripcion
                                                              .equipo
                                                              ?.plaza_estado
                                                )
                                                    ?.trim()
                                                    .toUpperCase() ===
                                                    "LISTA_ESPERA" && (
                                                    <div class="mt-4 flex items-start gap-3 rounded-xl border border-border bg-background p-4">
                                                        <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary/10 text-secondary">
                                                            <svg
                                                                xmlns="http://www.w3.org/2000/svg"
                                                                viewBox="0 -960 960 960"
                                                                class="h-4 w-4 fill-current"
                                                                aria-hidden="true"
                                                            >
                                                                <path d="M160-200v-80h560v80H160Zm0-160v-80h560v80H160Zm0-160v-80h560v80H160Zm0-160v-80h560v80H160Zm640 480v-560h80v560h-80Z"></path>
                                                            </svg>
                                                        </span>

                                                        <div>
                                                            <p class="text-sm font-semibold text-neutral-titulos">
                                                                Llista d'espera
                                                            </p>

                                                            {
                                                                (
                                                                    esVoluntario
                                                                        ? inscripcion
                                                                              .voluntario
                                                                              ?.posicion_lista_espera
                                                                        : inscripcion
                                                                              .equipo
                                                                              ?.posicion_lista_espera
                                                                ) !==
                                                                    null &&
                                                                    (
                                                                        esVoluntario
                                                                            ? inscripcion
                                                                                  .voluntario
                                                                                  ?.posicion_lista_espera
                                                                            : inscripcion
                                                                                  .equipo
                                                                                  ?.posicion_lista_espera
                                                                    ) !==
                                                                        undefined && (
                                                                    <p class="mt-1 text-xs text-neutral">
                                                                        Posició actual:{" "}
                                                                        {
                                                                            esVoluntario
                                                                                ? inscripcion
                                                                                      .voluntario
                                                                                      ?.posicion_lista_espera
                                                                                : inscripcion
                                                                                      .equipo
                                                                                      ?.posicion_lista_espera
                                                                        }
                                                                    </p>
                                                                )
                                                            }
                                                        </div>
                                                    </div>
                                                )
                                            }

                                            <!-- =================================================
                                                ACCIONES
                                            ================================================== -->

                                            <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
                                                <div class="text-xs text-neutral/70">
                                                    {
                                                        fecha && (
                                                            <>
                                                                Darrera actualització:{" "}
                                                                <span class="font-medium text-neutral">
                                                                    {
                                                                        fecha
                                                                    }
                                                                </span>
                                                            </>
                                                        )
                                                    }
                                                </div>

                                                <div class="flex flex-wrap gap-2">
                                                    {
                                                        enlaceTorneo && (
                                                            <a
                                                                href={
                                                                    enlaceTorneo
                                                                }
                                                                class="inline-flex items-center justify-center rounded-lg border border-border px-3.5 py-2 text-sm font-semibold text-neutral-titulos transition hover:border-primary/30 hover:text-primary"
                                                            >
                                                                Veure torneig
                                                            </a>
                                                        )
                                                    }

                                                    {
                                                        enlaceFormulario && (
                                                            <a
                                                                href={
                                                                    enlaceFormulario
                                                                }
                                                                class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-primary/90"
                                                            >
                                                                {
                                                                    estadoActual ===
                                                                    "EN_REVISION"
                                                                        ? "Veure inscripció"
                                                                        : "Gestionar inscripció"
                                                                }

                                                                <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    viewBox="0 -960 960 960"
                                                                    class="h-4 w-4 fill-current"
                                                                    aria-hidden="true"
                                                                >
                                                                    <path d="m647-440-224 224 57 56 320-320-320-320-57 56 224 224H160v80h487Z"></path>
                                                                </svg>
                                                            </a>
                                                        )
                                                    }

                                                    {
                                                        enlaceVoluntariado && (
                                                            <a
                                                                href={
                                                                    enlaceVoluntariado
                                                                }
                                                                class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-primary/90"
                                                            >
                                                                Veure voluntariat

                                                                <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    viewBox="0 -960 960 960"
                                                                    class="h-4 w-4 fill-current"
                                                                    aria-hidden="true"
                                                                >
                                                                    <path d="m647-440-224 224 57 56 320-320-320-320-57 56 224 224H160v80h487Z"></path>
                                                                </svg>
                                                            </a>
                                                        )
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </article>
                                );
                            },
                        )
                    }
                </div>
            ) : total > 0 ? (
                <div class="mt-8 rounded-2xl border border-dashed border-border bg-card/40 px-6 py-12 text-center">
                    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 -960 960 960"
                            class="h-6 w-6 fill-current"
                            aria-hidden="true"
                        >
                            <path d="M280-200h400v-80H280v80Zm0-160h400v-80H280v80Zm0-160h400v-80H280v80Zm-80 400q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Z"></path>
                        </svg>
                    </span>

                    <h2 class="mt-4 text-lg font-semibold text-neutral-titulos">
                        No hi ha inscripcions amb aquests filtres
                    </h2>

                    <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-neutral">
                        Prova un altre tipus d'inscripció o un altre estat.
                    </p>

                    <a
                        href="/perfil/inscripcions"
                        class="mt-5 inline-flex items-center justify-center rounded-lg border border-border px-4 py-2.5 text-sm font-semibold text-neutral-titulos transition hover:border-primary/30 hover:text-primary"
                    >
                        Mostrar-les totes
                    </a>
                </div>
            ) : (
                <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-card">
                    <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
                        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 -960 960 960"
                                class="h-7 w-7 fill-current"
                                aria-hidden="true"
                            >
                                <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h168q13-36 43.5-58t68.5-22 68.5 22 43.5 58h168q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm80-160h280v-80H280v80Zm0-160h400v-80H280v80Zm0-160h400v-80H280v80Z"></path>
                            </svg>
                        </span>

                        <h2 class="mt-5 text-xl font-semibold text-neutral-titulos">
                            Encara no tens cap inscripció
                        </h2>

                        <p class="mt-2 max-w-lg text-sm leading-6 text-neutral">
                            Quan inscriguis un equip, et donin accés com a
                            capità o enviïs una sol·licitud de voluntariat,
                            apareixerà aquí.
                        </p>

                        <a
                            href="/tornejos"
                            class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary/90"
                        >
                            Consultar tornejos

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 -960 960 960"
                                class="h-4 w-4 fill-current"
                                aria-hidden="true"
                            >
                                <path d="m647-440-224 224 57 56 320-320-320-320-57 56 224 224H160v80h487Z"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            )
        }
    </div>
</LayoutPerfil>