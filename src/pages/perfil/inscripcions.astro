---
import LayoutPerfil from "@layouts/LayoutPerfil.astro";

import { obtenerUsuarioPorToken } from "@pages/api/sesiones/sesiones";
import { supabaseAdmin } from "@utils/supabase";

export const prerender = false;

// ============================================================
// TIPOS
// ============================================================

type EstadoFormulario =
    | "BORRADOR"
    | "EN_REVISION"
    | "APROBADO"
    | "DENEGADO";

type TipoFormulario =
    | "EQUIPO"
    | "VOLUNTARIO";

type TipoAcceso =
    | "propietario"
    | "capitan";

type FormularioPerfil = {
    id: string;
    edicion_id: string;
    tipo: TipoFormulario;
    estado: EstadoFormulario;
    usuario_id: string | null;
    acceso_capitan: boolean;
    iniciado_at: string | null;
    enviado_at: string | null;
    completado_at: string | null;
    created_at: string | null;
    updated_at: string | null;
    tipoAcceso: TipoAcceso;
};

type EquipoPerfil = {
    id: string;
    formulario_id: string;
    nombre: string | null;
    escudo: string | null;
    capitan_id: string | null;
    plaza_estado: string | null;
    posicion_lista_espera: number | null;
};

type VoluntarioPerfil = {
    id: string;
    formulario_id: string;

    nombre: string | null;
    apellido1: string | null;
    apellido2: string | null;

    email: string | null;

    curso: string | null;
    grupo: string | null;

    tipo_voluntariado_id: string | null;
    tipo_voluntariado: string | null;

    descripcion: string | null;

    validacion_estado: string | null;

    plaza_estado: string | null;
    posicion_lista_espera: number | null;

    created_at: string | null;
    updated_at: string | null;
};

type EdicionPerfil = {
    id: string;
    torneo_id: string;
    nombre: string;
    estado: string;
    sede: string | null;
    fecha_inicio: string | null;
    fecha_fin: string | null;
};

type TorneoPerfil = {
    id: string;
    nombre: string;
    deporte: string | null;
    logo: string | null;
    banner: string | null;
};

type InscripcionPerfil = {
    formulario: FormularioPerfil;
    equipo: EquipoPerfil | null;
    voluntario: VoluntarioPerfil | null;
    edicion: EdicionPerfil | null;
    torneo: TorneoPerfil | null;
};

// ============================================================
// HELPERS
// ============================================================

function normalizarTipoFormulario(
    valor: unknown,
): TipoFormulario | null {
    if (
        typeof valor !==
        "string"
    ) {
        return null;
    }

    const tipo =
        valor
            .trim()
            .toUpperCase();

    if (
        tipo === "EQUIPO" ||
        tipo === "VOLUNTARIO"
    ) {
        return tipo;
    }

    return null;
}

function normalizarEstadoFormulario(
    valor: unknown,
): EstadoFormulario {
    const estado =
        typeof valor === "string"
            ? valor
                  .trim()
                  .toUpperCase()
            : "";

    if (
        estado === "APROBADO" ||
        estado === "ACEPTADO"
    ) {
        return "APROBADO";
    }

    if (
        estado === "DENEGADO"
    ) {
        return "DENEGADO";
    }

    if (
        estado === "EN_REVISION" ||
        estado === "PENDIENTE"
    ) {
        return "EN_REVISION";
    }

    return "BORRADOR";
}

function tiempo(
    valor: string | null,
) {
    if (
        !valor
    ) {
        return 0;
    }

    const fecha =
        new Date(
            valor,
        );

    return Number.isNaN(
        fecha.getTime(),
    )
        ? 0
        : fecha.getTime();
}

function fechaVisible(
    valor: string | null,
) {
    if (
        !valor
    ) {
        return null;
    }

    const fecha =
        new Date(
            valor,
        );

    if (
        Number.isNaN(
            fecha.getTime(),
        )
    ) {
        return null;
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            day:
                "numeric",

            month:
                "long",

            year:
                "numeric",

            timeZone:
                "Europe/Madrid",
        },
    ).format(
        fecha,
    );
}

function estadoEfectivo(
    inscripcion: InscripcionPerfil,
): EstadoFormulario {
    if (
        inscripcion.formulario.tipo ===
            "VOLUNTARIO" &&
        inscripcion.voluntario
    ) {
        const validacion =
            inscripcion.voluntario
                .validacion_estado
                ?.trim()
                .toUpperCase() ??
            "";

        if (
            validacion === "APROBADO" ||
            validacion === "ACEPTADO"
        ) {
            return "APROBADO";
        }

        if (
            validacion ===
            "DENEGADO"
        ) {
            return "DENEGADO";
        }

        if (
            validacion ===
                "PENDIENTE" ||
            validacion ===
                "EN_REVISION"
        ) {
            return "EN_REVISION";
        }
    }

    return inscripcion.formulario
        .estado;
}

function configuracionEstado(
    estado: EstadoFormulario,
    tipo: TipoFormulario,
) {
    if (
        estado ===
        "EN_REVISION"
    ) {
        return {
            etiqueta:
                "En revisió",

            descripcion:
                tipo ===
                "VOLUNTARIO"
                    ? "La sol·licitud de voluntariat està pendent de revisió per part de l'organització."
                    : "La inscripció està pendent de revisió per part de l'organització.",

            clases:
                "bg-secondary/10 text-secondary",

            icono:
                '<path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q150 0 255 105t105 255q0 150-105 255T480-120Zm40-200h80v-200H480v-200h-80v280q0 17 11.5 28.5T440-400h80v80Z"></path>',
        };
    }

    if (
        estado ===
        "APROBADO"
    ) {
        return {
            etiqueta:
                tipo ===
                "VOLUNTARIO"
                    ? "Acceptat"
                    : "Aprovada",

            descripcion:
                tipo ===
                "VOLUNTARIO"
                    ? "La teva sol·licitud de voluntariat ha estat acceptada per l'organització."
                    : "La inscripció ha estat validada per l'organització.",

            clases:
                "bg-primary/10 text-primary",

            icono:
                '<path d="m382-240-228-228 57-57 171 171 367-367 57 57-424 424Z"></path>',
        };
    }

    if (
        estado ===
        "DENEGADO"
    ) {
        return {
            etiqueta:
                tipo ===
                "VOLUNTARIO"
                    ? "No acceptat"
                    : "Requereix canvis",

            descripcion:
                tipo ===
                "VOLUNTARIO"
                    ? "La sol·licitud de voluntariat no ha estat acceptada."
                    : "L'organització ha indicat que s'han de corregir algunes dades.",

            clases:
                "bg-error/10 text-error",

            icono:
                '<path d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Z"></path>',
        };
    }

    return {
        etiqueta:
            "Esborrany",

        descripcion:
            "La inscripció encara no s'ha enviat a revisió.",

        clases:
            "bg-neutral/10 text-neutral",

        icono:
            '<path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h447l193 193v447q0 33-23.5 56.5T760-120H200Zm280-80q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Z"></path>',
    };
}

function fechaActividad(
    formulario: FormularioPerfil,
) {
    if (
        formulario.estado ===
        "EN_REVISION"
    ) {
        return (
            formulario.enviado_at ??
            formulario.updated_at ??
            formulario.iniciado_at
        );
    }

    if (
        formulario.estado ===
            "APROBADO" ||
        formulario.estado ===
            "DENEGADO"
    ) {
        return (
            formulario.completado_at ??
            formulario.updated_at ??
            formulario.enviado_at
        );
    }

    return (
        formulario.updated_at ??
        formulario.iniciado_at ??
        formulario.created_at
    );
}

function nombreVoluntario(
    voluntario: VoluntarioPerfil | null,
) {
    if (
        !voluntario
    ) {
        return "Voluntariat";
    }

    const nombre = [
        voluntario.nombre,
        voluntario.apellido1,
        voluntario.apellido2,
    ]
        .map(
            valor =>
                valor?.trim() ??
                "",
        )
        .filter(
            Boolean,
        )
        .join(
            " ",
        );

    return (
        nombre ||
        "Voluntariat"
    );
}

function nombreRol(
    voluntario: VoluntarioPerfil | null,
) {
    const rol =
        voluntario
            ?.tipo_voluntariado
            ?.trim();

    return (
        rol ||
        "Rol no disponible"
    );
}

function plazaVisible(
    valor: string | null,
) {
    const estado =
        valor
            ?.trim()
            .toUpperCase();

    if (
        estado ===
        "CONFIRMADA"
    ) {
        return "Plaça confirmada";
    }

    if (
        estado ===
        "LISTA_ESPERA"
    ) {
        return "Llista d'espera";
    }

    if (
        estado ===
            "SIN_PLAZA" ||
        estado ===
            "SENSE_PLAÇA"
    ) {
        return "Sense plaça";
    }

    if (
        estado ===
        "PENDIENTE"
    ) {
        return "Pendent";
    }

    return valor?.trim() ||
        null;
}

// ============================================================
// SESIÓN
// ============================================================

const token =
    Astro.cookies.get(
        "token_sesion",
    )?.value;

const usuario =
    token
        ? await obtenerUsuarioPorToken(
              token,
          )
        : null;

// ============================================================
// DATOS
// ============================================================

let formularios:
    FormularioPerfil[] =
    [];

let equipos:
    EquipoPerfil[] =
    [];

let voluntarios:
    VoluntarioPerfil[] =
    [];

let ediciones:
    EdicionPerfil[] =
    [];

let torneos:
    TorneoPerfil[] =
    [];

if (
    usuario
) {
    // ========================================================
    // FORMULARIOS PROPIOS
    // EQUIPO + VOLUNTARIO
    // ========================================================

    const {
        data:
            formulariosPropiosData,

        error:
            errorFormulariosPropios,
    } =
        await supabaseAdmin
            .from(
                "formularios",
            )
            .select(
                "id,edicion_id,tipo,estado,usuario_id,acceso_capitan,iniciado_at,enviado_at,completado_at,created_at,updated_at",
            )
            .eq(
                "usuario_id",
                usuario.id,
            )
            .in(
                "tipo",
                [
                    "EQUIPO",
                    "VOLUNTARIO",
                ],
            );

    if (
        errorFormulariosPropios
    ) {
        console.error(
            "Error carregant les inscripcions de l'usuari:",
            errorFormulariosPropios,
        );
    }

    formularios =
        (
            formulariosPropiosData ??
            []
        ).flatMap(
            formulario => {
                const tipo =
                    normalizarTipoFormulario(
                        formulario.tipo,
                    );

                if (
                    !tipo
                ) {
                    return [];
                }

                return [
                    {
                        id:
                            formulario.id,

                        edicion_id:
                            formulario.edicion_id,

                        tipo,

                        estado:
                            normalizarEstadoFormulario(
                                formulario.estado,
                            ),

                        usuario_id:
                            formulario.usuario_id ??
                            null,

                        acceso_capitan:
                            formulario.acceso_capitan ===
                            true,

                        iniciado_at:
                            formulario.iniciado_at ??
                            null,

                        enviado_at:
                            formulario.enviado_at ??
                            null,

                        completado_at:
                            formulario.completado_at ??
                            null,

                        created_at:
                            formulario.created_at ??
                            null,

                        updated_at:
                            formulario.updated_at ??
                            null,

                        tipoAcceso:
                            "propietario" as const,
                    },
                ];
            },
        );

    // ========================================================
    // ACCESO COMO CAPITÁN
    // SOLO FORMULARIOS DE EQUIPO
    // ========================================================

    const emailUsuario =
        usuario.email
            ?.trim()
            .toLowerCase() ??
        "";

    if (
        emailUsuario
    ) {
        const {
            data:
                participantesData,

            error:
                errorParticipantes,
        } =
            await supabaseAdmin
                .from(
                    "participantes_equipo",
                )
                .select(
                    "id,equipo_id,email,activo",
                )
                .eq(
                    "email",
                    emailUsuario,
                )
                .eq(
                    "activo",
                    true,
                );

        if (
            errorParticipantes
        ) {
            console.error(
                "Error cercant l'accés com a capità:",
                errorParticipantes,
            );
        }

        const idsParticipantes =
            (
                participantesData ??
                []
            ).map(
                participante =>
                    participante.id,
            );

        if (
            idsParticipantes.length >
            0
        ) {
            const {
                data:
                    equiposCapitanData,

                error:
                    errorEquiposCapitan,
            } =
                await supabaseAdmin
                    .from(
                        "equipos",
                    )
                    .select(
                        "id,formulario_id,capitan_id",
                    )
                    .in(
                        "capitan_id",
                        idsParticipantes,
                    );

            if (
                errorEquiposCapitan
            ) {
                console.error(
                    "Error cercant equips com a capità:",
                    errorEquiposCapitan,
                );
            }

            const idsFormulariosCapitan = [
                ...new Set(
                    (
                        equiposCapitanData ??
                        []
                    )
                        .map(
                            equipo =>
                                equipo.formulario_id,
                        )
                        .filter(
                            (
                                id,
                            ): id is string =>
                                typeof id ===
                                    "string" &&
                                Boolean(
                                    id,
                                ),
                        ),
                ),
            ];

            if (
                idsFormulariosCapitan.length >
                0
            ) {
                const {
                    data:
                        formulariosCapitanData,

                    error:
                        errorFormulariosCapitan,
                } =
                    await supabaseAdmin
                        .from(
                            "formularios",
                        )
                        .select(
                            "id,edicion_id,estado,usuario_id,acceso_capitan,iniciado_at,enviado_at,completado_at,created_at,updated_at",
                        )
                        .in(
                            "id",
                            idsFormulariosCapitan,
                        )
                        .eq(
                            "tipo",
                            "EQUIPO",
                        )
                        .eq(
                            "acceso_capitan",
                            true,
                        );

                if (
                    errorFormulariosCapitan
                ) {
                    console.error(
                        "Error carregant formularis com a capità:",
                        errorFormulariosCapitan,
                    );
                }

                const idsExistentes =
                    new Set(
                        formularios.map(
                            formulario =>
                                formulario.id,
                        ),
                    );

                for (
                    const formulario
                    of formulariosCapitanData ??
                        []
                ) {
                    if (
                        idsExistentes.has(
                            formulario.id,
                        )
                    ) {
                        continue;
                    }

                    formularios.push(
                        {
                            id:
                                formulario.id,

                            edicion_id:
                                formulario.edicion_id,

                            tipo:
                                "EQUIPO",

                            estado:
                                normalizarEstadoFormulario(
                                    formulario.estado,
                                ),

                            usuario_id:
                                formulario.usuario_id ??
                                null,

                            acceso_capitan:
                                formulario.acceso_capitan ===
                                true,

                            iniciado_at:
                                formulario.iniciado_at ??
                                null,

                            enviado_at:
                                formulario.enviado_at ??
                                null,

                            completado_at:
                                formulario.completado_at ??
                                null,

                            created_at:
                                formulario.created_at ??
                                null,

                            updated_at:
                                formulario.updated_at ??
                                null,

                            tipoAcceso:
                                "capitan",
                        },
                    );

                    idsExistentes.add(
                        formulario.id,
                    );
                }
            }
        }
    }

    // ========================================================
    // EQUIPOS
    // ========================================================

    const idsFormulariosEquipo =
        formularios
            .filter(
                formulario =>
                    formulario.tipo ===
                    "EQUIPO",
            )
            .map(
                formulario =>
                    formulario.id,
            );

    if (
        idsFormulariosEquipo.length >
        0
    ) {
        const {
            data:
                equiposData,

            error:
                errorEquipos,
        } =
            await supabaseAdmin
                .from(
                    "equipos",
                )
                .select(
                    "id,formulario_id,nombre,escudo,capitan_id,plaza_estado,posicion_lista_espera",
                )
                .in(
                    "formulario_id",
                    idsFormulariosEquipo,
                );

        if (
            errorEquipos
        ) {
            console.error(
                "Error carregant els equips:",
                errorEquipos,
            );
        }

        equipos =
            (
                equiposData ??
                []
            ).map(
                equipo => ({
                    id:
                        equipo.id,

                    formulario_id:
                        equipo.formulario_id,

                    nombre:
                        equipo.nombre ??
                        null,

                    escudo:
                        equipo.escudo ??
                        null,

                    capitan_id:
                        equipo.capitan_id ??
                        null,

                    plaza_estado:
                        equipo.plaza_estado ??
                        null,

                    posicion_lista_espera:
                        equipo.posicion_lista_espera ??
                        null,
                }),
            );
    }

    // ========================================================
    // VOLUNTARIOS
    // ========================================================

    const idsFormulariosVoluntario =
        formularios
            .filter(
                formulario =>
                    formulario.tipo ===
                    "VOLUNTARIO",
            )
            .map(
                formulario =>
                    formulario.id,
            );

    if (
        idsFormulariosVoluntario.length >
        0
    ) {
        const {
            data:
                voluntariosData,

            error:
                errorVoluntarios,
        } =
            await supabaseAdmin
                .from(
                    "voluntarios",
                )
                .select(
                    "id,formulario_id,nombre,apellido1,apellido2,email,curso,grupo,tipo_voluntariado_id,tipo_voluntariado,descripcion,validacion_estado,plaza_estado,posicion_lista_espera,created_at,updated_at",
                )
                .in(
                    "formulario_id",
                    idsFormulariosVoluntario,
                );

        if (
            errorVoluntarios
        ) {
            console.error(
                "Error carregant les sol·licituds de voluntariat:",
                errorVoluntarios,
            );
        }

        voluntarios =
            (
                voluntariosData ??
                []
            ).map(
                voluntario => ({
                    id:
                        voluntario.id,

                    formulario_id:
                        voluntario.formulario_id,

                    nombre:
                        voluntario.nombre ??
                        null,

                    apellido1:
                        voluntario.apellido1 ??
                        null,

                    apellido2:
                        voluntario.apellido2 ??
                        null,

                    email:
                        voluntario.email ??
                        null,

                    curso:
                        voluntario.curso ??
                        null,

                    grupo:
                        voluntario.grupo ??
                        null,

                    tipo_voluntariado_id:
                        voluntario.tipo_voluntariado_id ??
                        null,

                    tipo_voluntariado:
                        voluntario.tipo_voluntariado ??
                        null,

                    descripcion:
                        voluntario.descripcion ??
                        null,

                    validacion_estado:
                        voluntario.validacion_estado ??
                        null,

                    plaza_estado:
                        voluntario.plaza_estado ??
                        null,

                    posicion_lista_espera:
                        voluntario.posicion_lista_espera ??
                        null,

                    created_at:
                        voluntario.created_at ??
                        null,

                    updated_at:
                        voluntario.updated_at ??
                        null,
                }),
            );
    }

    // ========================================================
    // EDICIONES
    // ========================================================

    const idsEdiciones = [
        ...new Set(
            formularios
                .map(
                    formulario =>
                        formulario.edicion_id,
                )
                .filter(
                    Boolean,
                ),
        ),
    ];

    if (
        idsEdiciones.length >
        0
    ) {
        const {
            data:
                edicionesData,

            error:
                errorEdiciones,
        } =
            await supabaseAdmin
                .from(
                    "ediciones",
                )
                .select(
                    "id,torneo_id,nombre,estado,sede,fecha_inicio,fecha_fin",
                )
                .in(
                    "id",
                    idsEdiciones,
                );

        if (
            errorEdiciones
        ) {
            console.error(
                "Error carregant les edicions:",
                errorEdiciones,
            );
        }

        ediciones =
            (
                edicionesData ??
                []
            ).map(
                edicion => ({
                    id:
                        edicion.id,

                    torneo_id:
                        edicion.torneo_id,

                    nombre:
                        edicion.nombre ??
                        "Edició",

                    estado:
                        edicion.estado ??
                        "",

                    sede:
                        edicion.sede ??
                        null,

                    fecha_inicio:
                        edicion.fecha_inicio ??
                        null,

                    fecha_fin:
                        edicion.fecha_fin ??
                        null,
                }),
            );
    }

    // ========================================================
    // TORNEOS
    // ========================================================

    const idsTorneos = [
        ...new Set(
            ediciones
                .map(
                    edicion =>
                        edicion.torneo_id,
                )
                .filter(
                    Boolean,
                ),
        ),
    ];

    if (
        idsTorneos.length >
        0
    ) {
        const {
            data:
                torneosData,

            error:
                errorTorneos,
        } =
            await supabaseAdmin
                .from(
                    "torneos",
                )
                .select(
                    "id,nombre,deporte,logo,banner",
                )
                .in(
                    "id",
                    idsTorneos,
                );

        if (
            errorTorneos
        ) {
            console.error(
                "Error carregant els tornejos:",
                errorTorneos,
            );
        }

        torneos =
            (
                torneosData ??
                []
            ).map(
                torneo => ({
                    id:
                        torneo.id,

                    nombre:
                        torneo.nombre ??
                        "Torneig",

                    deporte:
                        torneo.deporte ??
                        null,

                    logo:
                        torneo.logo ??
                        null,

                    banner:
                        torneo.banner ??
                        null,
                }),
            );
    }
}

// ============================================================
// RELACIONES
// ============================================================

const equipoPorFormulario =
    new Map(
        equipos.map(
            equipo => [
                equipo.formulario_id,
                equipo,
            ],
        ),
    );

const voluntarioPorFormulario =
    new Map(
        voluntarios.map(
            voluntario => [
                voluntario.formulario_id,
                voluntario,
            ],
        ),
    );

const edicionPorID =
    new Map(
        ediciones.map(
            edicion => [
                edicion.id,
                edicion,
            ],
        ),
    );

const torneoPorID =
    new Map(
        torneos.map(
            torneo => [
                torneo.id,
                torneo,
            ],
        ),
    );

const inscripciones:
    InscripcionPerfil[] =
    formularios
        .map(
            formulario => {
                const equipo =
                    formulario.tipo ===
                    "EQUIPO"
                        ? equipoPorFormulario.get(
                              formulario.id,
                          ) ??
                          null
                        : null;

                const voluntario =
                    formulario.tipo ===
                    "VOLUNTARIO"
                        ? voluntarioPorFormulario.get(
                              formulario.id,
                          ) ??
                          null
                        : null;

                const edicion =
                    edicionPorID.get(
                        formulario.edicion_id,
                    ) ??
                    null;

                const torneo =
                    edicion
                        ? torneoPorID.get(
                              edicion.torneo_id,
                          ) ??
                          null
                        : null;

                return {
                    formulario,
                    equipo,
                    voluntario,
                    edicion,
                    torneo,
                };
            },
        )
        .sort(
            (
                a,
                b,
            ) =>
                tiempo(
                    fechaActividad(
                        b.formulario,
                    ),
                ) -
                tiempo(
                    fechaActividad(
                        a.formulario,
                    ),
                ),
        );

// ============================================================
// FILTRO POR TIPO
// ============================================================

const tiposPermitidos =
    new Set([
        "totes",
        "equips",
        "voluntariat",
    ]);

const parametroTipo =
    Astro.url.searchParams.get(
        "tipus",
    ) ??
    "totes";

const filtroTipo =
    tiposPermitidos.has(
        parametroTipo,
    )
        ? parametroTipo
        : "totes";

const inscripcionesPorTipo =
    inscripciones.filter(
        inscripcion => {
            if (
                filtroTipo ===
                "totes"
            ) {
                return true;
            }

            if (
                filtroTipo ===
                "equips"
            ) {
                return (
                    inscripcion.formulario.tipo ===
                    "EQUIPO"
                );
            }

            return (
                inscripcion.formulario.tipo ===
                "VOLUNTARIO"
            );
        },
    );

// ============================================================
// FILTRO POR ESTADO
// ============================================================

const estadosPermitidos =
    new Set([
        "totes",
        "esborrany",
        "revisio",
        "aprovades",
        "canvis",
    ]);

const parametroEstado =
    Astro.url.searchParams.get(
        "estat",
    ) ??
    "totes";

const filtroEstado =
    estadosPermitidos.has(
        parametroEstado,
    )
        ? parametroEstado
        : "totes";

const inscripcionesFiltradas =
    inscripcionesPorTipo.filter(
        inscripcion => {
            if (
                filtroEstado ===
                "totes"
            ) {
                return true;
            }

            const estado =
                estadoEfectivo(
                    inscripcion,
                );

            if (
                filtroEstado ===
                "esborrany"
            ) {
                return (
                    estado ===
                    "BORRADOR"
                );
            }

            if (
                filtroEstado ===
                "revisio"
            ) {
                return (
                    estado ===
                    "EN_REVISION"
                );
            }

            if (
                filtroEstado ===
                "aprovades"
            ) {
                return (
                    estado ===
                    "APROBADO"
                );
            }

            return (
                estado ===
                "DENEGADO"
            );
        },
    );

// ============================================================
// CONTADORES
// ============================================================

const total =
    inscripciones.length;

const totalEquipos =
    inscripciones.filter(
        inscripcion =>
            inscripcion.formulario.tipo ===
            "EQUIPO",
    ).length;

const totalVoluntariado =
    inscripciones.filter(
        inscripcion =>
            inscripcion.formulario.tipo ===
            "VOLUNTARIO",
    ).length;

const totalTipoActual =
    inscripcionesPorTipo.length;

const totalBorradores =
    inscripcionesPorTipo.filter(
        inscripcion =>
            estadoEfectivo(
                inscripcion,
            ) ===
            "BORRADOR",
    ).length;

const totalRevision =
    inscripcionesPorTipo.filter(
        inscripcion =>
            estadoEfectivo(
                inscripcion,
            ) ===
            "EN_REVISION",
    ).length;

const totalAprobadas =
    inscripcionesPorTipo.filter(
        inscripcion =>
            estadoEfectivo(
                inscripcion,
            ) ===
            "APROBADO",
    ).length;

const totalCambios =
    inscripcionesPorTipo.filter(
        inscripcion =>
            estadoEfectivo(
                inscripcion,
            ) ===
            "DENEGADO",
    ).length;

const filtrosTipo = [
    {
        id:
            "totes",

        nombre:
            "Totes",

        cantidad:
            total,
    },
    {
        id:
            "equips",

        nombre:
            "Equips",

        cantidad:
            totalEquipos,
    },
    {
        id:
            "voluntariat",

        nombre:
            "Voluntariat",

        cantidad:
            totalVoluntariado,
    },
];

const filtrosEstado = [
    {
        id:
            "totes",

        nombre:
            "Totes",

        cantidad:
            totalTipoActual,
    },
    {
        id:
            "esborrany",

        nombre:
            "Esborranys",

        cantidad:
            totalBorradores,
    },
    {
        id:
            "revisio",

        nombre:
            "En revisió",

        cantidad:
            totalRevision,
    },
    {
        id:
            "aprovades",

        nombre:
            "Aprovades",

        cantidad:
            totalAprobadas,
    },
    {
        id:
            "canvis",

        nombre:
            "No aprovades",

        cantidad:
            totalCambios,
    },
];

// ============================================================
// ENLACES DE FILTRO
// ============================================================

function enlaceFiltros(
    estado: string,
    tipo: string,
) {
    const parametros =
        new URLSearchParams();

    if (
        estado !==
        "totes"
    ) {
        parametros.set(
            "estat",
            estado,
        );
    }

    if (
        tipo !==
        "totes"
    ) {
        parametros.set(
            "tipus",
            tipo,
        );
    }

    const consulta =
        parametros.toString();

    return consulta
        ? `/perfil/inscripcions?${consulta}`
        : "/perfil/inscripcions";
}
