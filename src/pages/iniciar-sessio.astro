---
import LayoutSinMenu from "@layouts/LayoutSinMenu.astro";

import IniciarSessioComponent from "@components/sesion/iniciar-sessio"

const redirectTo = Astro.url.searchParams.get("redirect");
---

<LayoutSinMenu title="Iniciar Sessió">
<div class="w-full min-h-screen relative top-0 left-0 p-4 flex items-center place-content-center overflow-hidden">
    <div class="w-120 h-120 degradado absolute rounded-full  -top-30 -left-30">
        &nbsp;
    </div>
    <div class="w-150 h-150 degradado absolute rounded-full  -bottom-40 -right-40">
        &nbsp;
    </div>


    <div class="max-w-lg w-full h-auto p-4  z-10">
        <div class="flex flex-col items-center gap-y-2 text-center">
            <h1 class=" text-3xl font-bold">Benvingut de nou</h1>
            <p>Inicia sessió per continuar amb la teva experiència esportiva a l'institut.</p>
        </div>

        <IniciarSessioComponent redirectTo={redirectTo}  client:load/>
        
    </div>
</div>
</LayoutSinMenu>
