---
import Layout from "@layouts/Layout.astro";
import { supabaseAdmin } from "@utils/supabase";
import { formatearFechaCatalan } from "@utils/formatearFechas";

export const prerender = false;

// ============================================================
// TIPOS
// ============================================================

type TorneoDB = {
    id: string;
    nombre: string | null;
    banner: string | null;
    deporte: string | null;
    descripcion: string | null;
    created_at: string | null;
};

type EdicionDB = {
    id: string;
    torneo_id: string | null;
    nombre: string | null;
    fecha_inicio: string | null;
    fecha_fin: string | null;
    estado: string | null;
    sede: string | null;
};

type TorneoPublico = {
    id: string;
    nombre: string;
    banner: string;
    deporte: string;
    descripcion: string;

    estado: string;
    estadoClave: string;

    edicion: EdicionDB | null;

    numeroEdiciones: number;
};

// ============================================================
// HELPERS
// ============================================================

function normalizarEstado(
    estado: string | null,
) {
    return (
        estado
            ?.trim()
            .toUpperCase() ??
        ""
    );
}

function esEdicionPublica(
    edicion: EdicionDB,
) {
    const estado =
        normalizarEstado(
            edicion.estado,
        );

    return (
        estado === "ACTIVA" ||
        estado === "FINALIZADA" ||
        estado === "EN_PREPARACIO" ||
        estado === "EN_PREPARACIÓN"
    );
}

function prioridadEstado(
    estado: string,
) {
    if (
        estado === "ACTIVA"
    ) {
        return 0;
    }

    if (
        estado === "EN_PREPARACIO" ||
        estado === "EN_PREPARACIÓN"
    ) {
        return 1;
    }

    if (
        estado === "FINALIZADA"
    ) {
        return 2;
    }

    return 3;
}

function nombreEstado(
    estado: string,
) {
    if (
        estado === "ACTIVA"
    ) {
        return "En curs";
    }

    if (
        estado === "EN_PREPARACIO" ||
        estado === "EN_PREPARACIÓN"
    ) {
        return "Pròximament";
    }

    if (
        estado === "FINALIZADA"
    ) {
        return "Finalitzat";
    }

    return "Disponible";
}

function seleccionarEdicion(
    ediciones: EdicionDB[],
) {
    return (
        [...ediciones]
            .sort(
                (a, b) => {
                    const prioridadA =
                        prioridadEstado(
                            normalizarEstado(
                                a.estado,
                            ),
                        );

                    const prioridadB =
                        prioridadEstado(
                            normalizarEstado(
                                b.estado,
                            ),
                        );

                    if (
                        prioridadA !==
                        prioridadB
                    ) {
                        return (
                            prioridadA -
                            prioridadB
                        );
                    }

                    const fechaA =
                        a.fecha_inicio
                            ? new Date(
                                  a.fecha_inicio,
                              ).getTime()
                            : 0;

                    const fechaB =
                        b.fecha_inicio
                            ? new Date(
                                  b.fecha_inicio,
                              ).getTime()
                            : 0;

                    return (
                        fechaB -
                        fechaA
                    );
                },
            )[0] ??
        null
    );
}

// ============================================================
// CARGAR DATOS
// ============================================================

let errorCarga = false;

const torneosPublicos:
    TorneoPublico[] = [];

try {
    const [
        {
            data: torneos,
            error: errorTorneos,
        },
        {
            data: ediciones,
            error: errorEdiciones,
        },
    ] = await Promise.all([
        supabaseAdmin
            .from("torneos")
            .select(
                "id,nombre,banner,deporte,descripcion,created_at"
            )
            .eq(
                "activo",
                true,
            )
            .order(
                "created_at",
                {
                    ascending: false,
                    nullsFirst: false,
                },
            ),

        supabaseAdmin
            .from("ediciones")
            .select(
                "id,torneo_id,nombre,fecha_inicio,fecha_fin,estado,sede"
            ),
    ]);

    if (
        errorTorneos ||
        errorEdiciones
    ) {
        throw (
            errorTorneos ??
            errorEdiciones
        );
    }

    const edicionesPorTorneo =
        new Map<
            string,
            EdicionDB[]
        >();

    for (
        const edicion
        of (
            ediciones ??
            []
        ) as EdicionDB[]
    ) {
        if (
            !edicion.torneo_id ||
            !esEdicionPublica(
                edicion,
            )
        ) {
            continue;
        }

        if (
            !edicionesPorTorneo.has(
                edicion.torneo_id,
            )
        ) {
            edicionesPorTorneo.set(
                edicion.torneo_id,
                [],
            );
        }

        edicionesPorTorneo
            .get(
                edicion.torneo_id,
            )!
            .push(
                edicion,
            );
    }

    for (
        const torneo
        of (
            torneos ??
            []
        ) as TorneoDB[]
    ) {
        const edicionesTorneo =
            edicionesPorTorneo.get(
                torneo.id,
            ) ??
            [];

        const edicion =
            seleccionarEdicion(
                edicionesTorneo,
            );

        const estadoClave =
            edicion
                ? normalizarEstado(
                      edicion.estado,
                  )
                : "";

        torneosPublicos.push({
            id:
                torneo.id,

            nombre:
                torneo.nombre ??
                "Torneig",

            banner:
                torneo.banner ??
                "",

            deporte:
                torneo.deporte ??
                "",

            descripcion:
                torneo.descripcion ??
                "",

            estado:
                nombreEstado(
                    estadoClave,
                ),

            estadoClave,

            edicion,

            numeroEdiciones:
                edicionesTorneo.length,
        });
    }

    torneosPublicos.sort(
        (a, b) => {
            const estado =
                prioridadEstado(
                    a.estadoClave,
                ) -
                prioridadEstado(
                    b.estadoClave,
                );

            if (estado !== 0) {
                return estado;
            }

            return a.nombre.localeCompare(
                b.nombre,
                "ca",
            );
        },
    );
} catch (error) {
    console.error(
        "Error carregant els tornejos públics:",
        error,
    );

    errorCarga = true;
}

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=60, stale-while-revalidate=300",
);
---

<Layout title="Tornejos">

    <main class="w-full">

        <!-- ==================================================
             HERO
        =================================================== -->

        <section class="border-b border-border bg-card">

            <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">

                <div class="flex max-w-3xl flex-col gap-4">

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 -960 960 960"
                            class="h-7 w-7 fill-current"
                            aria-hidden="true"
                        >
                            <path d="M280-120v-80h160v-124q-49-11-87.5-41.5T296-442q-75-9-125.5-65.5T120-640v-40q0-33 23.5-56.5T200-760h80v-80h400v80h80q33 0 56.5 23.5T840-680v40q0 76-50.5 132.5T664-442q-18 46-56.5 76.5T520-324v124h160v80z" />
                        </svg>

                    </div>

                    <div>

                        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">
                            Competicions
                        </p>

                        <h1 class="mt-2 text-3xl font-bold tracking-tight text-neutral-titulos sm:text-4xl">
                            Tornejos de l'IES Calvià
                        </h1>

                        <p class="mt-4 max-w-2xl text-base leading-7 text-neutral">
                            Consulta les competicions esportives del centre,
                            les edicions actives, informació, dates,
                            inscripcions i normativa.
                        </p>

                    </div>

                </div>

            </div>

        </section>

        <!-- ==================================================
             LISTADO
        =================================================== -->

        <section class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">

            {
                errorCarga ? (

                    <div class="mx-auto max-w-lg rounded-2xl border border-border bg-card p-8 text-center">

                        <p class="text-lg font-semibold text-neutral-titulos">
                            No s'han pogut carregar els tornejos
                        </p>

                        <p class="mt-2 text-sm text-neutral">
                            Torna-ho a provar més tard.
                        </p>

                    </div>

                ) : torneosPublicos.length === 0 ? (

                    <div class="mx-auto max-w-xl rounded-2xl border border-dashed border-border bg-card p-10 text-center">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 -960 960 960"
                            class="mx-auto h-10 w-10 fill-secondary"
                        >
                            <path d="M280-120v-80h160v-124q-49-11-87.5-41.5T296-442q-75-9-125.5-65.5T120-640v-40q0-33 23.5-56.5T200-760h80v-80h400v80h80q33 0 56.5 23.5T840-680v40q0 76-50.5 132.5T664-442q-18 46-56.5 76.5T520-324v124h160v80z" />
                        </svg>

                        <h2 class="mt-4 text-xl font-semibold text-neutral-titulos">
                            No hi ha tornejos disponibles
                        </h2>

                        <p class="mt-2 text-sm text-neutral">
                            Encara no s'ha publicat cap competició.
                        </p>

                    </div>

                ) : (

                    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

                        {
                            torneosPublicos.map(
                                torneo => (

                                    <a
                                        href={`/tornejos/${torneo.id}`}
                                        class="group flex min-h-[430px] flex-col overflow-hidden rounded-2xl border border-border bg-card transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg"
                                    >

                                        <!-- BANNER -->

                                        <div class="relative h-52 w-full overflow-hidden bg-muted/20">

                                            {
                                                torneo.banner ? (

                                                    <img
                                                        src={torneo.banner}
                                                        alt={torneo.nombre}
                                                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                                    />

                                                ) : (

                                                    <div class="flex h-full w-full items-center justify-center bg-primary/5">

                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            viewBox="0 -960 960 960"
                                                            class="h-14 w-14 fill-primary/40"
                                                        >
                                                            <path d="M280-120v-80h160v-124q-49-11-87.5-41.5T296-442q-75-9-125.5-65.5T120-640v-40q0-33 23.5-56.5T200-760h80v-80h400v80h80q33 0 56.5 23.5T840-680v40q0 76-50.5 132.5T664-442q-18 46-56.5 76.5T520-324v124h160v80z" />
                                                        </svg>

                                                    </div>

                                                )
                                            }

                                            <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent">
                                            </div>

                                            <span class="absolute bottom-4 left-4 rounded-full bg-primary px-3 py-1.5 text-xs font-semibold text-white">
                                                {torneo.estado}
                                            </span>

                                        </div>

                                        <!-- INFO -->

                                        <div class="flex flex-1 flex-col p-5">

                                            {
                                                torneo.deporte && (
                                                    <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                                                        {torneo.deporte}
                                                    </p>
                                                )
                                            }

                                            <h2 class="mt-1 text-xl font-semibold text-neutral-titulos">
                                                {torneo.nombre}
                                            </h2>

                                            {
                                                torneo.descripcion && (
                                                    <p class="mt-3 line-clamp-3 text-sm leading-6 text-neutral">
                                                        {torneo.descripcion}
                                                    </p>
                                                )
                                            }

                                            {
                                                torneo.edicion && (

                                                    <div class="mt-5 space-y-2 border-t border-border pt-4 text-sm">

                                                        {
                                                            torneo.edicion.nombre && (
                                                                <p class="font-medium text-neutral-titulos">
                                                                    {torneo.edicion.nombre}
                                                                </p>
                                                            )
                                                        }

                                                        {
                                                            torneo.edicion.fecha_inicio && (
                                                                <div class="flex items-center gap-2 text-neutral">

                                                                    <svg
                                                                        xmlns="http://www.w3.org/2000/svg"
                                                                        viewBox="0 -960 960 960"
                                                                        class="h-4 w-4 shrink-0 fill-primary"
                                                                    >
                                                                        <path d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80z" />
                                                                    </svg>

                                                                    <span>
                                                                        {formatearFechaCatalan(
                                                                            torneo.edicion.fecha_inicio
                                                                        )}
                                                                    </span>

                                                                </div>
                                                            )
                                                        }

                                                        {
                                                            torneo.edicion.sede && (
                                                                <div class="flex items-center gap-2 text-neutral">

                                                                    <svg
                                                                        xmlns="http://www.w3.org/2000/svg"
                                                                        viewBox="0 -960 960 960"
                                                                        class="h-4 w-4 shrink-0 fill-primary"
                                                                    >
                                                                        <path d="M480-80Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880t223.5 89T800-552q0 100-79.5 217.5T480-80m0-400q33 0 56.5-23.5T560-560t-23.5-56.5T480-640t-56.5 23.5T400-560t23.5 56.5T480-480" />
                                                                    </svg>

                                                                    <span class="line-clamp-1">
                                                                        {torneo.edicion.sede}
                                                                    </span>

                                                                </div>
                                                            )
                                                        }

                                                    </div>

                                                )
                                            }

                                            <div class="mt-auto pt-5">

                                                <span class="inline-flex items-center gap-2 font-semibold text-secondary">

                                                    Veure competició

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 -960 960 960"
                                                        class="h-5 w-5 fill-current"
                                                    >
                                                        <path d="m504-480-184-184 56-56 240 240-240 240-56-56z" />
                                                    </svg>

                                                </span>

                                            </div>

                                        </div>

                                    </a>

                                )
                            )
                        }

                    </div>

                )
            }

        </section>

    </main>

</Layout>