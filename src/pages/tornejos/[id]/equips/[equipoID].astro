---
import Layout from "@layouts/Layout.astro";

import EquipDetallClient from "@components/tornejos/equips/EquipDetallClient";

import { supabaseAdmin } from "@utils/supabase";

export const prerender = false;

// ============================================================
// PARÁMETROS
// ============================================================

const torneoID =
  Astro.params.id;

const equipoID =
  Astro.params.equipoID;

if (
  !torneoID ||
  !equipoID
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

// ============================================================
// EQUIPO
// ============================================================

const {
  data:
    equipoData,
  error:
    equipoError,
} =
  await supabaseAdmin
    .from(
      "equipos",
    )
    .select(`
      id,
      formulario_id,
      nombre,
      escudo,
      validacion_estado,
      plaza_estado
    `)
    .eq(
      "id",
      equipoID,
    )
    .eq(
      "validacion_estado",
      "APROBADO",
    )
    .eq(
      "plaza_estado",
      "CONFIRMADA",
    )
    .maybeSingle();

if (
  equipoError
) {
  console.error(
    "Error carregant l'equip públic:",
    equipoError,
  );
}

if (
  equipoError ||
  !equipoData
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

// ============================================================
// FORMULARIO
// ============================================================

const {
  data:
    formularioData,
  error:
    formularioError,
} =
  await supabaseAdmin
    .from(
      "formularios",
    )
    .select(`
      id,
      edicion_id,
      tipo,
      estado
    `)
    .eq(
      "id",
      equipoData.formulario_id,
    )
    .eq(
      "tipo",
      "EQUIPO",
    )
    .eq(
      "estado",
      "APROBADO",
    )
    .maybeSingle();

if (
  formularioError
) {
  console.error(
    "Error comprovant el formulari de l'equip:",
    formularioError,
  );
}

if (
  formularioError ||
  !formularioData
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

const edicionID =
  formularioData.edicion_id;

// ============================================================
// EDICIÓN + TORNEO
// ============================================================

const [
  edicionRespuesta,
  torneoRespuesta,
] =
  await Promise.all([
    supabaseAdmin
      .from(
        "ediciones",
      )
      .select(`
        id,
        torneo_id,
        nombre
      `)
      .eq(
        "id",
        edicionID,
      )
      .eq(
        "torneo_id",
        torneoID,
      )
      .maybeSingle(),

    supabaseAdmin
      .from(
        "torneos",
      )
      .select(`
        id,
        nombre,
        banner,
        deporte,
        descripcion,
        activo
      `)
      .eq(
        "id",
        torneoID,
      )
      .eq(
        "activo",
        true,
      )
      .maybeSingle(),
  ]);

if (
  edicionRespuesta.error
) {
  console.error(
    "Error carregant l'edició de l'equip:",
    edicionRespuesta.error,
  );
}

if (
  torneoRespuesta.error
) {
  console.error(
    "Error carregant el torneig de l'equip:",
    torneoRespuesta.error,
  );
}

if (
  edicionRespuesta.error ||
  torneoRespuesta.error ||
  !edicionRespuesta.data ||
  !torneoRespuesta.data
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

const torneo = {
  nombre:
    torneoRespuesta.data.nombre ??
    "Torneig",

  banner:
    torneoRespuesta.data.banner ??
    "",

  deporte:
    torneoRespuesta.data.deporte ??
    "",
};

const edicion = {
  nombre:
    edicionRespuesta.data.nombre ??
    "Edició",
};

const nombreEquip =
  equipoData.nombre ??
  "Equip";

// ============================================================
// URL VOLVER
// ============================================================

const urlEquips =
  `/tornejos/${encodeURIComponent(
    torneoID,
  )}` +
  `?edicionID=${encodeURIComponent(
    edicionID,
  )}` +
  `&seccio=equips`;

// ============================================================
// SEO
// ============================================================

const titulo =
  `${nombreEquip} · ${torneo.nombre}`;

const descripcion =
  `Consulta la plantilla, els partits i la classificació de ${nombreEquip} a ${edicion.nombre}.`;
---

<Layout
  title={titulo}
  description={descripcion}
>
  <main
    class="min-h-screen bg-background"
  >
    <!-- =================================================
        HERO
    ================================================== -->

    <section
      class="
        relative
        min-h-[58vh]
        w-full
        overflow-hidden
        bg-card
      "
    >
      {
        torneo.banner ? (
          <img
            src={torneo.banner}
            alt=""
            aria-hidden="true"
            class="
              absolute
              inset-0
              h-full
              w-full
              object-cover
            "
          />
        ) : (
          <div
            class="
              absolute
              inset-0
              bg-primary/10
            "
          ></div>
        )
      }

      <div
        class="
          absolute
          inset-0
          bg-black/15
        "
      ></div>

      <div
        class="
          absolute
          inset-0
          bg-linear-to-t
          from-black/95
          via-black/25
          to-transparent
        "
      ></div>

      <div
        class="
          absolute
          inset-x-0
          bottom-0
          h-64
          bg-linear-to-t
          from-black/60
          to-transparent
        "
      ></div>

      <!-- CONTENIDO -->

      <div
        class="
          relative
          mx-auto
          flex
          min-h-[58vh]
          w-full
          max-w-6xl
          flex-col
          justify-end
          px-4
          pb-12
          sm:px-6
          sm:pb-14
          lg:px-8
          lg:pb-16
        "
      >
        <div
          class="
            max-w-4xl
          "
        >
          <!-- DEPORTE -->

          {
            torneo.deporte && (
              <p
                class="
                  mb-3
                  text-sm
                  font-semibold
                  uppercase
                  tracking-[0.2em]
                  text-white/75
                "
              >
                {torneo.deporte}
              </p>
            )
          }

          <!-- TORNEO -->

          <h1
            class="
              text-4xl
              font-bold
              leading-tight
              tracking-tight
              text-white
              sm:text-5xl
              lg:text-6xl
            "
          >
            {torneo.nombre}
          </h1>

          <!-- EDICIÓN -->

          <p
            class="
              mt-3
              text-lg
              font-medium
              text-white/90
              sm:text-xl
            "
          >
            {edicion.nombre}
          </p>

          <!-- EQUIPO -->

          <div
            class="
              mt-7
              flex
              flex-wrap
              items-center
              gap-3
            "
          >
            <span
              class="
                inline-flex
                items-center
                rounded-full
                border
                border-white/20
                bg-black/20
                px-3
                py-1.5
                text-xs
                font-bold
                uppercase
                tracking-[0.12em]
                text-white/90
                backdrop-blur-sm
              "
            >
              Equip
            </span>

            <span
              class="
                text-sm
                font-semibold
                text-white/90
              "
            >
              {nombreEquip}
            </span>
          </div>

          <!-- VOLVER -->

          <div
            class="
              mt-6
            "
          >
            <a
              href={urlEquips}
              class="
                inline-flex
                items-center
                gap-2
                text-sm
                font-semibold
                text-white/80
                transition
                hover:text-white
              "
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="
                  h-4
                  w-4
                "
                aria-hidden="true"
              >
                <path
                  d="m15 18-6-6 6-6"
                ></path>
              </svg>

              Tornar als equips
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================
        EQUIPO
    ================================================== -->

    <EquipDetallClient
      client:load
      torneoID={torneoID}
      edicionID={edicionID}
      equipoID={equipoID}
    />
  </main>
</Layout>