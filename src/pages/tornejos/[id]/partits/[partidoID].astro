---
import Layout from "@layouts/Layout.astro";

import PartitDetallClient from "@components/tornejos/partits/PartitDetallClient";
import ClassificacioPartitClient from "@components/tornejos/partits/ClassificacioPartitClient";

import { supabaseAdmin } from "@utils/supabase";
import InformesPublicosPartido from "@components/tornejos/partits/InformesPublicosPartido";

export const prerender = false;

// ============================================================
// PARÁMETROS
// ============================================================

const torneoID =
  Astro.params.id;

const partidoID =
  Astro.params.partidoID;

if (
  !torneoID ||
  !partidoID
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

// ============================================================
// PARTIDO
// ============================================================

const {
  data: partidoData,
  error: errorPartido,
} =
  await supabaseAdmin
    .from(
      "competicion_partidos",
    )
    .select(`
      id,
      edicion_id,
      grupo_id,
      nombre,
      jornada
    `)
    .eq(
      "id",
      partidoID,
    )
    .maybeSingle();

if (
  errorPartido
) {
  console.error(
    "Error carregant el partit públic:",
    errorPartido,
  );
}

if (
  errorPartido ||
  !partidoData
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

// ============================================================
// TORNEO + EDICIÓN
// ============================================================

const [
  torneoRespuesta,
  edicionRespuesta,
] =
  await Promise.all([
    supabaseAdmin
      .from(
        "torneos",
      )
      .select(`
        id,
        nombre,
        banner,
        deporte,
        descripcion,
        activo
      `)
      .eq(
        "id",
        torneoID,
      )
      .eq(
        "activo",
        true,
      )
      .maybeSingle(),

    supabaseAdmin
      .from(
        "ediciones",
      )
      .select(`
        id,
        torneo_id,
        nombre
      `)
      .eq(
        "id",
        partidoData.edicion_id,
      )
      .eq(
        "torneo_id",
        torneoID,
      )
      .maybeSingle(),
  ]);

if (
  torneoRespuesta.error
) {
  console.error(
    "Error carregant el torneig del partit:",
    torneoRespuesta.error,
  );
}

if (
  edicionRespuesta.error
) {
  console.error(
    "Error comprovant l'edició del partit:",
    edicionRespuesta.error,
  );
}

if (
  torneoRespuesta.error ||
  edicionRespuesta.error ||
  !torneoRespuesta.data ||
  !edicionRespuesta.data
) {
  return new Response(
    null,
    {
      status: 404,
    },
  );
}

// ============================================================
// DATOS
// ============================================================

const torneo = {
  id:
    torneoRespuesta.data.id,

  nombre:
    torneoRespuesta.data.nombre ??
    "Torneig",

  banner:
    torneoRespuesta.data.banner ??
    "",

  deporte:
    torneoRespuesta.data.deporte ??
    "",

  descripcion:
    torneoRespuesta.data.descripcion ??
    "",
};

const edicion = {
  id:
    edicionRespuesta.data.id,

  nombre:
    edicionRespuesta.data.nombre ??
    "",
};

const edicionID =
  edicion.id;

// ============================================================
// EQUIPOS DEL PARTIDO
// ============================================================

const {
  data: plazasData,
  error: errorPlazas,
} =
  await supabaseAdmin
    .from(
      "competicion_plazas",
    )
    .select(`
      lado,
      equipo_origen_id,
      equipo_resuelto_id
    `)
    .eq(
      "edicion_id",
      edicionID,
    )
    .eq(
      "destino_tipo",
      "PARTIDO",
    )
    .eq(
      "partido_id",
      partidoID,
    );

if (
  errorPlazas
) {
  console.error(
    "Error carregant les places del partit:",
    errorPlazas,
  );
}

const plazas =
  plazasData ??
  [];

const plazaLocal =
  plazas.find(
    plaza =>
      plaza.lado ===
      "LOCAL",
  ) ??
  null;

const plazaVisitante =
  plazas.find(
    plaza =>
      plaza.lado ===
      "VISITANTE",
  ) ??
  null;

const localID =
  plazaLocal
    ?.equipo_resuelto_id ??
  plazaLocal
    ?.equipo_origen_id ??
  null;

const visitanteID =
  plazaVisitante
    ?.equipo_resuelto_id ??
  plazaVisitante
    ?.equipo_origen_id ??
  null;

const equipsDestacats =
  [
    localID,
    visitanteID,
  ].filter(
    (
      equipoID,
    ): equipoID is string =>
      Boolean(
        equipoID,
      ),
  );

// ============================================================
// HERO
// ============================================================

const nombrePartido =
  partidoData.nombre
    ?.trim() ||
  (
    partidoData.jornada !==
    null
      ? `Jornada ${partidoData.jornada}`
      : "Partit"
  );

const urlTorneo =
  `/tornejos/${encodeURIComponent(
    torneoID,
  )}?edicionID=${encodeURIComponent(
    edicionID,
  )}&seccio=competicio`;

// ============================================================
// SEO
// ============================================================

const titulo =
  `${nombrePartido} · ${torneo.nombre}`;

const descripcion =
  `Consulta el resultat i el desenvolupament del partit de ${edicion.nombre} del torneig ${torneo.nombre}.`;
---

<Layout
  title={titulo}
  description={descripcion}
>
  <main
    class="min-h-screen bg-background"
  >
    <!-- =================================================
        HERO
    ================================================== -->

    <section
      class="
        relative
        min-h-[62vh]
        w-full
        overflow-hidden
        bg-card
      "
    >
      {
        torneo.banner ? (
          <img
            src={torneo.banner}
            alt=""
            aria-hidden="true"
            class="
              absolute
              inset-0
              h-full
              w-full
              object-cover
            "
          />
        ) : (
          <div
            class="
              absolute
              inset-0
              bg-primary/10
            "
          ></div>
        )
      }

      <div
        class="
          absolute
          inset-0
          bg-black/15
        "
      ></div>

      <div
        class="
          absolute
          inset-0
          bg-linear-to-t
          from-black/95
          via-black/25
          to-transparent
        "
      ></div>

      <div
        class="
          absolute
          inset-x-0
          bottom-0
          h-64
          bg-linear-to-t
          from-black/60
          to-transparent
        "
      ></div>

      <div
        class="
          relative
          mx-auto
          flex
          min-h-[62vh]
          w-full
          max-w-6xl
          flex-col
          justify-end
          px-4
          pb-12
          sm:px-6
          sm:pb-14
          lg:px-8
          lg:pb-16
        "
      >
        <div
          class="
            max-w-4xl
          "
        >
          {
            torneo.deporte && (
              <p
                class="
                  mb-3
                  text-sm
                  font-semibold
                  uppercase
                  tracking-[0.2em]
                  text-white/75
                "
              >
                {torneo.deporte}
              </p>
            )
          }

          <h1
            class="
              text-4xl
              font-bold
              leading-tight
              tracking-tight
              text-white
              sm:text-5xl
              lg:text-6xl
            "
          >
            {torneo.nombre}
          </h1>

          {
            edicion.nombre && (
              <p
                class="
                  mt-3
                  text-lg
                  font-medium
                  text-white/90
                  sm:text-xl
                "
              >
                {edicion.nombre}
              </p>
            )
          }

          <div
            class="
              mt-7
              flex
              flex-wrap
              items-center
              gap-3
            "
          >
            <span
              class="
                inline-flex
                items-center
                rounded-full
                border
                border-white/20
                bg-black/20
                px-3
                py-1.5
                text-xs
                font-bold
                uppercase
                tracking-[0.12em]
                text-white/90
                backdrop-blur-sm
              "
            >
              Partit
            </span>

            {
              partidoData.jornada !==
                null && (
                <span
                  class="
                    inline-flex
                    items-center
                    rounded-full
                    border
                    border-white/20
                    bg-black/20
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-white/90
                    backdrop-blur-sm
                  "
                >
                  Jornada {
                    partidoData.jornada
                  }
                </span>
              )
            }

            <span
              class="
                text-sm
                font-semibold
                text-white/90
              "
            >
              {nombrePartido}
            </span>
          </div>

          <div
            class="
              mt-6
            "
          >
            <a
              href={urlTorneo}
              class="
                inline-flex
                items-center
                gap-2
                text-sm
                font-semibold
                text-white/80
                transition
                hover:text-white
              "
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="
                  h-4
                  w-4
                "
                aria-hidden="true"
              >
                <path
                  d="m15 18-6-6 6-6"
                ></path>
              </svg>

              Tornar a la competició
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================
        PARTIDO + ACTA
    ================================================== -->

    <PartitDetallClient
      client:load
      torneoID={torneoID}
      edicionID={edicionID}
      partidoID={partidoID}
    />

    <InformesPublicosPartido
      client:load
      torneoID={torneoID}
      edicionID={edicionID}
      partidoID={partidoID}
    />

    <!-- =================================================
        CLASIFICACIÓN DEL GRUPO
    ================================================== -->

    {
      partidoData.grupo_id && (
        <ClassificacioPartitClient
          client:load
          torneoID={torneoID}
          edicionID={edicionID}
          grupoID={partidoData.grupo_id}
          equipsDestacats={equipsDestacats}
        />
      )
    }
  </main>
</Layout>