---
import Layout from "@layouts/Layout.astro";

const ultimaActualizacion = "22 de setembre de 2026";
---

<Layout title="Avís Legal">
    <main class="w-full">

        <!-- ====================================================
             CABECERA
        ===================================================== -->

        <section
            class="
                relative
                overflow-hidden
                border-b
                border-border
                bg-card
            "
        >
            <div
                class="
                    pointer-events-none
                    absolute
                    -right-24
                    -top-24
                    h-80
                    w-80
                    rounded-full
                    bg-primary/10
                    blur-3xl
                "
            >
            </div>

            <div
                class="
                    pointer-events-none
                    absolute
                    -bottom-32
                    left-1/4
                    h-72
                    w-72
                    rounded-full
                    bg-secondary/10
                    blur-3xl
                "
            >
            </div>

            <div
                class="
                    relative
                    mx-auto
                    w-full
                    max-w-6xl
                    px-4
                    py-14
                    sm:px-6
                    sm:py-18
                    lg:px-8
                "
            >
                <div class="max-w-3xl">

                    <div
                        class="
                            mb-5
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-primary/10
                            text-primary
                        "
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 -960 960 960"
                            class="h-7 w-7 fill-current"
                            aria-hidden="true"
                        >
                            <path
                                d="M320-240h320v-80H320zm0-160h320v-80H320zm-80 320q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80zm280-520v-200H240v640h480v-440z"
                            />
                        </svg>
                    </div>

                    <p
                        class="
                            text-sm
                            font-semibold
                            uppercase
                            tracking-[0.18em]
                            text-primary
                        "
                    >
                        Informació legal
                    </p>

                    <h1
                        class="
                            mt-3
                            text-3xl
                            font-bold
                            tracking-tight
                            text-neutral-titulos
                            sm:text-4xl
                        "
                    >
                        Avís Legal
                    </h1>

                    <p
                        class="
                            mt-4
                            max-w-2xl
                            text-base
                            leading-7
                            text-neutral
                        "
                    >
                        Informació relativa al titular, les condicions
                        d'accés i l'ús de la plataforma Esports IES Calvià.
                    </p>

                    <p
                        class="
                            mt-5
                            text-sm
                            text-neutral
                        "
                    >
                        Darrera actualització:
                        <strong class="font-semibold text-neutral-titulos">
                            {ultimaActualizacion}
                        </strong>
                    </p>

                </div>
            </div>
        </section>

        <!-- ====================================================
             CONTENIDO
        ===================================================== -->

        <section
            class="
                mx-auto
                w-full
                max-w-4xl
                px-4
                py-10
                sm:px-6
                sm:py-14
                lg:px-8
            "
        >
            <div
                class="
                    space-y-8
                    rounded-2xl
                    border
                    border-border
                    bg-background
                    p-6
                    sm:p-8
                "
            >

                <!-- 1 -->

                <section>
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        1. Identificació del titular
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            En compliment del que estableix la
                            Llei 34/2002, d'11 de juliol, de serveis
                            de la societat de la informació i de
                            comerç electrònic, s'informa de les
                            dades identificatives del responsable
                            d'aquest lloc web.
                        </p>

                        <div
                            class="
                                mt-5
                                rounded-xl
                                border
                                border-border
                                bg-card
                                p-5
                            "
                        >
                            <dl class="space-y-3">

                                <div>
                                    <dt
                                        class="
                                            font-semibold
                                            text-neutral-titulos
                                        "
                                    >
                                        Titular
                                    </dt>

                                    <dd class="mt-1">
                                        IES Calvià
                                    </dd>
                                </div>

                                <div>
                                    <dt
                                        class="
                                            font-semibold
                                            text-neutral-titulos
                                        "
                                    >
                                        Plataforma
                                    </dt>

                                    <dd class="mt-1">
                                        Esports IES Calvià
                                    </dd>
                                </div>

                                <div>
                                    <dt
                                        class="
                                            font-semibold
                                            text-neutral-titulos
                                        "
                                    >
                                        Codi de centre
                                    </dt>

                                    <dd class="mt-1">
                                        07007899
                                    </dd>
                                </div>

                                <div>
                                    <dt
                                        class="
                                            font-semibold
                                            text-neutral-titulos
                                        "
                                    >
                                        Adreça
                                    </dt>

                                    <dd class="mt-1">
                                        Av. son Pillo, 1,
                                        07180 Galatzó,
                                        Illes Balears
                                    </dd>
                                </div>

                                <div>
                                    <dt
                                        class="
                                            font-semibold
                                            text-neutral-titulos
                                        "
                                    >
                                        Correu electrònic
                                    </dt>

                                    <dd class="mt-1">
                                        <a
                                            href="mailto:voley_tournament@iescalvia.com"
                                            class="
                                                font-medium
                                                text-primary
                                                hover:underline
                                            "
                                        >
                                            voley_tournament@iescalvia.com
                                        </a>
                                    </dd>
                                </div>

                            </dl>
                        </div>
                    </div>
                </section>

                <!-- 2 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        2. Objecte de la plataforma
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Esports IES Calvià és una plataforma
                            destinada a la informació, organització
                            i gestió d'activitats, competicions,
                            tornejos i altres iniciatives esportives
                            vinculades a l'IES Calvià.
                        </p>

                        <p>
                            Entre les seves funcionalitats es poden
                            incloure la consulta d'informació sobre
                            tornejos, edicions, equips, partits i
                            resultats, així com la inscripció en
                            activitats, la gestió de comptes
                            d'usuari i l'accés a eines internes
                            d'organització.
                        </p>
                    </div>
                </section>

                <!-- 3 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        3. Condicions d'accés i ús
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            L'accés a les parts públiques del lloc web
                            és, amb caràcter general, lliure i gratuït.
                            Determinades funcionalitats poden requerir
                            registre, autenticació o permisos específics.
                        </p>

                        <p>
                            La persona usuària es compromet a utilitzar
                            la plataforma de manera responsable, d'acord
                            amb la legislació vigent, les normes del
                            centre i les condicions específiques de cada
                            competició o activitat.
                        </p>

                        <p>
                            No està permès utilitzar la plataforma amb
                            finalitats il·lícites, intentar accedir a
                            informació o funcions sense autorització,
                            alterar el funcionament del servei o
                            suplantar la identitat d'altres persones.
                        </p>
                    </div>
                </section>

                <!-- 4 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        4. Comptes d'usuari
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Quan una funcionalitat requereixi un compte,
                            les dades facilitades han de ser correctes
                            i correspondre a la persona que realitza
                            el registre.
                        </p>

                        <p>
                            Les credencials d'accés són personals.
                            La persona usuària és responsable de
                            preservar-ne la confidencialitat i de
                            comunicar qualsevol ús no autoritzat del
                            seu compte.
                        </p>

                        <p>
                            L'organització podrà limitar, suspendre o
                            revocar l'accés a un compte quan sigui
                            necessari per motius de seguretat,
                            incompliment de les normes de la plataforma,
                            finalització de les funcions assignades o
                            altres causes justificades relacionades amb
                            la correcta gestió del servei.
                        </p>
                    </div>
                </section>

                <!-- 5 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        5. Inscripcions i competicions
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Les inscripcions realitzades a través de
                            la plataforma estan subjectes a les
                            condicions, terminis i requisits establerts
                            per a cada torneig o edició.
                        </p>

                        <p>
                            La inscripció no implica necessàriament
                            l'acceptació definitiva de l'equip o
                            participant. L'organització podrà revisar
                            les dades proporcionades abans de validar
                            la participació.
                        </p>

                        <p>
                            Les normes específiques de cada competició
                            prevaldran en tot allò relacionat amb el
                            desenvolupament esportiu del torneig.
                        </p>
                    </div>
                </section>

                <!-- 6 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        6. Propietat intel·lectual
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Els continguts propis de la plataforma,
                            inclosos textos, dissenys, elements gràfics,
                            logotips, estructura, programari i altres
                            materials, estan protegits per la normativa
                            aplicable en matèria de propietat
                            intel·lectual i industrial.
                        </p>

                        <p>
                            Els logotips, escuts, fotografies o altres
                            materials aportats per equips, participants
                            o tercers continuen pertanyent als seus
                            respectius titulars.
                        </p>

                        <p>
                            La seva presència a la plataforma no implica
                            la cessió dels drets corresponents més enllà
                            de l'ús necessari per a la gestió i
                            presentació de les activitats esportives.
                        </p>
                    </div>
                </section>

                <!-- 7 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        7. Protecció de dades personals
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            El tractament de dades personals realitzat
                            a través de la plataforma es regeix pel
                            Reglament (UE) 2016/679, General de
                            Protecció de Dades, la Llei orgànica
                            3/2018, de protecció de dades personals
                            i garantia dels drets digitals, i la resta
                            de normativa aplicable.
                        </p>

                        <p>
                            La informació detallada sobre categories
                            de dades, finalitats, bases jurídiques,
                            conservació, destinataris i exercici de
                            drets es troba disponible a la
                            <a
                                href="/politica-de-privacitat"
                                class="
                                mx-1
                                    font-medium
                                    text-primary
                                    hover:underline
                                "
                            >
                                Política de Privacitat
                            </a>.
                        </p>
                    </div>
                </section>

                <!-- 8 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        8. Cookies i emmagatzematge local
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            La plataforma pot utilitzar cookies
                            estrictament necessàries per mantenir la
                            sessió de les persones usuàries i mecanismes
                            d'emmagatzematge local del navegador per
                            conservar determinades preferències.
                        </p>

                        <p>
                            Es pot consultar informació detallada a la
                            <a
                                href="/politica-de-cookies"
                                class="
                                    font-medium
                                    text-primary
                                    hover:underline
                                    mx-1
                                "
                            >
                                Política de Cookies
                            </a>.
                        </p>
                    </div>
                </section>

                <!-- 9 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        9. Enllaços externs
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            La plataforma pot incloure enllaços a
                            pàgines web, xarxes socials o serveis
                            gestionats per tercers.
                        </p>

                        <p>
                            L'IES Calvià no controla necessàriament
                            aquests serveis externs i no és responsable
                            dels seus continguts, disponibilitat o
                            polítiques de privacitat.
                        </p>
                    </div>
                </section>

                <!-- 10 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        10. Disponibilitat del servei
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Tot i que es treballa per mantenir la
                            plataforma disponible i segura, no es pot
                            garantir un funcionament ininterromput o
                            completament lliure d'errors.
                        </p>

                        <p>
                            El servei es pot interrompre temporalment
                            per manteniment, actualitzacions,
                            incidències tècniques, motius de seguretat
                            o altres causes justificades.
                        </p>
                    </div>
                </section>

                <!-- 11 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        11. Modificacions
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Aquest avís legal es podrà modificar quan
                            sigui necessari per adaptar-lo a canvis
                            legislatius, tècnics, organitzatius o a
                            noves funcionalitats de la plataforma.
                        </p>

                        <p>
                            La data de la darrera revisió s'indicarà
                            sempre a la part superior d'aquesta pàgina.
                        </p>
                    </div>
                </section>

                <!-- 12 -->

                <section
                    class="
                        border-t
                        border-border
                        pt-8
                    "
                >
                    <h2
                        class="
                            text-xl
                            font-semibold
                            text-neutral-titulos
                        "
                    >
                        12. Contacte
                    </h2>

                    <div
                        class="
                            mt-4
                            space-y-3
                            text-sm
                            leading-7
                            text-neutral
                        "
                    >
                        <p>
                            Per comunicar una incidència o realitzar
                            una consulta relacionada amb aquesta
                            plataforma es pot utilitzar la
                            <a
                                href="/contacte"
                                class="
                                mx-1
                                    font-medium
                                    text-primary
                                    hover:underline
                                "
                            >
                                pàgina de contacte
                            </a>
                            o escriure al centre.
                        </p>

                        <p>
                            Correu general:
                            <a
                                href="mailto:voley_tournament@iescalvia.com"
                                class="
                                    ml-1
                                    font-medium
                                    text-primary
                                    hover:underline
                                "
                            >
                                voley_tournament@iescalvia.com
                            </a>
                        </p>
                    </div>
                </section>

            </div>
        </section>

    </main>
</Layout>