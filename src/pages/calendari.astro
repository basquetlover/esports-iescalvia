---
import Layout from "@layouts/Layout.astro";

import Calendari, {
  type EventoCalendario,
  type TipoEventoCalendario,
  type TorneoCalendario,
} from "@components/calendari/Calendari";

import { supabaseAdmin } from "@utils/supabase";

export const prerender = false;

// ============================================================
// TIPOS
// ============================================================

type Registro = Record<string, unknown>;

type TorneoDB = {
  id: string;
  nombre: string | null;
  deporte: string | null;
  activo: boolean | null;
};

type EdicionDB = {
  id: string;
  torneo_id: string;
  nombre: string | null;
  sede: string | null;
};

type ConfiguracionDB = {
  edicion_id: string;
  equipos: unknown;
  voluntarios: unknown;
};

type PeriodoInscripcion = {
  apertura: string;
  cierre: string;
};

type PartidoDB = {
  id: string;
  edicion_id: string;
  fase_tipo: string;
  codigo: string;
  nombre: string | null;
  jornada: number | null;
  estado: string;
  fecha_hora: string | null;
  pista: string | null;
};

type PlazaPartidoDB = {
  partido_id: string | null;
  lado: string | null;
  equipo_origen_id: string | null;
  equipo_resuelto_id: string | null;
};

type EquipoPartidoDB = {
  id: string;
  nombre: string | null;
};

type ResultadoPartidoDB = {
  partido_id: string;
  marcador_local: number | null;
  marcador_visitante: number | null;
};

// ============================================================
// HELPERS
// ============================================================

function esRegistro(valor: unknown): valor is Registro {
  return valor !== null && typeof valor === "object" && !Array.isArray(valor);
}

function fechaMadridActual(): string {
  const partes = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Madrid",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(new Date());

  const valores = Object.fromEntries(
    partes.map((parte) => [parte.type, parte.value]),
  );

  return `${valores.year}-${valores.month}-${valores.day}`;
}

function normalizarFecha(valor: unknown): string | null {
  if (typeof valor !== "string" || !valor.trim()) {
    return null;
  }

  const texto = valor.trim();

  if (/^\d{4}-\d{2}-\d{2}$/.test(texto)) {
    return texto;
  }

  const fecha = new Date(texto);

  if (Number.isNaN(fecha.getTime())) {
    return null;
  }

  const partes = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Madrid",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(fecha);

  const valores = Object.fromEntries(
    partes.map((parte) => [parte.type, parte.value]),
  );

  return `${valores.year}-${valores.month}-${valores.day}`;
}

function normalizarHora(valor: string): string {
  const fecha = new Date(valor);

  return new Intl.DateTimeFormat("ca-ES", {
    timeZone: "Europe/Madrid",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(fecha);
}

// ============================================================
// INSCRIPCIONES
// ============================================================

function obtenerInscripcion(configuracion: unknown): PeriodoInscripcion | null {
  if (!esRegistro(configuracion)) {
    return null;
  }

  const inscripcion = configuracion.inscripcion;

  if (!esRegistro(inscripcion)) {
    return null;
  }

  const apertura = normalizarFecha(inscripcion.apertura);
  const cierre = normalizarFecha(inscripcion.cierre);

  if (!apertura || !cierre || cierre < apertura) {
    return null;
  }

  return { apertura, cierre };
}

function estadoInscripcion(
  apertura: string,
  cierre: string,
  hoy: string,
): string {
  if (hoy < apertura) {
    return "Pròximament";
  }

  if (hoy > cierre) {
    return "Tancada";
  }

  return "Inscripció oberta";
}

// ============================================================
// ESTADO PARTIDO
// ============================================================

function nombreEstadoPartido(estado: string): string {
  switch (estado.trim().toUpperCase()) {
    case "PROGRAMADO":
      return "Programat";

    case "EN_CURSO":
      return "En joc";

    case "FINALIZADO":
      return "Finalitzat";

    case "SUSPENDIDO":
      return "Suspès";

    case "CANCELADO":
      return "Cancel·lat";

    default:
      return "Pendent";
  }
}

// ============================================================
// COLORES
// ============================================================

function colorActividad(tipo: TipoEventoCalendario): number {
  switch (tipo) {
    case "inscripcion_equipos":
      return 0;

    case "inscripcion_voluntarios":
      return 1;

    case "partido":
      return 2;
  }
}

// ============================================================
// VALIDACIÓN MES
// ============================================================

function mesValido(valor: string | null): valor is string {
  if (!valor || !/^\d{4}-\d{2}$/.test(valor)) {
    return false;
  }

  const mes = Number(valor.slice(5, 7));

  return mes >= 1 && mes <= 12;
}

// ============================================================
// PARÁMETROS
// ============================================================

const hoy = fechaMadridActual();

const parametroMes = Astro.url.searchParams.get("mes");

const parametroTorneo = Astro.url.searchParams.get("torneo") ?? "";

const mesInicial = mesValido(parametroMes) ? parametroMes : hoy.slice(0, 7);

// ============================================================
// DATOS DB
// ============================================================

let errorCarga = false;

let torneosDB: TorneoDB[] = [];
let edicionesDB: EdicionDB[] = [];
let configuracionesDB: ConfiguracionDB[] = [];

let partidosDB: PartidoDB[] = [];
let plazasPartidosDB: PlazaPartidoDB[] = [];
let equiposPartidosDB: EquipoPartidoDB[] = [];
let resultadosPartidosDB: ResultadoPartidoDB[] = [];

try {
  // ========================================================
  // TORNEOS ACTIVOS
  // ========================================================

  const { data: torneosData, error: errorTorneos } = await supabaseAdmin
    .from("torneos")
    .select("id,nombre,deporte,activo")
    .eq("activo", true)
    .order("nombre", {
      ascending: true,
      nullsFirst: false,
    });

  if (errorTorneos) {
    throw errorTorneos;
  }

  torneosDB = (torneosData ?? []) as TorneoDB[];

  const idsTorneos = torneosDB.map((torneo) => torneo.id);

  // ========================================================
  // EDICIONES
  // ========================================================

  if (idsTorneos.length > 0) {
    const { data: edicionesData, error: errorEdiciones } = await supabaseAdmin
      .from("ediciones")
      .select("id,torneo_id,nombre,sede")
      .in("torneo_id", idsTorneos);

    if (errorEdiciones) {
      throw errorEdiciones;
    }

    edicionesDB = (edicionesData ?? []) as EdicionDB[];
  }

  const idsEdiciones = edicionesDB.map((edicion) => edicion.id);

  if (idsEdiciones.length > 0) {
    // ======================================================
    // CONFIGURACIONES DE INSCRIPCIÓN
    // ======================================================

    const { data: configuracionesData, error: errorConfiguraciones } =
      await supabaseAdmin
        .from("configuracion_ediciones")
        .select("edicion_id,equipos,voluntarios")
        .in("edicion_id", idsEdiciones);

    if (errorConfiguraciones) {
      throw errorConfiguraciones;
    }

    configuracionesDB = (configuracionesData ?? []) as ConfiguracionDB[];

    // ======================================================
    // PARTIDOS PUBLICADOS
    // ======================================================

    const { data: partidosData, error: errorPartidos } = await supabaseAdmin
      .from("competicion_partidos")
      .select(
        `
          id,
          edicion_id,
          fase_tipo,
          codigo,
          nombre,
          jornada,
          estado,
          fecha_hora,
          pista
        `,
      )
      .in("edicion_id", idsEdiciones)
      .eq("publicado", true)
      .not("fecha_hora", "is", null)
      .neq("estado", "BORRADOR")
      .order("fecha_hora", {
        ascending: true,
      });

    if (errorPartidos) {
      throw errorPartidos;
    }

    partidosDB = (partidosData ?? []) as PartidoDB[];

    const idsPartidos = partidosDB.map((partido) => partido.id);

    if (idsPartidos.length > 0) {
      // ====================================================
      // PLAZAS Y RESULTADOS
      // ====================================================

      const [plazasRespuesta, resultadosRespuesta] = await Promise.all([
        supabaseAdmin
          .from("competicion_plazas")
          .select(
            `
              partido_id,
              lado,
              equipo_origen_id,
              equipo_resuelto_id
            `,
          )
          .eq("destino_tipo", "PARTIDO")
          .in("partido_id", idsPartidos)
          .order("orden", {
            ascending: true,
          }),

        supabaseAdmin
          .from("competicion_resultados")
          .select(
            `
              partido_id,
              marcador_local,
              marcador_visitante,
              confirmado_at,
              updated_at
            `,
          )
          .in("partido_id", idsPartidos)
          .eq("confirmado", true)
          .order("confirmado_at", {
            ascending: false,
            nullsFirst: false,
          })
          .order("updated_at", {
            ascending: false,
          }),
      ]);

      if (plazasRespuesta.error) {
        throw plazasRespuesta.error;
      }

      if (resultadosRespuesta.error) {
        throw resultadosRespuesta.error;
      }

      plazasPartidosDB = (plazasRespuesta.data ?? []) as PlazaPartidoDB[];

      resultadosPartidosDB = (resultadosRespuesta.data ??
        []) as ResultadoPartidoDB[];

      // ====================================================
      // EQUIPOS DE LOS PARTIDOS
      // ====================================================

      const idsEquipos = Array.from(
        new Set(
          plazasPartidosDB
            .flatMap((plaza) => [
              plaza.equipo_origen_id,
              plaza.equipo_resuelto_id,
            ])
            .filter(
              (id): id is string => typeof id === "string" && Boolean(id),
            ),
        ),
      );

      if (idsEquipos.length > 0) {
        const { data: equiposData, error: errorEquipos } = await supabaseAdmin
          .from("equipos")
          .select("id,nombre")
          .in("id", idsEquipos);

        if (errorEquipos) {
          throw errorEquipos;
        }

        equiposPartidosDB = (equiposData ?? []) as EquipoPartidoDB[];
      }
    }
  }
} catch (error) {
  console.error("Error carregant el calendari públic:", error);

  errorCarga = true;
}

// ============================================================
// TORNEOS REACT
// ============================================================

const torneos: TorneoCalendario[] = torneosDB.map((torneo) => ({
  id: torneo.id,
  nombre: torneo.nombre?.trim() || "Torneig",
  deporte: torneo.deporte?.trim() || "",
}));

const torneosPorId = new Map(torneos.map((torneo) => [torneo.id, torneo]));

// ============================================================
// MAPAS PARA EVITAR CONSULTAS POR PARTIDO
// ============================================================

const configuracionPorEdicion = new Map(
  configuracionesDB.map((configuracion) => [
    configuracion.edicion_id,
    configuracion,
  ]),
);

const partidosPorEdicion = new Map<string, PartidoDB[]>();

for (const partido of partidosDB) {
  const lista = partidosPorEdicion.get(partido.edicion_id) ?? [];

  lista.push(partido);

  partidosPorEdicion.set(partido.edicion_id, lista);
}

const plazasPorPartido = new Map<string, PlazaPartidoDB[]>();

for (const plaza of plazasPartidosDB) {
  if (!plaza.partido_id) {
    continue;
  }

  const lista = plazasPorPartido.get(plaza.partido_id) ?? [];

  lista.push(plaza);

  plazasPorPartido.set(plaza.partido_id, lista);
}

const equiposPorId = new Map(
  equiposPartidosDB.map((equipo) => [
    equipo.id,
    equipo.nombre?.trim() || "Equip",
  ]),
);

// Resultados confirmados, priorizando el más reciente.

const resultadoPorPartido = new Map<string, ResultadoPartidoDB>();

for (const resultado of resultadosPartidosDB) {
  if (!resultadoPorPartido.has(resultado.partido_id)) {
    resultadoPorPartido.set(resultado.partido_id, resultado);
  }
}

// ============================================================
// EVENTOS
// ============================================================

const eventos: EventoCalendario[] = [];

// ============================================================
// RECORRER EDICIONES
// ============================================================

for (const edicion of edicionesDB) {
  const torneo = torneosPorId.get(edicion.torneo_id);

  if (!torneo) {
    continue;
  }

  const nombreEdicion = edicion.nombre?.trim() || "";

  const nombreCompleto = nombreEdicion
    ? `${torneo.nombre} · ${nombreEdicion}`
    : torneo.nombre;

  const sede = edicion.sede?.trim() || "";

  const enlaceBase =
    `/tornejos/${encodeURIComponent(torneo.id)}` +
    `?edicionID=${encodeURIComponent(edicion.id)}`;

  // ========================================================
  // PARTIDOS DE LA EDICIÓN
  // ========================================================

  const partidosEdicion = partidosPorEdicion.get(edicion.id) ?? [];

  for (const partido of partidosEdicion) {
    if (!partido.fecha_hora) {
      continue;
    }

    const fecha = normalizarFecha(partido.fecha_hora);

    if (!fecha) {
      continue;
    }

    const hora = normalizarHora(partido.fecha_hora);

    const plazas = plazasPorPartido.get(partido.id) ?? [];

    // ======================================================
    // EQUIPO LOCAL / VISITANTE
    // ======================================================

    function obtenerNombreEquipo(lado: "LOCAL" | "VISITANTE"): string {
      const plaza = plazas.find((item) => item.lado === lado);

      const equipoID = plaza?.equipo_resuelto_id ?? plaza?.equipo_origen_id;

      if (!equipoID) {
        return "Per definir";
      }

      return equiposPorId.get(equipoID) ?? "Per definir";
    }

    const local = obtenerNombreEquipo("LOCAL");

    const visitante = obtenerNombreEquipo("VISITANTE");

    const resultado = resultadoPorPartido.get(partido.id);

    const tipo: TipoEventoCalendario = "partido";

    const seccion =
      partido.fase_tipo === "ELIMINATORIA" ? "eliminatoria" : "competicio";

    const nombrePartido = partido.nombre?.trim() || partido.codigo;

    // ======================================================
    // CREAR EVENTO DE PARTIDO
    // ======================================================

    eventos.push({
      id: `partit-${partido.id}`,

      torneoId: torneo.id,
      torneo: torneo.nombre,
      deporte: torneo.deporte,
      edicion: nombreEdicion,

      titulo: `${hora} · ${local} – ${visitante}`,

      tipo,

      fechaInicio: fecha,
      fechaFin: fecha,

      estado: nombreEstadoPartido(partido.estado),

      sede,

      enlace: `${enlaceBase}&seccio=${seccion}`,

      color: colorActividad(tipo),

      hora,
      local,
      visitante,

      jornada: partido.jornada,
      pista: partido.pista?.trim() || "",

      nombrePartido,

      marcadorLocal: resultado?.marcador_local ?? null,
      marcadorVisitante: resultado?.marcador_visitante ?? null,
    });
  }

  // ========================================================
  // CONFIGURACIÓN EDICIÓN
  // ========================================================

  const configuracion = configuracionPorEdicion.get(edicion.id);

  if (!configuracion) {
    continue;
  }

  // ========================================================
  // INSCRIPCIÓN EQUIPOS
  // ========================================================

  const inscripcionEquipos = obtenerInscripcion(configuracion.equipos);

  if (inscripcionEquipos) {
    const tipo: TipoEventoCalendario = "inscripcion_equipos";

    eventos.push({
      id: `inscripcion-equipos-${edicion.id}`,

      torneoId: torneo.id,
      torneo: torneo.nombre,
      deporte: torneo.deporte,
      edicion: nombreEdicion,

      titulo: `Inscripció d'equips · ${nombreCompleto}`,

      tipo,

      fechaInicio: inscripcionEquipos.apertura,
      fechaFin: inscripcionEquipos.cierre,

      estado: estadoInscripcion(
        inscripcionEquipos.apertura,
        inscripcionEquipos.cierre,
        hoy,
      ),

      sede,

      enlace: `${enlaceBase}&seccio=inscripcio`,

      color: colorActividad(tipo),
    });
  }

  // ========================================================
  // INSCRIPCIÓN VOLUNTARIADO
  // ========================================================

  const inscripcionVoluntariado = obtenerInscripcion(configuracion.voluntarios);

  if (inscripcionVoluntariado) {
    const tipo: TipoEventoCalendario = "inscripcion_voluntarios";

    eventos.push({
      id: `inscripcion-voluntariat-${edicion.id}`,

      torneoId: torneo.id,
      torneo: torneo.nombre,
      deporte: torneo.deporte,
      edicion: nombreEdicion,

      titulo: `Inscripció de voluntariat · ${nombreCompleto}`,

      tipo,

      fechaInicio: inscripcionVoluntariado.apertura,
      fechaFin: inscripcionVoluntariado.cierre,

      estado: estadoInscripcion(
        inscripcionVoluntariado.apertura,
        inscripcionVoluntariado.cierre,
        hoy,
      ),

      sede,

      enlace: `${enlaceBase}&seccio=voluntariat`,

      color: colorActividad(tipo),
    });
  }
}

// ============================================================
// ORDENAR EVENTOS
// ============================================================

eventos.sort((a, b) => {
  const fecha = a.fechaInicio.localeCompare(b.fechaInicio);

  if (fecha !== 0) {
    return fecha;
  }

  const prioridad: Record<TipoEventoCalendario, number> = {
    inscripcion_equipos: 0,
    inscripcion_voluntarios: 1,
    partido: 2,
  };

  const diferenciaTipo = prioridad[a.tipo] - prioridad[b.tipo];

  if (diferenciaTipo !== 0) {
    return diferenciaTipo;
  }

  if (a.tipo === "partido" && b.tipo === "partido") {
    const hora = (a.hora ?? "").localeCompare(b.hora ?? "");

    if (hora !== 0) {
      return hora;
    }
  }

  return a.titulo.localeCompare(b.titulo, "ca");
});

// ============================================================
// TORNEO INICIAL
// ============================================================

const torneoInicial =
  parametroTorneo && torneosPorId.has(parametroTorneo) ? parametroTorneo : "";

// ============================================================
// SEO
// ============================================================

const descripcion =
  "Consulta el calendari de partits, horaris, resultats i inscripcions de les competicions esportives d'Esports IES Calvià.";
---

<Layout title="Calendari" description={descripcion}>
  {
    errorCarga ? (
      <main class="min-h-screen bg-background">
        <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
          <div class="rounded-xl border border-error/30 bg-error-container p-6">
            <h1 class="text-xl font-semibold text-error-foreground">
              No s'ha pogut carregar el calendari
            </h1>

            <p class="mt-2 text-sm text-error-foreground/80">
              S'ha produït un error carregant les dades. Torna-ho a provar més
              tard.
            </p>
          </div>
        </section>
      </main>
    ) : (
      <Calendari
        client:load
        torneos={torneos}
        eventos={eventos}
        hoy={hoy}
        mesInicial={mesInicial}
        torneoInicial={torneoInicial}
      />
    )
  }
</Layout>
