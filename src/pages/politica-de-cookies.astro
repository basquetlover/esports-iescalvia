---
import Layout from "@layouts/Layout.astro";

const ultimaActualitzacio = "22 de setembre de 2026";
---

<Layout title="Política de Cookies">
    <main class="w-full">

        <!-- ====================================================
             CABECERA
        ===================================================== -->

        <section
            class="
                relative
                overflow-hidden
                border-b
                border-border
                bg-card
            "
        >
            <div
                class="
                    pointer-events-none
                    absolute
                    -right-24
                    -top-24
                    h-80
                    w-80
                    rounded-full
                    bg-primary/10
                    blur-3xl
                "
            >
            </div>

            <div
                class="
                    pointer-events-none
                    absolute
                    -bottom-32
                    left-1/4
                    h-72
                    w-72
                    rounded-full
                    bg-secondary/10
                    blur-3xl
                "
            >
            </div>

            <div
                class="
                    relative
                    mx-auto
                    w-full
                    max-w-6xl
                    px-4
                    py-14
                    sm:px-6
                    sm:py-18
                    lg:px-8
                "
            >
                <div class="max-w-3xl">

                    <div
                        class="
                            mb-5
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-primary/10
                            text-primary
                        "
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 -960 960 960"
                            class="h-7 w-7 fill-current"
                            aria-hidden="true"
                        >
                            <path
                                d="M480-80q-83 0-156-31.5T197-197t-85.5-127T80-480q0-11 1-20.5t3-19.5q9 15 25.5 24.5T145-486q25 0 42.5-17.5T205-546q0-11-4-22t-12-20q-2-7-3-14t-1-14q0-34 23-57t57-23q5 0 10.5.5T286-694q9-36 39-61t69-25q19 0 36 7t30 19q7-48 44.5-81t87.5-33q14 0 27.5 3t25.5 9q-2 8-3 16t-1 16q0 50 35 85t85 35q21 0 40-7t34-20q8 22 11.5 45t3.5 47q0 116-57.5 213T623-173q-68 51-143 72T480-80Zm-60-200q17 0 28.5-11.5T460-320t-11.5-28.5T420-360t-28.5 11.5T380-320t11.5 28.5T420-280Zm140-120q25 0 42.5-17.5T620-460t-17.5-42.5T560-520t-42.5 17.5T500-460t17.5 42.5T560-400ZM360-480q33 0 56.5-23.5T440-560t-23.5-56.5T360-640t-56.5 23.5T280-560t23.5 56.5T360-480Z"
                            />
                        </svg>
                    </div>

                    <p
                        class="
                            text-sm
                            font-semibold
                            uppercase
                            tracking-[0.18em]
                            text-primary
                        "
                    >
                        Informació legal
                    </p>

                    <h1
                        class="
                            mt-3
                            text-3xl
                            font-bold
                            tracking-tight
                            text-neutral-titulos
                            sm:text-4xl
                        "
                    >
                        Política de Cookies
                    </h1>

                    <p
                        class="
                            mt-4
                            max-w-2xl
                            text-base
                            leading-7
                            text-neutral
                        "
                    >
                        Informació sobre les cookies i altres
                        mecanismes d'emmagatzematge utilitzats
                        a Esports IES Calvià.
                    </p>

                    <p class="mt-5 text-sm text-neutral">
                        Darrera actualització:
                        <strong class="font-semibold text-neutral-titulos">
                            {ultimaActualitzacio}
                        </strong>
                    </p>

                </div>
            </div>
        </section>

        <!-- ====================================================
             CONTENIDO
        ===================================================== -->

        <section
            class="
                mx-auto
                w-full
                max-w-4xl
                px-4
                py-10
                sm:px-6
                sm:py-14
                lg:px-8
            "
        >
            <div
                class="
                    space-y-8
                    rounded-2xl
                    border
                    border-border
                    bg-background
                    p-6
                    sm:p-8
                "
            >

                <!-- ====================================================
                     1. QUÉ SON
                ===================================================== -->

                <section>
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        1. Què són les cookies?
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            Les cookies són petits fitxers que un lloc
                            web pot emmagatzemar al navegador o
                            dispositiu de la persona usuària quan
                            visita una pàgina.
                        </p>

                        <p>
                            Poden tenir diferents finalitats, com ara
                            permetre el funcionament d'una sessió,
                            recordar preferències o obtenir informació
                            sobre l'ús d'un servei.
                        </p>

                        <p>
                            Esports IES Calvià utilitza únicament els
                            mecanismes necessaris per al funcionament
                            actual de la plataforma i per conservar
                            determinades preferències de l'usuari.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     2. TIPOS
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        2. Quins tipus de cookies utilitzam?
                    </h2>

                    <div class="mt-4 space-y-4 text-sm leading-7 text-neutral">

                        <div
                            class="
                                rounded-xl
                                border
                                border-border
                                bg-card
                                p-5
                            "
                        >
                            <div
                                class="
                                    flex
                                    items-start
                                    gap-4
                                "
                            >
                                <div
                                    class="
                                        flex
                                        h-10
                                        w-10
                                        shrink-0
                                        items-center
                                        justify-center
                                        rounded-lg
                                        bg-primary/10
                                        text-primary
                                    "
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 -960 960 960"
                                        class="h-5 w-5 fill-current"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920t141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80H240Zm240-200q33 0 56.5-23.5T560-360t-23.5-56.5T480-440t-56.5 23.5T400-360t23.5 56.5T480-280ZM360-640h240v-80q0-50-35-85t-85-35-85 35-35 85v80Z"
                                        />
                                    </svg>
                                </div>

                                <div>
                                    <h3 class="font-semibold text-neutral-titulos">
                                        Cookies tècniques o necessàries
                                    </h3>

                                    <p class="mt-2">
                                        Són les necessàries perquè
                                        determinades funcionalitats
                                        de la plataforma puguin
                                        funcionar correctament.
                                    </p>

                                    <p class="mt-2">
                                        Entre altres usos, permeten
                                        mantenir una sessió iniciada
                                        després que una persona s'hagi
                                        identificat correctament.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <p>
                            Aquest tipus de cookies no s'utilitza amb
                            finalitats publicitàries ni per crear
                            perfils comercials de les persones usuàries.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     3. COOKIE SESIÓN
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        3. Cookie de sessió utilitzada
                    </h2>

                    <div class="mt-4 space-y-4 text-sm leading-7 text-neutral">

                        <p>
                            Quan una persona inicia sessió a Esports
                            IES Calvià, la plataforma crea una cookie
                            tècnica per poder identificar la sessió
                            en les peticions posteriors.
                        </p>

                        <div class="overflow-hidden rounded-xl border border-border">

                            <div class="overflow-x-auto">
                                <table class="w-full min-w-160 text-left text-sm">

                                    <thead class="bg-card">
                                        <tr>
                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Cookie
                                            </th>

                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Finalitat
                                            </th>

                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Durada
                                            </th>

                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Tipus
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr class="border-t border-border">

                                            <td
                                                class="
                                                    px-4
                                                    py-4
                                                    font-mono
                                                    text-xs
                                                    font-semibold
                                                    text-primary
                                                "
                                            >
                                                token_sesion
                                            </td>

                                            <td class="px-4 py-4">
                                                Mantenir identificada
                                                la sessió de l'usuari
                                                i permetre l'accés a
                                                les àrees autoritzades
                                                de la plataforma.
                                            </td>

                                            <td class="px-4 py-4">
                                                Fins a 30 dies
                                            </td>

                                            <td class="px-4 py-4">
                                                Tècnica i necessària
                                            </td>

                                        </tr>
                                    </tbody>

                                </table>
                            </div>

                        </div>

                        <p>
                            La durada màxima configurada és de 30 dies.
                            No obstant això, la sessió es pot tancar,
                            revocar o invalidar abans d'arribar a
                            aquesta data.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     4. SEGURIDAD COOKIE
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        4. Mesures de seguretat de la cookie de sessió
                    </h2>

                    <div class="mt-4 space-y-4 text-sm leading-7 text-neutral">

                        <p>
                            La cookie de sessió incorpora diverses
                            mesures destinades a reduir el risc
                            d'accés indegut.
                        </p>

                        <div class="grid gap-4 sm:grid-cols-2">

                            <div
                                class="
                                    rounded-xl
                                    border
                                    border-border
                                    bg-card
                                    p-5
                                "
                            >
                                <h3 class="font-semibold text-neutral-titulos">
                                    HttpOnly
                                </h3>

                                <p class="mt-2">
                                    La cookie no és accessible
                                    directament mitjançant JavaScript
                                    executat al navegador.
                                </p>
                            </div>

                            <div
                                class="
                                    rounded-xl
                                    border
                                    border-border
                                    bg-card
                                    p-5
                                "
                            >
                                <h3 class="font-semibold text-neutral-titulos">
                                    SameSite Strict
                                </h3>

                                <p class="mt-2">
                                    El navegador limita l'enviament
                                    de la cookie en peticions
                                    procedents d'altres llocs web.
                                </p>
                            </div>

                            <div
                                class="
                                    rounded-xl
                                    border
                                    border-border
                                    bg-card
                                    p-5
                                "
                            >
                                <h3 class="font-semibold text-neutral-titulos">
                                    Secure
                                </h3>

                                <p class="mt-2">
                                    En l'entorn de producció, la cookie
                                    està configurada perquè només es
                                    transmeti mitjançant connexions
                                    segures HTTPS.
                                </p>
                            </div>

                            <div
                                class="
                                    rounded-xl
                                    border
                                    border-border
                                    bg-card
                                    p-5
                                "
                            >
                                <h3 class="font-semibold text-neutral-titulos">
                                    Caducitat
                                </h3>

                                <p class="mt-2">
                                    La sessió té una data de caducitat
                                    definida i també pot ser revocada
                                    pel sistema abans d'aquesta data.
                                </p>
                            </div>

                        </div>

                    </div>
                </section>

                <!-- ====================================================
                     5. LOCAL STORAGE
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        5. Emmagatzematge local del navegador
                    </h2>

                    <div class="mt-4 space-y-4 text-sm leading-7 text-neutral">

                        <p>
                            A més de les cookies, la plataforma pot
                            utilitzar l'emmagatzematge local del
                            navegador
                            (<code
                                class="
                                    rounded
                                    bg-card
                                    px-1.5
                                    py-0.5
                                    font-mono
                                    text-xs
                                    text-primary
                                "
                            >localStorage</code>)
                            per conservar determinades preferències.
                        </p>

                        <div class="overflow-hidden rounded-xl border border-border">

                            <div class="overflow-x-auto">
                                <table class="w-full min-w-150 text-left text-sm">

                                    <thead class="bg-card">
                                        <tr>

                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Element
                                            </th>

                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Finalitat
                                            </th>

                                            <th
                                                class="
                                                    px-4
                                                    py-3
                                                    font-semibold
                                                    text-neutral-titulos
                                                "
                                            >
                                                Conservació
                                            </th>

                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr class="border-t border-border">

                                            <td
                                                class="
                                                    px-4
                                                    py-4
                                                    font-mono
                                                    text-xs
                                                    font-semibold
                                                    text-primary
                                                "
                                            >
                                                theme
                                            </td>

                                            <td class="px-4 py-4">
                                                Recordar la preferència
                                                de tema visual clar o
                                                fosc seleccionada per
                                                la persona usuària.
                                            </td>

                                            <td class="px-4 py-4">
                                                Fins que l'usuari la
                                                modifica o elimina les
                                                dades del navegador.
                                            </td>

                                        </tr>
                                    </tbody>

                                </table>
                            </div>

                        </div>

                        <p>
                            Aquesta informació queda emmagatzemada
                            localment al dispositiu de la persona
                            usuària i no constitueix una cookie
                            enviada automàticament al servidor en
                            cada petició.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     6. COOKIES TERCEROS
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        6. Cookies de tercers
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            En la configuració actual d'Esports
                            IES Calvià no s'utilitzen cookies
                            publicitàries ni cookies destinades
                            a elaborar perfils comercials de les
                            persones usuàries.
                        </p>

                        <p>
                            Tampoc s'utilitzen actualment cookies
                            pròpies d'eines d'analítica web amb
                            finalitats estadístiques que requereixin
                            el consentiment de l'usuari.
                        </p>

                        <p>
                            La plataforma sí que pot incloure recursos
                            o enllaços de serveis externs. Quan una
                            persona abandona Esports IES Calvià i
                            accedeix a un servei de tercers, aquest
                            servei podrà aplicar la seva pròpia
                            política de cookies i privacitat.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     7. GOOGLE FONTS
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        7. Recursos externs
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            La plataforma pot carregar determinats
                            recursos necessaris per a la presentació
                            del lloc web des de serveis externs.
                        </p>

                        <p>
                            Actualment, el disseny de la plataforma
                            utilitza la família tipogràfica Geist,
                            que es carrega mitjançant Google Fonts.
                        </p>

                        <p>
                            La càrrega de recursos des de serveis
                            externs pot implicar que el navegador
                            estableixi una connexió tècnica amb
                            els servidors del proveïdor corresponent.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     8. CONSENTIMIENTO
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        8. És necessari acceptar les cookies?
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            Les cookies utilitzades actualment per
                            Esports IES Calvià són estrictament
                            necessàries per prestar funcionalitats
                            sol·licitades expressament per la persona
                            usuària, com mantenir una sessió iniciada.
                        </p>

                        <p>
                            Per aquest motiu, aquestes cookies no
                            requereixen un consentiment previ mitjançant
                            un bàner de cookies.
                        </p>

                        <p>
                            Si en el futur s'incorporen cookies
                            analítiques, publicitàries o altres cookies
                            no estrictament necessàries, la plataforma
                            haurà de sol·licitar el consentiment
                            corresponent abans d'instal·lar-les quan
                            així ho exigeixi la normativa.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     9. DESACTIVAR
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        9. Com eliminar o bloquejar les cookies?
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            Els navegadors permeten consultar,
                            eliminar i bloquejar les cookies
                            emmagatzemades.
                        </p>

                        <p>
                            Aquestes opcions solen estar disponibles
                            a la configuració de privacitat o seguretat
                            del navegador utilitzat.
                        </p>

                        <div
                            class="
                                rounded-xl
                                border
                                border-secondary/30
                                bg-secondary/5
                                p-5
                            "
                        >
                            <div class="flex gap-3">

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 -960 960 960"
                                    class="
                                        mt-0.5
                                        h-5
                                        w-5
                                        shrink-0
                                        fill-secondary
                                    "
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M440-280h80v-240h-80zm40-320q17 0 28.5-11.5T520-640t-11.5-28.5T480-680t-28.5 11.5T440-640t11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197t-85.5-127T80-480t31.5-156T197-763t127-85.5T480-880t156 31.5T763-763t85.5 127T880-480t-31.5 156T763-197t-127 85.5T480-80Z"
                                    />
                                </svg>

                                <div>
                                    <h3
                                        class="
                                            font-semibold
                                            text-neutral-titulos
                                        "
                                    >
                                        Important
                                    </h3>

                                    <p class="mt-1">
                                        Bloquejar o eliminar la cookie
                                        <code
                                            class="
                                                mx-1
                                                rounded
                                                bg-background
                                                px-1.5
                                                py-0.5
                                                font-mono
                                                text-xs
                                            "
                                        >token_sesion</code>
                                        impedirà mantenir iniciada la
                                        sessió i pot limitar l'accés a
                                        les funcionalitats que requereixen
                                        autenticació.
                                    </p>
                                </div>

                            </div>
                        </div>

                    </div>
                </section>

                <!-- ====================================================
                     10. LOCALSTORAGE ELIMINAR
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        10. Com eliminar les preferències locals?
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            La informació guardada mitjançant
                            <code
                                class="
                                    rounded
                                    bg-card
                                    px-1.5
                                    py-0.5
                                    font-mono
                                    text-xs
                                    text-primary
                                "
                            >localStorage</code>
                            es pot eliminar mitjançant les opcions
                            del navegador destinades a esborrar
                            dades de llocs web o dades emmagatzemades.
                        </p>

                        <p>
                            L'eliminació de la preferència
                            <code
                                class="
                                    rounded
                                    bg-card
                                    px-1.5
                                    py-0.5
                                    font-mono
                                    text-xs
                                    text-primary
                                "
                            >theme</code>
                            no afecta el compte ni les dades personals
                            de l'usuari. Únicament farà que la
                            plataforma torni a determinar el tema
                            visual segons la configuració disponible
                            al navegador.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     11. CAMBIOS
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        11. Canvis en l'ús de cookies
                    </h2>

                    <div class="mt-4 space-y-3 text-sm leading-7 text-neutral">

                        <p>
                            Esports IES Calvià pot incorporar noves
                            funcionalitats o serveis en el futur.
                        </p>

                        <p>
                            Si això implica utilitzar noves cookies
                            o mecanismes d'emmagatzematge, aquesta
                            política s'actualitzarà per reflectir-ne
                            l'ús.
                        </p>

                        <p>
                            Quan sigui necessari obtenir consentiment
                            abans d'utilitzar una determinada cookie,
                            s'implementaran els mecanismes necessaris
                            per permetre que la persona usuària pugui
                            acceptar-la o rebutjar-la.
                        </p>

                    </div>
                </section>

                <!-- ====================================================
                     12. CONTACTO
                ===================================================== -->

                <section class="border-t border-border pt-8">
                    <h2 class="text-xl font-semibold text-neutral-titulos">
                        12. Contacte
                    </h2>

                    <div class="mt-4 space-y-4 text-sm leading-7 text-neutral">

