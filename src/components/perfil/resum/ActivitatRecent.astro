---
export type TipusActivitat =
    | "CREADA"
    | "MODIFICADA"
    | "ENVIADA"
    | "APROBADA"
    | "DENEGADA";

export type ActivitatPerfil = {
    id: string;

    tipo:
        TipusActivitat;

    titulo:
        string;

    descripcion:
        string | null;

    fecha:
        string | null;

    enlace:
        string | null;

    torneo:
        string | null;

    edicion:
        string | null;
};

type Props = {
    actividades:
        ActivitatPerfil[];

    maximo?:
        number;
};

const {
    actividades,
    maximo = 5,
} = Astro.props as Props;

// ============================================================
// ACTIVIDADES VISIBLES
// ============================================================

const visibles =
    actividades
        .filter(
            actividad =>
                actividad &&
                actividad.id,
        )
        .slice(
            0,
            Math.max(
                1,
                maximo,
            ),
        );

// ============================================================
// FECHA
// ============================================================

function formatearFecha(
    valor:
        string | null,
) {
    if (
        !valor
    ) {
        return null;
    }

    const fecha =
        new Date(
            valor,
        );

    if (
        Number.isNaN(
            fecha.getTime(),
        )
    ) {
        return null;
    }

    const ahora =
        new Date();

    const diferencia =
        ahora.getTime() -
        fecha.getTime();

    const minutos =
        Math.floor(
            diferencia /
            60_000,
        );

    const horas =
        Math.floor(
            diferencia /
            3_600_000,
        );

    const dias =
        Math.floor(
            diferencia /
            86_400_000,
        );

    if (
        diferencia >= 0 &&
        minutos <
            1
    ) {
        return "Ara mateix";
    }

    if (
        diferencia >= 0 &&
        minutos <
            60
    ) {
        return `Fa ${minutos} ${minutos === 1 ? "minut" : "minuts"}`;
    }

    if (
        diferencia >= 0 &&
        horas <
            24
    ) {
        return `Fa ${horas} ${horas === 1 ? "hora" : "hores"}`;
    }

    if (
        diferencia >= 0 &&
        dias ===
            1
    ) {
        return "Ahir";
    }

    if (
        diferencia >= 0 &&
        dias <
            7
    ) {
        return `Fa ${dias} dies`;
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            day:
                "numeric",

            month:
                "short",

            year:
                fecha.getFullYear() !==
                ahora.getFullYear()
                    ? "numeric"
                    : undefined,

            hour:
                "2-digit",

            minute:
                "2-digit",

            timeZone:
                "Europe/Madrid",
        },
    ).format(
        fecha,
    );
}

// ============================================================
// CONFIGURACIÓN VISUAL
// ============================================================

function configuracionTipo(
    tipo:
        TipusActivitat,
) {
    if (
        tipo ===
        "CREADA"
    ) {
        return {
            texto:
                "Creada",

            clases:
                "bg-primary/10 text-primary",

            icono:
                '<path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"></path>',
        };
    }

    if (
        tipo ===
        "MODIFICADA"
    ) {
        return {
            texto:
                "Modificada",

            clases:
                "bg-neutral/10 text-neutral",

            icono:
                '<path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-12 26.5-17.5T706-840q17 0 32 6t26 18l52 52q12 11 18 26t6 32q0 17-5.5 31.5T817-648L290-120H120Z"></path>',
        };
    }

    if (
        tipo ===
        "ENVIADA"
    ) {
        return {
            texto:
                "En revisió",

            clases:
                "bg-secondary/10 text-secondary",

            icono:
                '<path d="m120-120 80-280 320-80-320-80-80-280 760 360-760 360Z"></path>',
        };
    }

    if (
        tipo ===
        "APROBADA"
    ) {
        return {
            texto:
                "Aprovada",

            clases:
                "bg-primary/10 text-primary",

            icono:
                '<path d="m382-240-228-228 57-57 171 171 367-367 57 57-424 424Z"></path>',
        };
    }

    return {
        texto:
            "Requereix canvis",

        clases:
            "bg-error/10 text-error",

        icono:
            '<path d="M480-280q17 0 28.5-11.5T520-320q0-17-11.5-28.5T480-360q-17 0-28.5 11.5T440-320q0 17 11.5 28.5T480-280Zm-40-160h80v-240h-80v240Z"></path>',
    };
}
---

<section class="w-full">
    <!-- =====================================================
        CABECERA
    ====================================================== -->

    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                Seguiment
            </p>

            <h2 class="mt-1 text-xl font-bold tracking-tight text-neutral-titulos sm:text-2xl">
                Activitat recent
            </h2>

            <p class="mt-1 text-sm leading-6 text-neutral">
                Últims moviments relacionats amb les teves inscripcions.
            </p>
        </div>

        {
            actividades.length >
                maximo && (
                <a href="/perfil/inscripcions" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition hover:opacity-75">
                    Veure totes

                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="h-4 w-4 fill-current" aria-hidden="true">
                        <path d="m647-440-224 224 57 56 320-320-320-320-57 56 224 224H160v80h487Z"></path>
                    </svg>
                </a>
            )
        }
    </div>

    <!-- =====================================================
        CONTENIDO
    ====================================================== -->

    <div class="overflow-hidden rounded-2xl border border-border bg-card">
        {
            visibles.length >
                0 ? (
                <div class="divide-y divide-border">
                    {
                        visibles.map(
                            actividad => {
                                const configuracion =
                                    configuracionTipo(
                                        actividad.tipo,
                                    );

                                const fecha =
                                    formatearFecha(
                                        actividad.fecha,
                                    );

                                const contenido = (
                                    <div class="flex min-w-0 flex-1 items-start gap-4">
                                        <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${configuracion.clases}`}>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="h-5 w-5 fill-current" aria-hidden="true" set:html={configuracion.icono}></svg>
                                        </span>

                                        <div class="min-w-0 flex-1">
                                            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
                                                <div class="min-w-0">
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <h3 class="font-semibold text-neutral-titulos">
                                                            {actividad.titulo}
                                                        </h3>

                                                        <span class={`rounded-md px-2 py-0.5 text-[10px] font-bold ${configuracion.clases}`}>
                                                            {configuracion.texto}
                                                        </span>
                                                    </div>

                                                    {
                                                        actividad.descripcion && (
                                                            <p class="mt-1 text-sm leading-6 text-neutral">
                                                                {actividad.descripcion}
                                                            </p>
                                                        )
                                                    }
                                                </div>

                                                {
                                                    fecha && (
                                                        <time datetime={actividad.fecha ?? undefined} class="shrink-0 text-xs text-neutral/65">
                                                            {fecha}
                                                        </time>
                                                    )
                                                }
                                            </div>

                                            {
                                                (
                                                    actividad.torneo ||
                                                    actividad.edicion
                                                ) && (
                                                    <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-neutral">
                                                        {
                                                            actividad.torneo && (
                                                                <span class="font-medium text-neutral-titulos">
                                                                    {actividad.torneo}
                                                                </span>
                                                            )
                                                        }

                                                        {
                                                            actividad.torneo &&
                                                            actividad.edicion && (
                                                                <span class="h-1 w-1 rounded-full bg-neutral/40"></span>
                                                            )
                                                        }

                                                        {
                                                            actividad.edicion && (
                                                                <span>
                                                                    {actividad.edicion}
                                                                </span>
                                                            )
                                                        }
                                                    </div>
                                                )
                                            }
                                        </div>
                                    </div>
                                );

                                if (
                                    actividad.enlace
                                ) {
                                    return (
                                        <a href={actividad.enlace} class="group flex items-center gap-4 p-4 transition hover:bg-background/70 sm:p-5">
                                            {contenido}

                                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-neutral/40 transition group-hover:bg-primary/10 group-hover:text-primary">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="h-4 w-4 fill-current" aria-hidden="true">
                                                    <path d="m647-440-224 224 57 56 320-320-320-320-57 56 224 224H160v80h487Z"></path>
                                                </svg>
                                            </span>
                                        </a>
                                    );
                                }

                                return (
                                    <div class="flex items-center gap-4 p-4 sm:p-5">
                                        {contenido}
                                    </div>
                                );
                            },
                        )
                    }
                </div>
            ) : (
                <div class="flex flex-col items-center justify-center px-6 py-12 text-center">
                    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background text-neutral/50">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="h-6 w-6 fill-current" aria-hidden="true">
                            <path d="M480-120q-138 0-240.5-91.5T122-440h82q14 104 92.5 172T480-200q117 0 198.5-81.5T760-480t-81.5-198.5T480-760q-69 0-129 32t-101 88h110v80H120v-240h80v94q51-64 124.5-99T480-840q75 0 140.5 28.5t114 77 77 114T840-480t-28.5 140.5-77 114-114 77T480-120Zm112-192L440-464v-216h80v184l128 128-56 56Z"></path>
                        </svg>
                    </span>

                    <h3 class="mt-4 font-semibold text-neutral-titulos">
                        Encara no hi ha activitat
                    </h3>

                    <p class="mt-1 max-w-md text-sm leading-6 text-neutral">
                        Quan creïs o actualitzis una inscripció, els moviments més recents apareixeran aquí.
                    </p>
                </div>
            )
        }
    </div>
</section>