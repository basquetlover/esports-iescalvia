<script>
    function iniciarContadors() {
        const contadors =
            document.querySelectorAll<HTMLElement>(
                "[data-countdown]"
            );

        contadors.forEach(
            contador => {
                const objectiu =
                    contador.dataset.target;

                if (
                    !objectiu
                ) {
                    return;
                }

                const dataObjectiu =
                    new Date(
                        objectiu
                    ).getTime();

                const dies =
                    contador.querySelector<HTMLElement>(
                        "[data-days]"
                    );

                const hores =
                    contador.querySelector<HTMLElement>(
                        "[data-hours]"
                    );

                const minuts =
                    contador.querySelector<HTMLElement>(
                        "[data-minutes]"
                    );

                const segons =
                    contador.querySelector<HTMLElement>(
                        "[data-seconds]"
                    );

                function actualitzar() {
                    const diferencia =
                        Math.max(
                            0,
                            dataObjectiu -
                                Date.now()
                        );

                    const totalSegons =
                        Math.floor(
                            diferencia /
                                1000
                        );

                    const diesRestants =
                        Math.floor(
                            totalSegons /
                                86400
                        );

                    const horesRestants =
                        Math.floor(
                            (
                                totalSegons %
                                86400
                            ) /
                                3600
                        );

                    const minutsRestants =
                        Math.floor(
                            (
                                totalSegons %
                                3600
                            ) /
                                60
                        );

                    const segonsRestants =
                        totalSegons %
                        60;

                    if (
                        dies
                    ) {
                        dies.textContent =
                            String(
                                diesRestants
                            ).padStart(
                                2,
                                "0"
                            );
                    }

                    if (
                        hores
                    ) {
                        hores.textContent =
                            String(
                                horesRestants
                            ).padStart(
                                2,
                                "0"
                            );
                    }

                    if (
                        minuts
                    ) {
                        minuts.textContent =
                            String(
                                minutsRestants
                            ).padStart(
                                2,
                                "0"
                            );
                    }

                    if (
                        segons
                    ) {
                        segons.textContent =
                            String(
                                segonsRestants
                            ).padStart(
                                2,
                                "0"
                            );
                    }
                }

                actualitzar();

                const intervalo =
                    window.setInterval(
                        () => {
                            actualitzar();

                            if (
                                Date.now() >=
                                dataObjectiu
                            ) {
                                window.clearInterval(
                                    intervalo
                                );

                                window.location.reload();
                            }
                        },
                        1000
                    );
            }
        );
    }

    iniciarContadors();
</script>