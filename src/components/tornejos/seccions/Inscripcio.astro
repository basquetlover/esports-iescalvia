---
type Props = {
    configuracion:
        unknown;

    faq:
        unknown;

    banner:
        string;
};

type EstadoInscripcion =
    | "oberta"
    | "proximament"
    | "tancada"
    | "sense_dates";

type ComportamientoCupo =
    | "permitir"
    | "lista_espera"
    | "bloquear";

type PreguntaFAQ = {
    id:
        string;

    order:
        number;

    pregunta:
        string;

    respuesta:
        string;

    activo:
        boolean;
};

const {
    configuracion,
    faq,
    banner,
} =
    Astro.props as Props;

// ============================================================
// HELPERS
// ============================================================

function esRegistro(
    valor:
        unknown,
): valor is Record<
    string,
    unknown
> {
    return (
        valor !==
            null &&
        typeof valor ===
            "object" &&
        !Array.isArray(
            valor
        )
    );
}

function numeroNullable(
    valor:
        unknown,
): number | null {
    return (
        typeof valor ===
            "number" &&
        Number.isFinite(
            valor
        )
    )
        ? valor
        : null;
}

function numero(
    valor:
        unknown,

    defecto =
        0,
): number {
    return (
        typeof valor ===
            "number" &&
        Number.isFinite(
            valor
        )
    )
        ? valor
        : defecto;
}

function textoNullable(
    valor:
        unknown,
): string | null {
    return typeof valor ===
        "string"
        ? valor
        : null;
}

function fechaValida(
    valor:
        string | null,
) {
    if (
        !valor
    ) {
        return null;
    }

    const fecha =
        new Date(
            valor
        );

    return Number.isNaN(
        fecha.getTime()
    )
        ? null
        : fecha;
}

function fechaVisible(
    valor:
        string | null,
) {
    const fecha =
        fechaValida(
            valor
        );

    if (
        !fecha
    ) {
        return "No definida";
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            dateStyle:
                "long",

            timeStyle:
                "short",

            timeZone:
                "Europe/Madrid",
        }
    ).format(
        fecha
    );
}

function rango(
    minimo:
        number | null,

    maximo:
        number | null,

    singular:
        string,

    plural:
        string,
) {
    if (
        minimo ===
            null &&
        maximo ===
            null
    ) {
        return "No definit";
    }

    if (
        minimo !==
            null &&
        maximo !==
            null
    ) {
        if (
            minimo ===
            maximo
        ) {
            return `${minimo} ${
                minimo ===
                1
                    ? singular
                    : plural
            }`;
        }

        return `${minimo}–${maximo} ${plural}`;
    }

    if (
        minimo !==
        null
    ) {
        return `Mínim ${minimo} ${
            minimo ===
            1
                ? singular
                : plural
        }`;
    }

    return `Màxim ${maximo} ${
        maximo ===
        1
            ? singular
            : plural
    }`;
}

// ============================================================
// CONFIGURACIÓN
// ============================================================

const equipos =
    esRegistro(
        configuracion
    )
        ? configuracion
        : {};

const inscripcion =
    esRegistro(
        equipos.inscripcion
    )
        ? equipos.inscripcion
        : {};

const cupo =
    esRegistro(
        equipos.cupo
    )
        ? equipos.cupo
        : {};

const jugadores =
    esRegistro(
        equipos.jugadores
    )
        ? equipos.jugadores
        : {};

const genero =
    esRegistro(
        equipos.genero
    )
        ? equipos.genero
        : {};

const minimosGenero =
    esRegistro(
        genero.minimos
    )
        ? genero.minimos
        : {};

const profesores =
    esRegistro(
        equipos.profesores
    )
        ? equipos.profesores
        : {};

const entrenador =
    esRegistro(
        equipos.entrenador
    )
        ? equipos.entrenador
        : {};

const staff =
    esRegistro(
        equipos.staff
    )
        ? equipos.staff
        : {};

// ============================================================
// FECHAS
// ============================================================

const apertura =
    textoNullable(
        inscripcion.apertura
    );

const cierre =
    textoNullable(
        inscripcion.cierre
    );

const fechaApertura =
    fechaValida(
        apertura
    );

const fechaCierre =
    fechaValida(
        cierre
    );

const ahora =
    Date.now();

let estado:
    EstadoInscripcion =
    "sense_dates";

if (
    fechaApertura &&
    fechaCierre
) {
    if (
        ahora <
        fechaApertura.getTime()
    ) {
        estado =
            "proximament";
    } else if (
        ahora >
        fechaCierre.getTime()
    ) {
        estado =
            "tancada";
    } else {
        estado =
            "oberta";
    }
}

// ============================================================
// CUPO
// ============================================================

const maximoEquipos =
    numeroNullable(
        cupo.maximo
    );

const comportamiento:
    ComportamientoCupo =
    cupo.al_superar ===
        "lista_espera" ||
    cupo.al_superar ===
        "bloquear"
        ? cupo.al_superar
        : "permitir";

// ============================================================
// JUGADORES
// ============================================================

const minimoJugadores =
    numeroNullable(
        jugadores.minimo
    );

const maximoJugadores =
    numeroNullable(
        jugadores.maximo
    );

const textoJugadores =
    rango(
        minimoJugadores,
        maximoJugadores,
        "jugador",
        "jugadors"
    );

// ============================================================
// GÉNERO
// ============================================================

const generoActivo =
    genero.activo ===
    true;

const minimoMasculino =
    numero(
        minimosGenero.masculino
    );

const minimoFemenino =
    numero(
        minimosGenero.femenino
    );

// ============================================================
// PROFESORADO
// ============================================================

const profesoresPermitidos =
    profesores.permitidos ===
    true;

const profesoresMinimo =
    numero(
        profesores.minimo
    );

const profesoresMaximo =
    numero(
        profesores.maximo
    );

const profesoresCuentan =
    profesores
        .cuentan_como_jugador !==
    false;

const textoProfesores =
    profesoresPermitidos
        ? rango(
              profesoresMinimo,
              profesoresMaximo,
              "professor",
              "professors"
          )
        : "No permès";

// ============================================================
// ENTRENADOR
// ============================================================

const entrenadorPermitido =
    entrenador.permitido ===
    true;

// ============================================================
// STAFF
// ============================================================

const staffPermitido =
    staff.permitido ===
    true;

const staffMinimo =
    numero(
        staff.minimo
    );

const staffMaximo =
    numero(
        staff.maximo
    );

const textoStaff =
    staffPermitido
        ? rango(
              staffMinimo,
              staffMaximo,
              "membre",
              "membres"
          )
        : "No permès";

// ============================================================
// FAQ
// ============================================================

const configuracionFAQ =
    esRegistro(
        faq
    )
        ? faq
        : {};

const preguntasFAQ:
    PreguntaFAQ[] =
    Array.isArray(
        configuracionFAQ.preguntas
    )
        ? configuracionFAQ
              .preguntas
              .filter(
                  esRegistro
              )
              .map(
                  (
                      entrada,
                      indice,
                  ): PreguntaFAQ => ({
                      id:
                          typeof entrada.id ===
                              "string"
                              ? entrada.id
                              : `faq-${indice + 1}`,

                      order:
                          numero(
                              entrada.order,
                              indice + 1
                          ),

                      pregunta:
                          typeof entrada.pregunta ===
                              "string"
                              ? entrada.pregunta.trim()
                              : "",

                      respuesta:
                          typeof entrada.respuesta ===
                              "string"
                              ? entrada.respuesta.trim()
                              : "",

                      activo:
                          entrada.activo ===
                          true,
                  })
              )
              .filter(
                  entrada =>
                      entrada.activo &&
                      Boolean(
                          entrada.pregunta
                      ) &&
                      Boolean(
                          entrada.respuesta
                      )
              )
              .sort(
                  (
                      a,
                      b,
                  ) =>
                      a.order -
                      b.order
              )
        : [];
---

