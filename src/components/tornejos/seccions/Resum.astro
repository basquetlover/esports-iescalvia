---
import { supabaseAdmin } from "@utils/supabase";

// ============================================================
// TIPOS
// ============================================================

type Registro = Record<string, unknown>;

type Torneo = {
    id: string;
    nombre: string;
    banner: string;
    deporte: string;
    descripcion: string;
    normativa_base: string | null;
};

type Edicion = {
    id: string;
    torneo_id: string;
    nombre: string;
    fecha_inicio: string | null;
    fecha_fin: string | null;
    estado: string;
    sede: string;
};

type ConfiguracionEdicion = {
    equipos: unknown;
    voluntarios: unknown;
    informacion: unknown;
    competicion: unknown;
};

type Props = {
    torneo: Torneo;
    edicion: Edicion | null;
    configuracion: ConfiguracionEdicion | null;
};

type Hito = {
    id: string;
    titulo: string;
    descripcion: string;
    fecha: string;
    fechaTexto: string;
    timestamp: number;
    completado: boolean;
    proximo: boolean;
    clasePunto: string;
};

type Metrica = {
    id: string;
    titulo: string;
    valor: string;
    icono: "calendario" | "equipos" | "jugadores" | "ubicacion";
};

type Noticia = {
    id: string;
    titular: string;
    subtitulo: string;
    cover_image: string;
    slug: string;
    publication_date: string;
    categoria: string;
};

// ============================================================
// PROPS
// ============================================================

const {
    torneo,
    edicion,
    configuracion,
} = Astro.props;

// ============================================================
// HELPERS
// ============================================================

function esRegistro(
    valor: unknown,
): valor is Registro {
    return (
        valor !== null &&
        typeof valor === "object" &&
        !Array.isArray(valor)
    );
}

function leerTexto(
    valor: unknown,
): string {
    if (
        typeof valor !== "string"
    ) {
        return "";
    }

    return valor.trim();
}

function leerNumero(
    valor: unknown,
): number | null {
    if (
        typeof valor !== "number" ||
        !Number.isFinite(valor)
    ) {
        return null;
    }

    return valor;
}

function fechaTimestamp(
    valor: string,
): number {
    const fecha =
        new Date(valor);

    const timestamp =
        fecha.getTime();

    if (
        Number.isNaN(
            timestamp,
        )
    ) {
        return 0;
    }

    return timestamp;
}

function formatearFecha(
    valor: string,
): string {
    const fecha =
        new Date(valor);

    if (
        Number.isNaN(
            fecha.getTime(),
        )
    ) {
        return valor;
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            day: "2-digit",
            month: "short",
            year: "numeric",
        },
    ).format(fecha);
}

function formatearFechaHora(
    valor: string,
): string {
    const fecha =
        new Date(valor);

    if (
        Number.isNaN(
            fecha.getTime(),
        )
    ) {
        return valor;
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            day: "2-digit",
            month: "short",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
        },
    ).format(fecha);
}

// ============================================================
// CONFIGURACIÓN EQUIPOS
// ============================================================

const equipos =
    esRegistro(
        configuracion?.equipos,
    )
        ? configuracion.equipos
        : {};

const inscripcion =
    esRegistro(
        equipos.inscripcion,
    )
        ? equipos.inscripcion
        : {};

const cupo =
    esRegistro(
        equipos.cupo,
    )
        ? equipos.cupo
        : {};

const jugadores =
    esRegistro(
        equipos.jugadores,
    )
        ? equipos.jugadores
        : {};

const aperturaInscripcion =
    leerTexto(
        inscripcion.apertura,
    );

const cierreInscripcion =
    leerTexto(
        inscripcion.cierre,
    );

const maximoEquipos =
    leerNumero(
        cupo.maximo,
    );

const minimoJugadores =
    leerNumero(
        jugadores.minimo,
    );

const maximoJugadores =
    leerNumero(
        jugadores.maximo,
    );

// ============================================================
// DURACIÓN
// ============================================================

let duracionTexto =
    "";

if (
    edicion?.fecha_inicio &&
    edicion.fecha_fin
) {
    const inicio =
        fechaTimestamp(
            edicion.fecha_inicio,
        );

    const fin =
        fechaTimestamp(
            edicion.fecha_fin,
        );

    if (
        inicio > 0 &&
        fin > inicio
    ) {
        const dias =
            Math.ceil(
                (
                    fin -
                    inicio
                ) /
                (
                    1000 *
                    60 *
                    60 *
                    24
                ),
            );

        if (
            dias === 1
        ) {
            duracionTexto =
                "1 dia";
        } else if (
            dias < 7
        ) {
            duracionTexto =
                `${dias} dies`;
        } else {
            const semanas =
                Math.ceil(
                    dias / 7,
                );

            duracionTexto =
                semanas === 1
                    ? "1 setmana"
                    : `${semanas} setmanes`;
        }
    }
}

// ============================================================
// MÉTRICAS
// ============================================================

const metricas:
    Metrica[] = [];

if (
    duracionTexto
) {
    metricas.push({
        id:
            "durada",

        titulo:
            "Durada",

        valor:
            duracionTexto,

        icono:
            "calendario",
    });
}

if (
    maximoEquipos !==
    null
) {
    metricas.push({
        id:
            "equips",

        titulo:
            "Màx. equips",

        valor:
            String(
                maximoEquipos,
            ),

        icono:
            "equipos",
    });
}

if (
    minimoJugadores !==
        null ||
    maximoJugadores !==
        null
) {
    let valorJugadores =
        "";

    if (
        minimoJugadores !==
            null &&
        maximoJugadores !==
            null
    ) {
        valorJugadores =
            `${minimoJugadores} - ${maximoJugadores}`;
    } else if (
        minimoJugadores !==
        null
    ) {
        valorJugadores =
            `Mín. ${minimoJugadores}`;
    } else if (
        maximoJugadores !==
        null
    ) {
        valorJugadores =
            `Màx. ${maximoJugadores}`;
    }

    metricas.push({
        id:
            "jugadors",

        titulo:
            "Jugadors/equip",

        valor:
            valorJugadores,

        icono:
            "jugadores",
    });
}

if (
    edicion?.sede
) {
    metricas.push({
        id:
            "seu",

        titulo:
            "Seu",

        valor:
            edicion.sede,

        icono:
            "ubicacion",
    });
}

// ============================================================
// HITOS
// ============================================================

type HitoBase = {
    id: string;
    titulo: string;
    descripcion: string;
    fecha: string;
};

const hitosBase:
    HitoBase[] = [];

if (
    aperturaInscripcion
) {
    hitosBase.push({
        id:
            "obertura-inscripcio",

        titulo:
            "Obertura d'inscripcions",

        descripcion:
            "S'obre el període d'inscripció d'equips.",

        fecha:
            aperturaInscripcion,
    });
}

if (
    cierreInscripcion
) {
    hitosBase.push({
        id:
            "tancament-inscripcio",

        titulo:
            "Tancament d'inscripcions",

        descripcion:
            "Finalitza el període d'inscripció d'equips.",

        fecha:
            cierreInscripcion,
    });
}

if (
    edicion?.fecha_inicio
) {
    hitosBase.push({
        id:
            "inici-competicio",

        titulo:
            "Inici de la competició",

        descripcion:
            "Comença oficialment el torneig.",

        fecha:
            edicion.fecha_inicio,
    });
}

if (
    edicion?.fecha_fin
) {
    hitosBase.push({
        id:
            "final-competicio",

        titulo:
            "Final de la competició",

        descripcion:
            "Finalitza l'edició actual del torneig.",

        fecha:
            edicion.fecha_fin,
    });
}

hitosBase.sort(
    (
        a,
        b,
    ) =>
        fechaTimestamp(
            a.fecha,
        ) -
        fechaTimestamp(
            b.fecha,
        ),
);

const ahora =
    Date.now();

let proximoHitoID:
    string | null =
    null;

for (
    const hito
    of hitosBase
) {
    const timestamp =
        fechaTimestamp(
            hito.fecha,
        );

    if (
        timestamp >
        ahora
    ) {
        proximoHitoID =
            hito.id;

        break;
    }
}

const hitos:
    Hito[] =
    hitosBase.map(
        (hito) => {
            const timestamp =
                fechaTimestamp(
                    hito.fecha,
                );

            const completado =
                timestamp > 0 &&
                timestamp <=
                    ahora;

            const proximo =
                hito.id ===
                proximoHitoID;

            let clasePunto =
                "flex h-7 w-7 items-center justify-center rounded-full border-4 border-card bg-muted";

            if (
                completado
            ) {
                clasePunto =
                    "flex h-7 w-7 items-center justify-center rounded-full border-4 border-card bg-primary";
            } else if (
                proximo
            ) {
                clasePunto =
                    "flex h-7 w-7 items-center justify-center rounded-full border-4 border-card bg-secondary";
            }

            return {
                id:
                    hito.id,

                titulo:
                    hito.titulo,

                descripcion:
                    hito.descripcion,

                fecha:
                    hito.fecha,

                fechaTexto:
                    hito.fecha.includes(
                        "T",
                    )
                        ? formatearFechaHora(
                              hito.fecha,
                          )
                        : formatearFecha(
                              hito.fecha,
                          ),

                timestamp,

                completado,

                proximo,

                clasePunto,
            };
        },
    );

const proximoHito =
    hitos.find(
        (hito) =>
            hito.proximo,
    ) ??
    null;

// ============================================================
// NOTICIAS
// ============================================================

const noticias:
    Noticia[] = [];

try {
    const ahoraISO =
        new Date()
            .toISOString();

    const {
        data,
        error,
    } =
        await supabaseAdmin
            .from(
                "Noticis",
            )
            .select(
                "id,titular,subtitulo,cover_image,slug,publication_date,categoria",
            )
            .eq(
                "torneo_id",
                torneo.id,
            )
            .eq(
                "status",
                "Public",
            )
            .not(
                "publication_date",
                "is",
                null,
            )
            .lte(
                "publication_date",
                ahoraISO,
            )
            .order(
                "publication_date",
                {
                    ascending:
                        false,

                    nullsFirst:
                        false,
                },
            )
            .limit(3);

    if (error) {
        throw error;
    }

    const filas:
        unknown =
        data;

    if (
        Array.isArray(
            filas,
        )
    ) {
        for (
            const fila
            of filas
        ) {
            if (
                !esRegistro(
                    fila,
                )
            ) {
                continue;
            }

            const id =
                leerTexto(
                    fila.id,
                );

            const titular =
                leerTexto(
                    fila.titular,
                );

            const slug =
                leerTexto(
                    fila.slug,
                );

            if (
                !id ||
                !titular ||
                !slug
            ) {
                continue;
            }

            noticias.push({
                id,

                titular,

                subtitulo:
                    leerTexto(
                        fila.subtitulo,
                    ),

                cover_image:
                    leerTexto(
                        fila.cover_image,
                    ),

                slug,

                publication_date:
                    leerTexto(
                        fila.publication_date,
                    ),

                categoria:
                    leerTexto(
                        fila.categoria,
                    ) ||
                    "Actualitat",
            });
        }
    }
} catch (error) {
    console.error(
        "Error carregant les notícies del torneig:",
        error,
    );
}

// ============================================================
// DESTACADOS
// ============================================================

const mostrarDestacados =
    Boolean(
        edicion ||
        proximoHito,
    );
---

<div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- ======================================================
         INFORMACIÓN PRINCIPAL
    ======================================================= -->

    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_280px]">

        <!-- ==================================================
             IZQUIERDA
        =================================================== -->

        <div class="space-y-5">

            <!-- ==============================================
                 SOBRE EL TORNEO
            =============================================== -->

            <section class="rounded-xl border border-border bg-card p-5">

                <p class="text-xs font-semibold text-primary">
                    Sobre el Torneig
                </p>

                {
                    torneo.descripcion ? (

                        <p class="mt-3 text-sm leading-6 text-neutral">
                            {torneo.descripcion}
                        </p>

                    ) : (

                        <p class="mt-3 text-sm leading-6 text-neutral">
                            Consulta la informació principal de la competició.
                        </p>

                    )
                }

                {
                    edicion && (

                        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 border-t border-border pt-4 text-xs">

                            <div>
                                <span class="text-neutral">
                                    Edició:
                                </span>

                                <span class="ml-1 font-semibold text-neutral-titulos">
                                    {edicion.nombre}
                                </span>
                            </div>

                            {
                                edicion.sede && (

                                    <div>
                                        <span class="text-neutral">
                                            Seu:
                                        </span>

                                        <span class="ml-1 font-semibold text-neutral-titulos">
                                            {edicion.sede}
                                        </span>
                                    </div>

                                )
                            }

                        </div>

                    )
                }

            </section>

            <!-- ==============================================
                 LÍNEA TEMPORAL
            =============================================== -->

            {
                hitos.length > 0 && (

                    <section class="rounded-xl border border-border bg-card p-5">

                        <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral">
                            Línia de temps de l'edició
                        </h2>

                        <div class="relative mt-5">

                            <div class="absolute bottom-4 left-[13px] top-4 w-px bg-border">
                            </div>

                            <div>

                                {
                                    hitos.map(
                                        (hito) => (

                                            <div class="relative grid grid-cols-[28px_1fr] gap-3 pb-5 last:pb-0">

                                                <div class="relative z-10">

                                                    <span class={hito.clasePunto}>

                                                        {
                                                            hito.completado && (

                                                                <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    viewBox="0 -960 960 960"
                                                                    class="h-3.5 w-3.5 fill-white"
                                                                >
                                                                    <path d="M382-240 154-468l57-57 171 171 367-367 57 57z" />
                                                                </svg>

                                                            )
                                                        }

                                                    </span>

                                                </div>

                                                <div class="-mt-0.5">

                                                    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">

                                                        <h3 class="text-sm font-semibold text-neutral-titulos">
                                                            {hito.titulo}
                                                        </h3>

                                                        <span class="shrink-0 text-xs text-neutral">
                                                            {hito.fechaTexto}
                                                        </span>

                                                    </div>

                                                    <p class="mt-1 text-xs leading-5 text-neutral">
                                                        {hito.descripcion}
                                                    </p>

                                                    {
                                                        hito.proximo && (

                                                            <span class="mt-2 inline-flex rounded-full bg-secondary/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-secondary">
                                                                Pròxim
                                                            </span>

                                                        )
                                                    }

                                                </div>

                                            </div>

                                        ),
                                    )
                                }

                            </div>

                        </div>

                    </section>

                )
            }

        </div>

        <!-- ==================================================
             DERECHA
        =================================================== -->

        <aside class="space-y-4">

            <!-- ==============================================
                 MÉTRICAS
            =============================================== -->

            {
                metricas.length > 0 && (

                    <div class="grid grid-cols-2 gap-3">

                        {
                            metricas.map(
                                (metrica) => (

                                    <article class="min-h-24 rounded-xl border border-border bg-card p-4">

                                        <div class="flex items-start justify-between gap-2">

                                            <p class="text-xs text-neutral">
                                                {metrica.titulo}
                                            </p>

                                            {
                                                metrica.icono === "calendario" && (

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 -960 960 960"
                                                        class="h-4 w-4 shrink-0 fill-primary"
                                                    >
                                                        <path d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80z" />
                                                    </svg>

                                                )
                                            }

                                            {
                                                metrica.icono === "equipos" && (

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 -960 960 960"
                                                        class="h-4 w-4 shrink-0 fill-primary"
                                                    >
                                                        <path d="M40-160v-112q0-34 17.5-62.5T104-378q62-31 126-46.5T360-440q66 0 130 15.5T616-378q29 15 46.5 43.5T680-272v112zm720 0v-112q0-63-32-111t-95-82q49 6 93.5 20.5T808-408q35 19 53.5 49.5T880-288v128zM360-480q-66 0-113-47t-47-113 47-113 113-47 113 47 47 113-47 113-113 47" />
                                                    </svg>

                                                )
                                            }

                                            {
                                                metrica.icono === "jugadores" && (

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 -960 960 960"
                                                        class="h-4 w-4 shrink-0 fill-primary"
                                                    >
                                                        <path d="M480-480q66 0 113-47t47-113-47-113-113-47-113 47-47 113 47 113 113 47ZM160-160v-112q0-34 17.5-62.5T224-376q62-31 126-47.5T480-440q66 0 130 16.5T736-376q29 14 46.5 42.5T800-272v112z" />
                                                    </svg>

                                                )
                                            }

                                            {
                                                metrica.icono === "ubicacion" && (

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 -960 960 960"
                                                        class="h-4 w-4 shrink-0 fill-primary"
                                                    >
                                                        <path d="M480-80Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880t223.5 89T800-552q0 100-79.5 217.5T480-80" />
                                                    </svg>

                                                )
                                            }

                                        </div>

                                        <p class="mt-3 line-clamp-2 text-lg font-semibold leading-tight text-neutral-titulos">
                                            {metrica.valor}
                                        </p>

                                    </article>

                                ),
                            )
                        }

                    </div>

                )
            }

            <!-- ==============================================
                 DESTACADOS
            =============================================== -->

            {
                mostrarDestacados && (

                    <section class="overflow-hidden rounded-xl border border-primary/30 bg-primary text-white">

                        <div class="flex items-center gap-2 border-b border-white/15 px-4 py-3">

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 -960 960 960"
                                class="h-4 w-4 fill-secondary-variant"
                            >
                                <path d="m480-80-58-52q-101-91-167-157T150-409.5 95.5-513 80-600q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 45-15.5 86.5T810-410 705-289 538-132z" />
                            </svg>

                            <h2 class="text-sm font-semibold">
                                Destacats
                            </h2>

                        </div>

                        <div class="space-y-4 p-4">

                            {
                                edicion?.fecha_inicio && (

                                    <div>

                                        <p class="text-[11px] text-white/60">
                                            Inici de la competició
                                        </p>

                                        <p class="mt-1 text-sm font-semibold">
                                            {
                                                formatearFecha(
                                                    edicion.fecha_inicio,
                                                )
                                            }
                                        </p>

                                    </div>

                                )
                            }

                            {
                                cierreInscripcion && (

                                    <div>

                                        <p class="text-[11px] text-white/60">
                                            Tancament d'inscripcions
                                        </p>

                                        <p class="mt-1 text-sm font-semibold">
                                            {
                                                formatearFechaHora(
                                                    cierreInscripcion,
                                                )
                                            }
                                        </p>

                                    </div>

                                )
                            }

                            {
                                proximoHito && (

                                    <div class="border-t border-white/15 pt-4">

                                        <p class="text-[11px] text-white/60">
                                            Pròxim
                                        </p>

                                        <p class="mt-1 text-sm font-semibold">
                                            {proximoHito.titulo}
                                        </p>

                                        <p class="mt-1 text-xs text-white/70">
                                            {proximoHito.fechaTexto}
                                        </p>

                                    </div>

                                )
                            }

                        </div>

                    </section>

                )
            }

        </aside>

    </div>

    <!-- ======================================================
         ÚLTIMAS NOTICIAS
    ======================================================= -->

    {
        noticias.length > 0 && (

            <section class="mt-10">

                <header class="mb-5 flex items-end justify-between gap-4">

                    <div>

                        <p class="text-xs font-semibold text-primary">
                            Actualitat
                        </p>

                        <h2 class="mt-1 text-xl font-semibold text-neutral-titulos">
                            Últimes Notícies
                        </h2>

                    </div>

                    <a
                        href="/noticies"
                        class="shrink-0 text-xs font-medium text-neutral hover:text-primary"
                    >
                        Veure totes
                    </a>

                </header>

                <div class="grid gap-5 md:grid-cols-3">

                    {
                        noticias.map(
                            (noticia) => (

                                <a
                                    href={`/noticies/${encodeURIComponent(noticia.slug)}`}
                                    class="group overflow-hidden rounded-xl border border-border bg-card transition hover:-translate-y-1 hover:border-secondary hover:shadow-lg"
                                >

                                    <div class="h-40 overflow-hidden bg-muted/20">

                                        {
                                            noticia.cover_image ? (

                                                <img
                                                    src={noticia.cover_image}
                                                    alt={noticia.titular}
                                                    loading="lazy"
                                                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                                />

                                            ) : (

                                                <div class="flex h-full w-full items-center justify-center bg-primary/5">

                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 -960 960 960"
                                                        class="h-9 w-9 fill-primary/30"
                                                    >
                                                        <path d="M160-120q-33 0-56.5-23.5T80-200v-640l67 67 66-67 67 67 67-67 66 67 67-67 67 67 66-67 67 67 67-67 66 67 67-67v640q0 33-23.5 56.5T800-120zm0-80h280v-240H160zm360 0h280v-80H520zm0-160h280v-80H520zM160-520h640v-120H160z" />
                                                    </svg>

                                                </div>

                                            )
                                        }

                                    </div>

                                    <div class="p-4">

                                        <div class="flex items-center justify-between gap-3">

                                            <span class="rounded bg-secondary px-2 py-1 text-[10px] font-semibold text-white">
                                                {noticia.categoria}
                                            </span>

                                            {
                                                noticia.publication_date && (

                                                    <span class="shrink-0 text-[10px] text-neutral">
                                                        {
                                                            formatearFecha(
                                                                noticia.publication_date,
                                                            )
                                                        }
                                                    </span>

                                                )
                                            }

                                        </div>

                                        <h3 class="mt-3 line-clamp-2 text-base font-semibold leading-snug text-neutral-titulos">
                                            {noticia.titular}
                                        </h3>

                                        {
                                            noticia.subtitulo && (

                                                <p class="mt-2 line-clamp-2 text-xs leading-5 text-neutral">
                                                    {noticia.subtitulo}
                                                </p>

                                            )
                                        }

                                    </div>

                                </a>

                            ),
                        )
                    }

                </div>

            </section>

        )
    }

</div>