---
type Edicion = {
    id: string;
    torneo_id: string;
    nombre: string;
    fecha_inicio: string | null;
    fecha_fin: string | null;
    estado: string;
    sede: string;
};

type Props = {
    torneoID: string;
    edicionActualID: string;
    ediciones: Edicion[];
};

const {
    torneoID,
    edicionActualID,
    ediciones,
} = Astro.props;

const otrasEdiciones =
    ediciones.filter(
        edicion =>
            edicion.id !==
            edicionActualID,
    );

function urlEdicion(
    edicionID: string,
) {
    return `/tornejos/${encodeURIComponent(
        torneoID,
    )}?edicionID=${encodeURIComponent(
        edicionID,
    )}`;
}

function formatearFecha(
    valor: string | null,
) {
    if (!valor) {
        return null;
    }

    /*
     * Evitamos cambios de día por zona horaria
     * si Supabase devuelve YYYY-MM-DD.
     */
    const fecha =
        /^\d{4}-\d{2}-\d{2}$/.test(
            valor,
        )
            ? new Date(
                  `${valor}T12:00:00`,
              )
            : new Date(
                  valor,
              );

    if (
        Number.isNaN(
            fecha.getTime(),
        )
    ) {
        return null;
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            day:
                "numeric",

            month:
                "short",

            year:
                "numeric",
        },
    ).format(
        fecha,
    );
}

function textoFechas(
    edicion: Edicion,
) {
    const inicio =
        formatearFecha(
            edicion.fecha_inicio,
        );

    const fin =
        formatearFecha(
            edicion.fecha_fin,
        );

    if (
        inicio &&
        fin
    ) {
        return `${inicio} — ${fin}`;
    }

    if (inicio) {
        return `Des del ${inicio}`;
    }

    if (fin) {
        return `Fins al ${fin}`;
    }

    return null;
}
---

{
    otrasEdiciones.length > 0 && (
        <section
            aria-labelledby="altres-edicions-title"
            class="border-t border-border bg-card/30"
        >
            <div
                class="
                    mx-auto
                    w-full
                    max-w-6xl
                    px-4
                    py-8
                    sm:px-6
                    lg:px-8
                "
            >
                <!-- CABECERA -->

                <div
                    class="
                        mb-5
                        flex
                        flex-wrap
                        items-end
                        justify-between
                        gap-3
                    "
                >
                    <div>
                        <p
                            class="
                                text-xs
                                font-semibold
                                uppercase
                                tracking-[0.14em]
                                text-primary
                            "
                        >
                            Altres edicions
                        </p>

                        <h2
                            id="altres-edicions-title"
                            class="
                                mt-1
                                text-xl
                                font-bold
                                text-neutral-titulos
                            "
                        >
                            Altres edicions actives
                        </h2>

                        <p
                            class="
                                mt-1
                                text-sm
                                text-neutral
                            "
                        >
                            Consulta les altres edicions actives d'aquest torneig.
                        </p>
                    </div>

                    <span
                        class="
                            rounded-full
                            border
                            border-border
                            bg-background
                            px-3
                            py-1
                            text-xs
                            font-semibold
                            text-neutral
                        "
                    >
                        {otrasEdiciones.length}
                        {
                            otrasEdiciones.length ===
                            1
                                ? " edició"
                                : " edicions"
                        }
                    </span>
                </div>

                <!-- ARRAY -->

                <div
                    class="
                        -mx-4
                        flex
                        snap-x
                        snap-mandatory
                        gap-3
                        overflow-x-auto
                        px-4
                        pb-2

                        sm:mx-0
                        sm:px-0

                        lg:grid
                        lg:overflow-visible
                    "
                    style={`grid-template-columns: repeat(${Math.min(
                        otrasEdiciones.length,
                        3,
                    )}, minmax(0, 1fr));`}
                >
                    {
                        otrasEdiciones.map(
                            edicion => {
                                const fechas =
                                    textoFechas(
                                        edicion,
                                    );

                                return (
                                    <a
                                        href={urlEdicion(
                                            edicion.id,
                                        )}
                                        class="
                                            group
                                            flex
                                            min-w-[280px]
                                            snap-start
                                            flex-col
                                            justify-between
                                            rounded-2xl
                                            border
                                            border-border/60
                                            bg-card
                                            p-5
                                            transition

                                            hover:-translate-y-0.5
                                            hover:border-primary/40
                                            hover:shadow-lg

                                            lg:min-w-0
                                        "
                                    >
                                        <div>
                                            <!-- ESTADO -->

                                            <div
                                                class="
                                                    flex
                                                    items-start
                                                    justify-between
                                                    gap-3
                                                "
                                            >
                                                <span
                                                    class="
                                                        inline-flex
                                                        items-center
                                                        gap-2
                                                        rounded-full
                                                        bg-secondary/10
                                                        px-2.5
                                                        py-1
                                                        text-[11px]
                                                        font-semibold
                                                        text-secondary
                                                    "
                                                >
                                                    <span
                                                        class="
                                                            h-1.5
                                                            w-1.5
                                                            rounded-full
                                                            bg-secondary
                                                        "
                                                    />

                                                    Activa
                                                </span>

                                                <span
                                                    class="
                                                        flex
                                                        h-8
                                                        w-8
                                                        shrink-0
                                                        items-center
                                                        justify-center
                                                        rounded-lg
                                                        bg-primary/10
                                                        text-primary
                                                        transition
                                                        group-hover:translate-x-0.5
                                                    "
                                                >
                                                    →
                                                </span>
                                            </div>

                                            <!-- NOMBRE -->

                                            <h3
                                                class="
                                                    mt-4
                                                    text-lg
                                                    font-bold
                                                    text-neutral-titulos
                                                    transition
                                                    group-hover:text-primary
                                                "
                                            >
                                                {
                                                    edicion.nombre
                                                }
                                            </h3>

                                            <!-- FECHAS -->

                                            {
                                                fechas && (
                                                    <p
                                                        class="
                                                            mt-2
                                                            text-sm
                                                            text-neutral
                                                        "
                                                    >
                                                        {
                                                            fechas
                                                        }
                                                    </p>
                                                )
                                            }

                                            <!-- SEDE -->

                                            {
                                                edicion.sede && (
                                                    <div
                                                        class="
                                                            mt-3
                                                            flex
                                                            items-start
                                                            gap-2
                                                            text-xs
                                                            text-neutral
                                                        "
                                                    >
                                                        <svg
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                            class="
                                                                mt-0.5
                                                                h-4
                                                                w-4
                                                                shrink-0
                                                            "
                                                            aria-hidden="true"
                                                        >
                                                            <path
                                                                d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"
                                                            />

                                                            <circle
                                                                cx="12"
                                                                cy="10"
                                                                r="2.5"
                                                            />
                                                        </svg>

                                                        <span>
                                                            {
                                                                edicion.sede
                                                            }
                                                        </span>
                                                    </div>
                                                )
                                            }
                                        </div>

                                        <div
                                            class="
                                                mt-5
                                                border-t
                                                border-border/50
                                                pt-4
                                                text-sm
                                                font-semibold
                                                text-primary
                                            "
                                        >
                                            Veure edició
                                        </div>
                                    </a>
                                );
                            },
                        )
                    }
                </div>
            </div>
        </section>
    )
}