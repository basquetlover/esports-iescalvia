---
import FormularioVoluntario from "@components/formularios/FormularioVoluntario";

type Props = {
    configuracion: unknown;
    banner: string;
    edicionID: string;
};

// Conserva aquí el resto de tipos y funciones existentes.


type EstadoInscripcion =
    | "oberta"
    | "proximament"
    | "tancada"
    | "sense_dates";

type TipoVoluntariado = {
    id:
        string;

    nombre:
        string;

    descripcion:
        string;

    activo:
        boolean;

    maximo:
        number | null;

    comportamiento:
        | "permitir"
        | "lista_espera"
        | "bloquear";
};


const {
    configuracion,
    banner,
    edicionID,
} = Astro.props as Props;

// ============================================================
// HELPERS
// ============================================================

function esRegistro(
    valor:
        unknown,
): valor is Record<
    string,
    unknown
> {
    return (
        valor !==
            null &&
        typeof valor ===
            "object" &&
        !Array.isArray(
            valor
        )
    );
}

function numeroNullable(
    valor:
        unknown,
): number | null {
    return (
        typeof valor ===
            "number" &&
        Number.isFinite(
            valor
        )
    )
        ? valor
        : null;
}

function numero(
    valor:
        unknown,

    defecto =
        0,
): number {
    return (
        typeof valor ===
            "number" &&
        Number.isFinite(
            valor
        )
    )
        ? valor
        : defecto;
}

function textoNullable(
    valor:
        unknown,
): string | null {
    return typeof valor ===
        "string"
        ? valor
        : null;
}

function fechaValida(
    valor:
        string | null,
) {
    if (
        !valor
    ) {
        return null;
    }

    const fecha =
        new Date(
            valor
        );

    return Number.isNaN(
        fecha.getTime()
    )
        ? null
        : fecha;
}

function fechaVisible(
    valor:
        string | null,
) {
    const fecha =
        fechaValida(
            valor
        );

    if (
        !fecha
    ) {
        return "No definida";
    }

    return new Intl.DateTimeFormat(
        "ca-ES",
        {
            dateStyle:
                "long",

            timeStyle:
                "short",

            timeZone:
                "Europe/Madrid",
        }
    ).format(
        fecha
    );
}

// ============================================================
// CONFIGURACIÓN
// ============================================================

const voluntarios =
    esRegistro(
        configuracion
    )
        ? configuracion
        : {};

const inscripcion =
    esRegistro(
        voluntarios.inscripcion
    )
        ? voluntarios.inscripcion
        : {};

const cupo =
    esRegistro(
        voluntarios.cupo
    )
        ? voluntarios.cupo
        : {};

const apertura =
    textoNullable(
        inscripcion.apertura
    );

const cierre =
    textoNullable(
        inscripcion.cierre
    );

const fechaApertura =
    fechaValida(
        apertura
    );

const fechaCierre =
    fechaValida(
        cierre
    );

const ahora =
    Date.now();

let estado:
    EstadoInscripcion =
    "sense_dates";

if (
    fechaApertura &&
    fechaCierre
) {
    if (
        ahora <
        fechaApertura.getTime()
    ) {
        estado =
            "proximament";
    } else if (
        ahora >
        fechaCierre.getTime()
    ) {
        estado =
            "tancada";
    } else {
        estado =
            "oberta";
    }
}

const maximoVoluntarios =
    numeroNullable(
        cupo.maximo
    );

// ============================================================
// ROLES
// ============================================================

const tipos:
    TipoVoluntariado[] =
    Array.isArray(
        voluntarios.tipos
    )
        ? voluntarios
              .tipos
              .filter(
                  esRegistro
              )
              .map(
                  (
                      entrada,
                      indice,
                  ): TipoVoluntariado => {
                      const cupoTipo =
                          esRegistro(
                              entrada.cupo
                          )
                              ? entrada.cupo
                              : {};

                      return {
                          id:
                              typeof entrada.id ===
                                  "string"
                                  ? entrada.id
                                  : `rol-${indice + 1}`,

                          nombre:
                              typeof entrada.nombre ===
                                  "string"
                                  ? entrada.nombre
                                  : "",

                          descripcion:
                              typeof entrada.descripcion ===
                                  "string"
                                  ? entrada.descripcion
                                  : "",

                          activo:
                              entrada.activo !==
                              false,

                          maximo:
                              numeroNullable(
                                  cupoTipo.maximo
                              ),

                          comportamiento:
                              cupoTipo.al_superar ===
                                  "lista_espera" ||
                              cupoTipo.al_superar ===
                                  "bloquear"
                                  ? cupoTipo.al_superar
                                  : "permitir",
                      };
                  }
              )
              .filter(
                  tipo =>
                      tipo.activo &&
                      Boolean(
                          tipo.nombre.trim()
                      )
              )
        : [];
---

<section class="bg-background py-10 sm:py-12 lg:py-16">
    <div class="mx-auto w-full max-w-6xl space-y-12 px-4 sm:px-6 lg:px-8">

        <!-- =================================================
            HERO
        ================================================== -->

        <section class="overflow-hidden rounded-2xl bg-primary">
            <div class="grid min-h-72 lg:grid-cols-[minmax(0,1fr)_42%]">
                <div class="flex flex-col justify-center px-6 py-10 sm:px-8 lg:px-10">
                    {
                        estado ===
                            "oberta" && (
                            <span class="w-max rounded-full bg-white/15 px-3 py-1.5 text-xs font-semibold text-white">
                                Inscripcions obertes
                            </span>
                        )
                    }

                    {
                        estado ===
                            "proximament" && (
                            <span class="w-max rounded-full bg-white/15 px-3 py-1.5 text-xs font-semibold text-white">
                                Pròximament
                            </span>
                        )
                    }

                    {
                        estado ===
                            "tancada" && (
                            <span class="w-max rounded-full bg-white/15 px-3 py-1.5 text-xs font-semibold text-white">
                                Inscripcions tancades
                            </span>
                        )
                    }

                    <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
                        Fes-te voluntari
                    </h2>

                    <p class="mt-3 max-w-xl text-sm leading-6 text-white/80 sm:text-base sm:leading-7">
                        Uneix-te a l'equip que fa possible el torneig
                        des de dins. Col·labora, viu l'experiència i
                        forma part de l'organització.
                    </p>

                    {
                        estado ===
                            "oberta" && (
                            <a
                                href="#formulari-voluntariat"
