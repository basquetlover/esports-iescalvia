                                                            <path d="M4 20V8"></path>
                                                            <path d="M20 20V8"></path>
                                                            <path d="M4 12h16"></path>
                                                            <path d="M8 8V4h8v4"></path>
                                                        </svg>
                                                    ) : indice %
                                                          4 ===
                                                      1 ? (
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.7"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            class="h-5 w-5"
                                                            aria-hidden="true"
                                                        >
                                                            <rect
                                                                x="4"
                                                                y="5"
                                                                width="16"
                                                                height="14"
                                                                rx="2"
                                                            ></rect>
                                                            <circle
                                                                cx="12"
                                                                cy="12"
                                                                r="3"
                                                            ></circle>
                                                            <path d="m16 5-1-2h-6L8 5"></path>
                                                        </svg>
                                                    ) : indice %
                                                          4 ===
                                                      2 ? (
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.7"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            class="h-5 w-5"
                                                            aria-hidden="true"
                                                        >
                                                            <rect
                                                                x="3"
                                                                y="4"
                                                                width="18"
                                                                height="16"
                                                                rx="2"
                                                            ></rect>
                                                            <path d="M7 8h10"></path>
                                                            <path d="M7 12h6"></path>
                                                            <path d="M7 16h4"></path>
                                                        </svg>
                                                    ) : (
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="1.7"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            class="h-5 w-5"
                                                            aria-hidden="true"
                                                        >
                                                            <path d="M4 13h4l2-7 4 12 2-5h4"></path>
                                                        </svg>
                                                    )
                                                }
                                            </span>

                                            {
                                                tipo.maximo !==
                                                    null && (
                                                    <span class="rounded-full bg-card px-2.5 py-1 text-[11px] font-semibold text-neutral">
                                                        Màx. {tipo.maximo}
                                                    </span>
                                                )
                                            }
                                        </div>

                                        <h3 class="mt-4 text-base font-semibold text-neutral-titulos">
                                            {tipo.nombre}
                                        </h3>

                                        {
                                            tipo.descripcion && (
                                                <p class="mt-2 text-sm leading-6 text-neutral">
                                                    {tipo.descripcion}
                                                </p>
                                            )
                                        }

                                        {
                                            tipo.comportamiento ===
                                                "lista_espera" && (
                                                <p class="mt-4 text-xs font-medium text-primary">
                                                    Amb llista d'espera si s'omplen les places
                                                </p>
                                            )
                                        }

                                        {
                                            tipo.comportamiento ===
                                                "bloquear" && (
                                                <p class="mt-4 text-xs font-medium text-neutral">
                                                    Inscripció tancada quan s'omplin les places
                                                </p>
                                            )
                                        }
                                    </article>
                                )
                            )
                        }
                    </div>
                ) : (
                    <div class="mt-6 rounded-2xl border border-dashed border-border bg-card/30 px-6 py-10 text-center">
                        <h3 class="font-semibold text-neutral-titulos">
                            Encara no hi ha rols disponibles
                        </h3>

                        <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-neutral">
                            L'organització encara no ha publicat
                            els tipus de voluntariat d'aquesta edició.
                        </p>
                    </div>
                )
            }
        </section>

        <!-- =================================================
            INFORMACIÓN
        ================================================== -->

        <section class="grid grid-cols-1 gap-5 lg:grid-cols-2">

            <div class="rounded-2xl bg-primary/8 p-6 sm:p-7">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-5 w-5"
                        aria-hidden="true"
                    >
                        <path d="M12 21s-8-4.5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.5-8 11-8 11Z"></path>
                    </svg>
                </span>

                <h2 class="mt-4 text-xl font-bold tracking-tight text-neutral-titulos">
                    Per què fer voluntariat?
                </h2>

                <div class="mt-5 space-y-4">
                    <div class="flex gap-3">
                        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                class="h-3.5 w-3.5"
                            >
                                <path d="m5 12 4 4L19 6"></path>
                            </svg>
