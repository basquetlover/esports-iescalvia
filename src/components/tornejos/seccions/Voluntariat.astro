                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="h-4 w-4"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m13 6 6 6-6 6"></path>
                                </svg>
                            </a>
                        )
                    }
                </div>

                {
                    banner ? (
                        <div class="relative hidden min-h-72 lg:block">
                            <img
                                src={banner}
                                alt=""
                                aria-hidden="true"
                                class="absolute inset-0 h-full w-full object-cover"
                            />

                            <div class="absolute inset-0 bg-linear-to-r from-primary via-primary/25 to-transparent"></div>
                        </div>
                    ) : (
                        <div class="hidden items-center justify-center bg-primary/80 lg:flex">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-24 w-24 text-white/15"
                                aria-hidden="true"
                            >
                                <circle cx="9" cy="7" r="3"></circle>
                                <path d="M3 20v-1a6 6 0 0 1 12 0v1"></path>
                                <path d="M17 8h4"></path>
                                <path d="M19 6v4"></path>
                            </svg>
                        </div>
                    )
                }
            </div>
        </section>

        <!-- =================================================
            ROLES
        ================================================== -->

        <section>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
                Oportunitats
            </p>

            <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-neutral-titulos sm:text-3xl">
                        Rols disponibles
                    </h2>

                    <p class="mt-2 max-w-2xl text-sm leading-6 text-neutral">
                        Tria la tasca que millor encaixa amb tu i
                        ajuda'ns durant el torneig.
                    </p>
                </div>

                {
                    maximoVoluntarios !==
                        null && (
                        <span class="w-max rounded-full border border-border bg-card px-3 py-1.5 text-xs font-semibold text-neutral">
                            Màxim {maximoVoluntarios} voluntaris
                        </span>
                    )
                }
            </div>

            {
                tipos.length >
                    0 ? (
                    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
