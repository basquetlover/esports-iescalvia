        <p class="mt-1 text-sm text-white/75">
            Consulta l'estat de la teva sol·licitud o completa la inscripció.
        </p>
    </div>

    <div class="p-6 sm:p-8">
        <FormularioVoluntario edicionID={edicionID} client:load />
    </div>
</section>
    </div>
</section>