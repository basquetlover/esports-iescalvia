---
import { supabaseAdmin } from "@utils/supabase";

import BracketEliminatoria from "./BracketEliminatoria";

import type {
  FaseEliminatoria,
  RondaEliminatoria,
  PartidoEliminatoria,
  PlazaEliminatoria,
  EquipoEliminatoria,
  GrupoEliminatoria,
  PistaEliminatoria,
  ResultadoEliminatoria,
} from "./BracketEliminatoria";

// ============================================================
// PROPS
// ============================================================

type Props = {
  torneoID: string;
  edicionID: string;
};

const { torneoID, edicionID } = Astro.props;

// ============================================================
// FASES ELIMINATORIAS
// ============================================================

const { data: fasesData, error: errorFases } = await supabaseAdmin
  .from("competicion_fases")
  .select(
    `
                id,
                edicion_id,
                nombre,
                tipo,
                orden,
                estado
            `,
  )
  .eq("edicion_id", edicionID)
  .eq("tipo", "ELIMINATORIA")
  .order("orden", {
    ascending: true,
  });

if (errorFases) {
  console.error("Error carregant les fases eliminatòries:", errorFases);
}

const fases = (fasesData ?? []) as FaseEliminatoria[];

const idsFases = fases.map((fase) => fase.id);

// ============================================================
// RONDAS
// ============================================================

let rondas: RondaEliminatoria[] = [];

if (idsFases.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("competicion_rondas")
    .select(
      `
                    id,
                    fase_id,
                    tipo,
                    nombre,
                    orden
                `,
    )
    .in("fase_id", idsFases)
    .order("orden", {
      ascending: true,
    });

  if (error) {
    console.error("Error carregant les rondes eliminatòries:", error);
  }

  rondas = (data ?? []) as RondaEliminatoria[];
}

// ============================================================
// PARTIDOS
// ============================================================

let partidos: PartidoEliminatoria[] = [];

if (idsFases.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("competicion_partidos")
    .select(
      `
                    id,
                    edicion_id,
                    fase_id,
                    tipo,
                    grupo_id,
                    ronda_id,
                    codigo,
                    nombre,
                    orden,
                    jornada,
                    estado,
                    fecha_hora,
                    pista_id,
                    duracion_estimada_min,
                    publicado
                `,
    )
    .eq("edicion_id", edicionID)
    .eq("tipo", "ELIMINATORIA")
    .in("fase_id", idsFases)
    .order("orden", {
      ascending: true,
    });

  if (error) {
    console.error("Error carregant els partits eliminatoris:", error);
  }

  partidos = (data ?? []) as PartidoEliminatoria[];
}

const idsPartidos = partidos.map((partido) => partido.id);

// ============================================================
// PLAZAS
// ============================================================

let plazas: PlazaEliminatoria[] = [];

if (idsPartidos.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("competicion_plazas")
    .select(
      `
                    id,
                    destino_fase_id,
                    destino_tipo,
                    partido_id,
                    lado,
                    orden,
                    origen_tipo,
                    equipo_origen_id,
                    origen_grupo_id,
                    origen_fase_id,
                    origen_posicion,
                    origen_partido_id,
                    equipo_resuelto_id
                `,
    )
    .eq("edicion_id", edicionID)
    .eq("destino_tipo", "PARTIDO")
    .in("partido_id", idsPartidos)
    .order("orden", {
      ascending: true,
    });

  if (error) {
    console.error("Error carregant les places de l'eliminatòria:", error);
  }

  plazas = (data ?? []) as PlazaEliminatoria[];
}

// ============================================================
// RESULTADOS
// ============================================================
//
// Importante:
// la tabla permite más de un resultado por partido.
//
// No seleccionamos uno aquí.
// El componente React aplica la misma prioridad que el panel:
// confirmado primero y, después, más reciente.
// ============================================================

let resultados: ResultadoEliminatoria[] = [];

if (idsPartidos.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("competicion_resultados")
    .select(
      `
                    id,
                    partido_id,
                    marcador_local,
                    marcador_visitante,
                    ganador_equipo_id,
                    resultado_tipo,
                    confirmado,
                    confirmado_at,
                    updated_at
                `,
    )
    .eq("edicion_id", edicionID)
    .in("partido_id", idsPartidos);

  if (error) {
    console.error("Error carregant els resultats de l'eliminatòria:", error);
  }

  resultados = (data ?? []) as ResultadoEliminatoria[];
}

// ============================================================
// EQUIPOS
// ============================================================

const idsEquipos = Array.from(
  new Set(
    plazas
      .flatMap((plaza) => [plaza.equipo_origen_id, plaza.equipo_resuelto_id])
      .filter((id): id is string => typeof id === "string" && Boolean(id)),
  ),
);

let equipos: EquipoEliminatoria[] = [];

if (idsEquipos.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("equipos")
    .select(
      `
                    id,
                    nombre,
                    escudo
                `,
    )
    .in("id", idsEquipos);

  if (error) {
    console.error("Error carregant els equips de l'eliminatòria:", error);
  }

  equipos = (data ?? []).map((equipo) => ({
    id: equipo.id,

    nombre: equipo.nombre ?? "Equip",

    escudo: equipo.escudo ?? null,
  }));
}

// ============================================================
// GRUPOS DE ORIGEN
// ============================================================

const idsGrupos = Array.from(
  new Set(
    plazas
      .map((plaza) => plaza.origen_grupo_id)
      .filter((id): id is string => typeof id === "string" && Boolean(id)),
  ),
);

let grupos: GrupoEliminatoria[] = [];

if (idsGrupos.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("competicion_grupos")
    .select(
      `
                    id,
                    nombre
                `,
    )
    .in("id", idsGrupos);

  if (error) {
    console.error("Error carregant els grups d'origen:", error);
  }

  grupos = (data ?? []) as GrupoEliminatoria[];
}

// ============================================================
// PISTAS
// ============================================================

const idsPistas = Array.from(
  new Set(
    partidos
      .map((partido) => partido.pista_id)
      .filter((id): id is string => typeof id === "string" && Boolean(id)),
  ),
);

let pistas: PistaEliminatoria[] = [];

if (idsPistas.length > 0) {
  const { data, error } = await supabaseAdmin
    .from("competicion_pistas")
    .select(
      `
                    id,
                    nombre
                `,
    )
    .eq("torneo_id", torneoID)
    .in("id", idsPistas);

  if (error) {
    console.error("Error carregant les pistes de l'eliminatòria:", error);
  }

  pistas = (data ?? []) as PistaEliminatoria[];
}

// ============================================================
// FASE INICIAL
// ============================================================

const faseParametro = Astro.url.searchParams.get("fase");

const faseInicialID =
  faseParametro && fases.some((fase) => fase.id === faseParametro)
    ? faseParametro
    : (fases[0]?.id ?? null);
---

{
  fases.length > 0 && (
    <section
      id="eliminatoria"
      class="
                mx-auto
                min-w-0
                w-full
                max-w-7xl
                overflow-x-clip
                px-4
                py-10

                sm:px-6
                sm:py-14

                lg:px-8
            "
    >
      <BracketEliminatoria
        fases={fases}
        rondas={rondas}
        partidos={partidos}
        plazas={plazas}
        equipos={equipos}
        grupos={grupos}
        pistas={pistas}
        resultados={resultados}
        faseInicialID={faseInicialID}
        client:visible
      />
    </section>
  )
}
