<button
  data-theme-toggle
  type="button"
  class="cursor-pointer"
>
  <span data-theme-icon-dark>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-secondary" viewBox="0 -960 960 960">
      <path d="M480-120q-150 0-255-105T120-480t105-255 255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120m0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82m-10-270"/>
    </svg>
  </span>

  <span data-theme-icon-light>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-secondary" viewBox="0 -960 960 960">
      <path d="M565-395q35-35 35-85t-35-85-85-35-85 35-35 85 35 85 85 35 85-35m-226.5 56.5Q280-397 280-480t58.5-141.5T480-680t141.5 58.5T680-480t-58.5 141.5T480-280t-141.5-58.5M200-440H40v-80h160zm720 0H760v-80h160zM440-760v-160h80v160zm0 720v-160h80v160zM256-650l-101-97 57-59 96 100zm492 496-97-101 53-55 101 97zm-98-550 97-101 59 57-100 96zM154-212l101-97 55 53-97 101zm326-268"/>
    </svg>
  </span>
</button>

<script>
  const html = document.documentElement;

  function updateIcons() {
    const isDark = html.classList.contains("oscuro");

    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      const iconDark = button.querySelector("[data-theme-icon-dark]");
      const iconLight = button.querySelector("[data-theme-icon-light]");

      if (isDark) {
        iconDark?.classList.remove("hidden");
        iconDark?.classList.add("block");

        iconLight?.classList.remove("block");
        iconLight?.classList.add("hidden");
      } else {
        iconLight?.classList.remove("hidden");
        iconLight?.classList.add("block");

        iconDark?.classList.remove("block");
        iconDark?.classList.add("hidden");
      }
    });
  }

  updateIcons();

  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const isDark = html.classList.toggle("oscuro");

      localStorage.setItem(
        "theme",
        isDark ? "dark" : "light"
      );

      updateIcons();
    });
  });
</script>