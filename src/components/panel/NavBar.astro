---
import { MENU_ADMIN } from "@const/Menu";
import {
    MENU_PANEL_GENERAL,
    MENU_PANEL_TORNEO,
    type OpcionMenuPanel,
} from "@const/MenuPanel";
import { tienePermiso } from "@const/Permisos";

interface Props {
    usuario: {
        rol?: string | null;
        permisos?: unknown;
    } | null;
}

const { usuario } = Astro.props;

const url = Astro.url;
const pathname = url.pathname.replace(/\/+$/, "") || "/";

const torneoID =
    url.searchParams.get("torneoID")?.trim() || undefined;

const edicionID = torneoID
    ? url.searchParams.get("edicionID")?.trim() || undefined
    : undefined;

const hayTorneo = Boolean(torneoID);

const puedeVerPanelGeneral = tienePermiso(
    usuario,
    "panell",
    "ver"
);

const puedeVerContexto =
    puedeVerPanelGeneral &&
    (
        !torneoID ||
        tienePermiso(usuario, "panell", "ver", torneoID)
    );

const grupos = hayTorneo
    ? MENU_PANEL_TORNEO
    : MENU_PANEL_GENERAL;

const gruposVisibles = grupos
    .filter((grupo) => !grupo.requiereEdicion || Boolean(edicionID))
    .map((grupo) => ({
        ...grupo,
        opciones: grupo.opciones.filter((item) => {
            if (!puedeVerContexto) return false;

            const ambito = item.contexto === "general"
                ? undefined
                : torneoID;

            return tienePermiso(
                usuario,
                item.seccion,
                item.accion ?? "ver",
                ambito
            );
        }),
    }))
    .filter((grupo) => grupo.opciones.length > 0);

function crearEnlace(item: OpcionMenuPanel): string {
    const parametros = new URLSearchParams(item.parametros);

    if (item.contexto !== "general" && torneoID) {
        parametros.set("torneoID", torneoID);
    }

    if (item.contexto === "edicion" && torneoID && edicionID) {
        parametros.set("edicionID", edicionID);
    }

    const consulta = parametros.toString();

    return consulta
        ? `${item.enlace}?${consulta}`
        : item.enlace;
}

function esPaginaActual(item: OpcionMenuPanel): boolean {
    if (item.estado !== "Activa") return false;

    const ruta = item.enlace.replace(/\/+$/, "") || "/";

    // Inici solo se marca en la raíz del panel.
    if (ruta === "/panell") {
        return pathname === ruta;
    }

    // La ficha sigue seleccionada al pasar de ver a editar.
    if (item.id === "informacio-torneig") {
        return (
            pathname === ruta &&
            url.searchParams.get("accio") !== "crear"
        );
    }

    return pathname === ruta || pathname.startsWith(`${ruta}/`);
}

const iconosGenerales = Object.fromEntries(
    MENU_ADMIN.map((item) => [item.id, item.icono])
) as Record<string, string>;

const iconoResumen = iconosGenerales.panel ?? "";
const iconoTorneo = iconosGenerales.tornejos ?? "";
const iconoUsuarios = iconosGenerales.usuarios ?? "";
const iconoPermisos = iconosGenerales.permisos ?? "";
const iconoConfiguracion = iconosGenerales.configuracion ?? "";

const iconosTorneo: Record<string, string> = {
    "inici-torneig": iconoResumen,
    "informacio-torneig": iconoTorneo,
    edicions: iconoResumen,
    organitzacio: iconoPermisos,
    voluntaris: iconoUsuarios,
    equips: iconoUsuarios,
    competicio: iconoTorneo,
    partits: iconoResumen,
    classificacions: iconoTorneo,
    "configuracio-edicio": iconoConfiguracion,
};

function obtenerIcono(id: string): string {
    return iconosTorneo[id] ?? iconosGenerales[id] ?? iconoResumen;
}
---

<div
    class="flex h-dvh w-56 flex-col overflow-hidden border-r border-on-background bg-card"
>
    <div class="relative shrink-0 border-b border-border px-3 py-4">
        <button
            type="button"
            class="btn-MenuDesktop absolute right-1 top-1 hidden rounded-md p-1 text-neutral hover:bg-secondary/15 max-md:inline-flex"
            aria-label="Tancar el menú"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <path d="m6 6 12 12M18 6 6 18" />
            </svg>
        </button>

        <div class="flex items-center justify-center gap-2">
            <img
                src="/logo-temporal.png"
                alt=""
                class="h-10 w-10 object-contain"
            />

            <p
                class="flex flex-col text-center text-lg font-bold uppercase text-secondary"
            >
                Esports
                <span class="text-sm font-semibold text-primary">
                    IES Calvià
                </span>
            </p>
        </div>

        <p class="mt-3 text-center text-xs font-semibold text-neutral">
            {hayTorneo ? "Gestió del torneig" : "Panell d’administració"}
        </p>
    </div>

    <nav
        class="min-h-0 flex-1 overflow-y-auto p-2"
        aria-label={hayTorneo
            ? "Menú del torneig"
            : "Menú d’administració"}
    >
        {
            gruposVisibles.map((grupo) => (
                <section
                    class="mb-5"
                    aria-labelledby={`menu-grupo-${grupo.id}`}
                >
                    <h2
                        id={`menu-grupo-${grupo.id}`}
                        class="mb-2 px-3 text-[10px] font-bold uppercase tracking-wider text-neutral"
                    >
                        {grupo.nombre}
                    </h2>

                    <ul class="flex flex-col gap-1">
                        {grupo.opciones.map((item) => {
                            const actual = esPaginaActual(item);
                            const disponible = item.estado === "Activa";

                            return (
                                <li>
                                    {disponible ? (
                                        <a
                                            href={crearEnlace(item)}
                                            aria-current={actual ? "page" : undefined}
                                            class:list={[
                                                "relative flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold transition-colors",
                                                actual
                                                    ? "bg-secondary/15 text-secondary"
                                                    : "text-neutral hover:bg-secondary/10 hover:text-primary",
                                            ]}
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-5 w-5 shrink-0 fill-current"
                                                viewBox="0 -960 960 960"
                                                aria-hidden="true"
                                                set:html={obtenerIcono(item.id)}
                                            />

                                            <span class="min-w-0 leading-snug">
                                                {item.nombre}
                                            </span>

                                            {actual && (
                                                <span
                                                    class="absolute inset-y-2 right-0 w-1 rounded-l bg-secondary"
                                                    aria-hidden="true"
                                                />
                                            )}
                                        </a>
                                    ) : (
                                        <button
                                            type="button"
                                            disabled
                                            class="flex w-full cursor-not-allowed items-center gap-2 rounded-md px-3 py-2.5 text-left text-sm font-semibold text-neutral opacity-50"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-5 w-5 shrink-0 fill-current"
                                                viewBox="0 -960 960 960"
                                                aria-hidden="true"
                                                set:html={obtenerIcono(item.id)}
                                            />

                                            <span class="flex min-w-0 flex-col gap-0.5">
                                                <span class="leading-snug">
                                                    {item.nombre}
                                                </span>

                                                <span class="text-[10px] font-normal">
                                                    Pròximament
                                                </span>
                                            </span>
                                        </button>
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                </section>
            ))
        }
    </nav>

    <div class="shrink-0 space-y-1 border-t border-border p-2">
        {
            hayTorneo && puedeVerPanelGeneral && (
                <a
                    href="/panell"
                    class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold text-neutral transition-colors hover:bg-secondary/10 hover:text-primary"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 shrink-0"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                    >
                        <path d="m12 19-7-7 7-7M5 12h14" />
                    </svg>

                    <span>Tornar al panell general</span>
                </a>
            )
        }

        <a
            href="/"
            class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold text-neutral transition-colors hover:bg-secondary/10 hover:text-primary"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <path d="M9 5H5v14h4M14 8l4 4-4 4M9 12h9" />
            </svg>

            <span>Sortir del panell</span>
        </a>
    </div>
</div>