---
import { supabaseAdmin } from "src/utils/supabase";

// import { proyectosUsuario } from "@utils/proyectoSeleccionado";

const { data: torneos, error: usuarioError } = await supabaseAdmin
    .from("torneos")
    .select("*");
// asegurar tipo para evitar 'implicit any' en los callbacks
const torneosAny: any[] = (torneos as any[]) ?? [];
const url = new URL(Astro.request.url);
const torneoSeleccionadoID = url.searchParams.get("torneoID");
// Separar seleccionado y resto

 const torneoSeleccionado = torneosAny.find((p: any) => p.id === torneoSeleccionadoID) ?? null;
 const otrosTorneos = torneosAny.filter((p: any) => p.id !== torneoSeleccionadoID);

---

<div class="w-max relative" id="proyectosDropdown">
<div class="bg-background border border-border p-2 rounded-md cursor-pointer flex items-center justify-between w-60 hover:bg-background/30 duration-300">
    <div class="flex items-center gap-x-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-neutral" viewBox="0 -960 960 960">
            <path d="M280-120v-80h160v-124q-49-11-87.5-41.5T296-442q-75-9-125.5-65.5T120-640v-40q0-33 23.5-56.5T200-760h80v-80h400v80h80q33 0 56.5 23.5T840-680v40q0 76-50.5 132.5T664-442q-18 46-56.5 76.5T520-324v124h160v80zm0-408v-152h-80v40q0 38 22 68.5t58 43.5m285 93q35-35 35-85v-240H360v240q0 50 35 85t85 35 85-35m115-93q36-13 58-43.5t22-68.5v-40h-80zm-200-52"/>
        </svg>
        {torneoSeleccionado ? (<>
                <img src={torneoSeleccionado.logo} alt={`${torneoSeleccionado.nombre} favicon`} class="inline-block w-5 h-5  align-middle"/>
                <p class="w-40 salto-de-linea">{torneoSeleccionado.nombre} </p>
                {/* <p class={`text-xs w-20 py-0.5 flex items-center place-content-center capitalize px-2 border rounded-full ${torneoSeleccionado.rolUsuario === 'propietario' ? 'bg-rol-propietario/30 border-rol-propietario text-rol-propietario' : torneoSeleccionado.rolUsuario === 'admin' ? 'bg-rol-administracion/30 border-rol-administracion text-rol-administracion' : torneoSeleccionado.rolUsuario === 'visitante' ? 'bg-rol-visitante/30 border-rol-visitante text-rol-visitante' : 'bg-rol-colaborador/30 text-rol-colaborador border-rol-colaborador'}`}>{torneoSeleccionado.rolUsuario?.trim()}</p> */}
        </>):(<>
            <p>Selecciona un torneig</p>
        </>)}
    </div>
    
    
    
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-neutral" viewBox="0 -960 960 960">
        <path d="M480-120 300-300l58-58 122 122 122-122 58 58-180 180ZM358-598l-58-58 180-180 180 180-58 58-122-122-122 122Z"/>
    </svg>
</div>
<div id="torneosDropdown" class="absolute left-0 mt-1 w-60 bg-background border border-magenta rounded-md shadow-lg max-h-60 z-60  overflow-y-auto hidden">
    {otrosTorneos.length > 0
    ? otrosTorneos.map(p => (
        <a
            href={`?torneoID=${p.id}`}
            class="flex flex-row items-center w-full h-auto p-2 text-blanco hover:bg-rosa/40 hover:text-blanco duration-200"
        >
            <img src={p.logo} alt={`${p.nombre} favicon`} class="inline-block w-4 h-4 mr-2 align-middle"/>
            <p class="w-46 salto-de-linea">{p.nombre} </p>
            {/* <p class={`text-xs w-20 py-0.5 flex items-center place-content-center capitalize px-2 border rounded-full ${p.rolUsuario === 'propietario' ? 'bg-rol-propietario/30 border-rol-propietario text-rol-propietario' : p.rolUsuario === 'admin' ? 'bg-rol-administracion/30 border-rol-administracion text-rol-administracion' : p.rolUsuario === 'visitante' ? 'bg-rol-visitante/30 border-rol-visitante text-rol-visitante' : 'bg-rol-colaborador/30 text-rol-colaborador border-rol-colaborador'}`}>{p.rolUsuario?.trim()}</p> */}
        </a>
        ))
    : <div class="px-4 py-2 text-gray-500">No hi ha altres tornetjos</div>}
</div>
</div>

<script type="module">
const dropdown = document.getElementById("proyectosDropdown");
const contenido = document.getElementById("torneosDropdown");

dropdown.addEventListener("click", () => {
    contenido.classList.toggle("hidden");
});

// Cerrar al hacer clic fuera
document.addEventListener("click", (e) => {
    if (!dropdown.contains(e.target)) {
    contenido.classList.add("hidden");
    }
});
</script>

<style>
    .salto-de-linea {
        white-space: nowrap;       /* No permite saltos de línea */
        overflow: hidden;          /* Oculta el texto que se desborda */
        text-overflow: ellipsis;   /* Muestra los puntos suspensivos */
    }
    
</style>