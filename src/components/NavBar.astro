            Esports
            <span class="text-[17px] font-semibold text-primary">IES Calvià</span>
        </p>
    </div>

    <nav class="text-neutral flex flex-row gap-8">
        {
            MENU.map((ruta) =>(
                <a href={ruta.enlace} class={`relative flex flex-col items-center text-center ${pathname === ruta.enlace && 'text-secondary'}`}>
                    {ruta.nombre}
                        {
                            ruta.estado === "Pròximament" ? (
                                <span class=" absolute -bottom-4 text-xs text-primary ">{ruta.estado}</span>
                            ):(
