---
import ModoOscuro from "@components/ModoOscuro.astro"

import {MENU} from '@const/Menu'
import { obtenerUsuarioPorToken } from "@pages/api/sesiones/sesiones";

const url = Astro.url;
const pathname = url.pathname

const token = Astro.cookies.get("token_sesion")?.value;
let usuario = null;
if(token){
    usuario = await obtenerUsuarioPorToken(token);
    // console.log("Usuario obtenido:", usuario);
}

