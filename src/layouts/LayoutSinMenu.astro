---
import NavBar from "@components/NavBar.astro";
import Cargando from "@components/Cargando.astro";
import "../global.css";
import Footer from "@components/Footer.astro";

const {title} = Astro.props;
---
<!doctype html>
<html lang="ca">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" /> -->
        <link rel="icon" type="image/png" sizes="any" href="/logo-temporal.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{`${title} `}Esports IES Calvià</title>
	</head>
	<body class="bg-background text-neutral">
    <Cargando />

    <div class="w-full min-h-screen grid grid-rows-[1fr_auto]">
      

      <slot />

      <Footer />
    </div>
    
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script is:inline>
  (() => {
    const savedTheme = localStorage.getItem("theme");

    if (savedTheme) {
      document.documentElement.classList.toggle(
        "oscuro",
        savedTheme === "dark"
      );
      return;
    }

    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)"
    ).matches;

    document.documentElement.classList.toggle(
      "oscuro",
      prefersDark
    );
  })();
</script>
